// What the window shows and does, by area: Rust sets these (`window.global::<…>()`) and takes
// the callbacks; the components read them where they're shown.

import { Activity, CommandItem, ComposerSize, Entry, FocusArea, HanLanguage, ImageChip, LineBreak, MenuItem, PeekStep, PermissionKind, PlanSection, ProjectItem, Program, PromptKind, Question, SendKey, SessionRow, SignInWith, SideExchange, SideView, SignInState, StatSection, TaskItem, TaskKind } from "types.slint";

// The CLI process and the conversation it holds.
export global Session {
    // Who answers in this session ("Claude", "agy"), and the program it runs as.
    in property <string> agent: "Claude";
    in property <string> program: "Claude Code";
    // `!` commands run beside the conversation; agy has no shell for them.
    in property <bool> shell-commands: true;
    // The working directory, its last part, and the session's title.
    in property <string> cwd;
    in property <string> project;
    in property <string> title: "New session";
    // Something runs that Stop stops: a turn, or a `!` command.
    in property <bool> busy;
    // A turn is running: a message written meanwhile waits for it.
    in property <bool> turn;
    // What Claude is doing ("Thinking", "Running Bash"); empty when idle.
    in property <string> status;
    in property <Activity> activity;
    // What runs besides the turn's own steps (subagents, commands), and how much of each
    // ("2 agents, 1 command"); some of it runs on between turns.
    in property <[TaskItem]> tasks;
    in property <string> tasks-summary;
    // Bumped to open the list of what runs: the sidebar's count of agents asks for it, and a
    // stopped turn that left tasks running.
    in-out property <int> tasks-wanted;
    // The user stopped a turn and these run on; the list says so until the next prompt.
    in property <bool> tasks-left-running;
    // Stop the task with this id, or all of them.
    callback stop-task(string);
    callback stop-all-tasks;
    // The context used ("25k / 1M") and how full it is, 0 to 1.
    in property <string> context;
    in property <float> context-fraction;
    // The sidebar's foot: the plan's limits used (0 to 1; less than 0 when unknown) and when
    // they start over (the plan itself is in the usage details). Who is signed in waits behind
    // an info button.
    in property <float> limit-five-hour: -1;
    in property <string> limit-five-hour-resets;
    in property <float> limit-seven-day: -1;
    in property <string> email;
    in property <string> organization;
    in property <string> provider;
    in property <string> version;
    in property <string> cost;
    callback show-usage;
    in property <[MenuItem]> models;
    in-out property <int> model-index;
    in property <[MenuItem]> modes;
    in-out property <int> mode-index;
    in property <PermissionKind> mode;
    callback choose-model(int);
    callback choose-mode(int);
    callback interrupt;
    in property <SignInState> sign-in;
    // How to sign in is shown: the CLI behind a pipe has no `/login`.
    in property <bool> shows-sign-in;
    // Signed in elsewhere: starts Claude Code again, and sends what failed for want of it.
    callback try-sign-in-again;
    callback dismiss-sign-in;
    // The folder isn't trusted yet: Claude Code waits to start in it.
    in property <bool> needs-trust;
    // What the folder's own configuration would run or set there, a line each, plain text.
    in property <[string]> trust-runs;
    callback trust-folder;
    // Starts it this once with the user's own settings alone (see `FolderConfiguration`).
    callback start-without-folder-settings;
    // A session another process runs is shown here, not driven: what runs it, and what
    // can be done about it.
    in property <bool> watching;
    in property <string> watch-text;
    in property <bool> can-go-to-window;
    callback continue-here;
    callback go-to-window;
    // Stops the watched session in its window and continues it here.
    callback bring-here;
    // The git worktree the session works in (empty if none), and what it can be opened in:
    // the first entry is this window.
    in property <string> worktree-name;
    in property <string> worktree-branch;
    in property <[string]> openers;
    callback open-worktree(int);
    // A web page, in the browser.
    callback open-url(string);
    // The text bigger (1), smaller (-1), or back to the desktop's size (0).
    callback zoom(int);
    // The other look: Gruvbox or plain.
    callback switch-look;
    // Code's colours changed (the look, or the desktop's dark or light): code is coloured again.
    callback syntax-colours-changed;
}

// The composer: the draft, and slash commands matching it.
export global Composer {
    in-out property <string> draft;
    in property <[CommandItem]> commands;
    // The command the arrow keys are on; Enter runs it, → and Tab put it in the draft. Back to
    // the first at each edit.
    in-out property <int> command-index;
    // What the command in the draft takes (`[instructions]`), hinted after it until something
    // follows or Esc dismisses it; empty for none.
    in property <string> argument-hint;
    callback send(string);
    callback draft-edited(string);
    // Puts the command at `index` in the draft.
    callback pick-command(int);
    // Sends the command at `index` as it is.
    callback run-command(int);
    // Bumped to focus the composer (a new session, a session opened).
    in property <int> focus-serial;
    in-out property <ComposerSize> size: ComposerSize.fit;
    // The height dragged to, kept between runs.
    in-out property <length> chosen-height;
    // A height dragged to, in logical pixels, to keep; zero goes back to fitting the text.
    callback height-chosen(int);
    // Images pasted, to go with the next message.
    in property <[ImageChip]> images;
    // Ctrl+V: the clipboard's image, if it holds one (text is pasted as ever).
    callback paste-image;
    callback remove-image(int);
    // The session's earlier prompts, as Up (on the first line) and Down (on the last) step
    // through them: whether there is an older one, and whether one is in the draft now.
    in property <bool> can-recall-older;
    in property <bool> recalling;
    callback recall-older;
    callback recall-newer;
    // The draft is a shell command (`!`, or the full-width `！`): it runs instead of being sent.
    in property <bool> shell;
    // Puts `!` in front of the draft, or takes it away.
    callback toggle-shell;
    // Ctrl+Enter, which the text box itself ignores: the draft with a line break in place of
    // what lies between two byte offsets (the selection, or none at the caret), and where the
    // caret goes after it.
    pure callback break-line(string, int, int) -> LineBreak;
}

// The sidebar: the sessions running now and this directory's earlier ones, and the
// directories to switch to.
export global Sessions {
    in property <[SessionRow]> rows;
    // Said where the list is empty: none yet, or none matching the filter.
    in property <string> empty;
    in property <[ProjectItem]> projects;
    // The sidebar's width as dragged, kept between runs; zero for the default.
    in-out property <length> chosen-width;
    // Dragged to a width, in logical pixels; zero gives the default back.
    callback width-chosen(int);
    // What the list is narrowed to.
    callback filter-edited(string);
    // The current session's program: Ctrl+N starts a new session with it.
    in property <Program> program;
    // The New session menu offers Claude Code with the API key while the keyring keeps one.
    in property <bool> api-key-kept;
    callback new-session(Program);
    callback open(string);
    // A Claude Code session to continue, by its title, waits for the user to pick what it
    // signs in with; empty while none does.
    in property <string> choosing-sign-in;
    callback continue-with(SignInWith);
    callback cancel-continue;
    // Turns to the folder a path names; answers why it can't, or nothing when it does.
    callback open-project(string) -> string;
    callback browse-project;
    callback refresh-projects;
}

// The conversation.
export global Transcript {
    // The rows shown, in order; those hidden are left out.
    in property <[Entry]> entries;
    // Bumped to go to the end, whether or not it was being followed.
    in property <int> scroll-to-end-serial;
    // Bumped when a session's transcript is shown: it goes to the end, hidden until it settles.
    in property <int> opened-serial;
    // The newest of the user's messages, pinned above the conversation while it is out of
    // view: its place in the conversation (-1 before the first), its place in the list of
    // rows shown, and its text on one line.
    in property <int> pinned-index: -1;
    in property <int> pinned-row;
    in property <string> pinned-text;
    callback toggle(int);
    // Opens or folds the run of tool calls whose first call is at this place.
    callback toggle-group(int);
    // Copies the entry's whole text (an assistant message's Markdown, a tool's whole output).
    callback copy-entry(int);
}

// The bar above the composer, while Claude waits for an answer.
export global Prompt {
    in property <PromptKind> kind;
    in property <string> title;
    in property <string> summary;
    // The summary is words (a message to another session, an agent's task), not code: set as
    // prose, as on the tool's card.
    in property <bool> summary-prose;
    in property <string> detail;
    // E.g. "Always allow Bash(npm test)"; empty if the CLI suggests nothing to remember.
    in property <string> always-label;
    // More requests waiting behind this one.
    in property <int> queued;
    // Bumped for every request shown, so the bar's buttons arm again.
    in property <int> serial;
    // The request shown. Every answer names it: one meant for a request that went away is
    // not given to the next.
    in property <string> request;
    in property <[Question]> questions;
    callback allow(string);
    callback allow-always(string);
    // With what to do instead, or empty.
    callback deny(string, string);
    callback toggle-option(int, int);
    callback set-other(int, string);
    // Notes that go with a question's answer.
    callback set-notes(int, string);
    callback answer(string);
    // Claude's plan, part by part, with the user's comments; shown over the transcript
    // while `reviewing`.
    in property <[PlanSection]> plan;
    in-out property <bool> reviewing;
    in property <int> comment-count;
    callback edit-comment(int);
    callback set-comment(int, string);
    callback cancel-comment;
    // Approves the plan (auto-accepting edits, or asking before each), with a comment on the
    // whole of it.
    callback approve-plan(string, bool, string);
}

// A task followed in the side panel, read only: the chip's list of what runs opens it. A
// subagent's conversation, or what a background command prints.
export global Peek {
    in property <bool> open;
    in property <TaskKind> kind;
    // What it was started for, and its kind ("Agent · Explore").
    in property <string> title;
    in property <string> detail;
    // It still runs; else it ended, and what is shown is all it did.
    in property <bool> running;
    in property <[PeekStep]> steps;
    // A command's: the lines it printed, as far as Claude Code tells (the end of them), and
    // what is said of that (only the end of it; why there is none).
    in property <[string]> output;
    in property <string> note;
    // Follow the task with this id.
    callback follow(string);
    callback close;
}

// Side questions (`/btw`): answered with the conversation's context, never part of it.
export global Side {
    in property <SideView> view;
    in property <[SideExchange]> exchanges;
    // An answer came while folded away.
    in property <bool> unseen;
    // A session runs here to ask (not one watched from elsewhere).
    in property <bool> can-ask;
    in property <bool> can-branch;
    in property <bool> has-answers;
    in property <bool> pending;
    // Bumped to focus the panel's input.
    // Asked to take the focus: a panel just made takes it once (see `SidePanel`).
    in-out property <bool> focus-wanted;
    in property <int> focus-serial;
    callback ask(string);
    callback toggle;
    callback dismiss;
    callback copy(int);
    callback to-conversation;
    callback branch;
}

// The settings page, over the conversation as the usage details are (Ctrl+,).
export global Preferences {
    in-out property <bool> open;
    in property <SendKey> send-key;
    callback choose-send-key(SendKey);
    // The language text with Han characters alone is drawn in, as in use (the one chosen, or
    // the desktop's, or Japanese).
    in property <HanLanguage> han-language;
    callback choose-han-language(HanLanguage);
    // The sessions edualc's daemon runs, in every window; a shutdown ends them all.
    in property <int> running-sessions;
    callback shut-down;
    // Whether the desktop's keyring keeps an Anthropic API key for Claude Code sessions, and
    // what the keyring last said when it was stored, removed or looked for.
    in property <bool> api-key-kept;
    in property <string> api-key-note;
    callback store-api-key(string);
    callback remove-api-key;
}

// Where the keyboard is. Tab and Shift+Tab go round within an area (see `AreaFence`); F6 and
// Shift+F6 go from one to the next.
export global Focus {
    // The area the focus was last seen in.
    in-out property <FocusArea> area: FocusArea.writing;
    // A fence is sending the focus round: the next fence Tab reaches leaves it there, as an
    // area with nothing to focus would send it round for ever.
    in-out property <bool> going-round;
    // Moves the focus on as Tab (true) or Shift+Tab would, once the event at hand is done;
    // clears `going-round` then.
    callback step(bool);
    // F6, Shift+F6 and Ctrl+K: the area to go to, and a count bumped each time. The area's
    // home takes the focus (the sidebar's filter, the transcript, what Claude asks or else the
    // composer, the side panel's question), and clears `pending`; a home made just then (the
    // sidebar shown by Ctrl+K) takes it as it is made.
    in-out property <FocusArea> wanted;
    in-out property <int> wanted-serial;
    in-out property <bool> pending;
}

// The usage panel: the CLI's `/usage` and `/context`, shown over the conversation.
export global Usage {
    in property <bool> open;
    // Answers still owed.
    in property <bool> loading;
    // Why something is missing, if it is.
    in property <string> note;
    in property <[StatSection]> sections;
    callback close;
    callback refresh;
}

// Copies through a text input, the way Slint reaches the clipboard (`AppWindow.copy-text`).
export global Clipboard {
    callback copy(string);
}

// The text selected in the transcript, for copying with Ctrl+C: one element's at a time, the
// one whose key is `owner` ("" for none); the others drop theirs when it changes. The text
// stays in the `StyledText`, which reaches the clipboard itself.
export global TextSelection {
    in-out property <string> owner;
    // Bumped to ask the element at `owner` to copy its selection.
    in-out property <int> copy-request;
    public function clear() {
        self.owner = "";
    }
    public function copy() {
        self.copy-request += 1;
    }
}
