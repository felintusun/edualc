// The shared pieces the window is built from. Each takes its look from `Theme` and `Motion`.

import { ScrollView } from "std-widgets.slint";
import { Motion, Theme } from "theme.slint";
import { CjkChars, FocusArea, MenuItem } from "types.slint";
import { Focus, Session, TextSelection } from "state.slint";

// A Lucide icon (`@image-url("@lucide/<name>.svg")`, see `build.rs`).
// Only drawn, as the control it is in names what it does. An Image held, not inherited: Slint
// 1.19 hides an Image from assistive technology only for `accessible-role: none` on the
// element itself; set on a component's root, it exposes each use as an unnamed node of unknown
// role, and an Image without it is an unnamed image.
export component Icon inherits Rectangle {
    in property <image> source;
    in property <color> tint: Theme.text-secondary;
    width: Theme.icon;
    height: self.width;
    Image {
        width: 100%;
        height: 100%;
        source: root.source;
        image-fit: contain;
        colorize: root.tint;
        accessible-role: none;
    }
}

export component Title inherits Text {
    font-size: 1rem * Theme.title;
    font-weight: 600;
    color: Theme.text;
}

export component Small inherits Text {
    font-size: 1rem * Theme.small;
    color: Theme.text-tertiary;
}

export component Caption inherits Text {
    font-size: 1rem * Theme.caption;
    color: Theme.text-tertiary;
}

// Something to click that isn't a button: a row, a header. Lit while hovered or pressed,
// tinted while selected (with a bar of the accent, so selection isn't told by tint alone).
// Makes the control it is in reachable with Tab: Enter or Space presses it, and a ring in the
// accent shows the focus. A click doesn't take the focus, so writing goes on where it was.
export component KeyPress inherits FocusScope {
    in property <length> ring-radius: Theme.radius-s;
    callback pressed;
    focus-on-click: false;
    key-pressed(event) => {
        if event.text == Key.Return || event.text == " " {
            root.pressed();
            return accept;
        }
        return reject;
    }
    // A gap between the ring and the control, so it shows around one in the accent too.
    if root.has-focus: Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-radius: root.ring-radius + 4px;
        border-width: 2px;
        border-color: Theme.accent;
    }
}

// An area's edge in the Tab order: Tab that reaches it goes round to the area's other end
// (`crossed`; see `Focus`), so Tab and Shift+Tab stay within the area.
export component AreaFence inherits FocusScope {
    in property <FocusArea> area;
    callback crossed;
    // No height, and the width it is given: a fixed width would bound a layout's across it.
    height: 0px;
    focus-on-click: false;
    focus-gained(reason) => {
        if reason == FocusReason.tab-navigation {
            Focus.area = root.area;
            root.crossed();
        }
    }
}

export component Pressable inherits Rectangle {
    in property <bool> selected;
    // Where the arrow keys are in a list, shown as the pointer's hover is.
    in property <bool> highlighted;
    in property <bool> enabled: true;
    // Reached with Tab; rows that the arrow keys go through (a menu's, say) are not.
    in property <bool> tab-stop: true;
    out property <bool> hovered: touch.has-hover;
    callback clicked;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    border-radius: Theme.radius-s;
    background: root.selected ? Theme.selected
        : touch.pressed ? Theme.pressed
        : (touch.has-hover || root.highlighted) && root.enabled ? Theme.hover : transparent;
    animate background { duration: Motion.fast; easing: ease-out; }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
    if root.selected: Rectangle {
        x: 0;
        width: 3px;
        height: parent.height - 2 * Theme.space-s;
        border-radius: 1.5px;
        background: Theme.accent;
    }
    @children
    KeyPress {
        enabled: root.enabled && root.tab-stop;
        ring-radius: root.border-radius;
        pressed => { root.clicked(); }
    }
}

// A button that is only an icon, its label as the tooltip.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <length> icon-size: Theme.icon;
    in property <color> tint: Theme.text-secondary;
    callback clicked;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    width: Theme.button;
    height: Theme.button;
    border-radius: Theme.radius-s;
    opacity: root.enabled ? 1 : 0.4;
    background: touch.pressed ? Theme.pressed : touch.has-hover && root.enabled ? Theme.hover : transparent;
    animate background { duration: Motion.fast; easing: ease-out; }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        if self.has-hover && root.label != "": Tooltip {
            text: @markdown("\{root.label}");
        }
    }
    Icon {
        source: root.icon;
        tint: root.tint;
        width: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    KeyPress {
        enabled: root.enabled;
        ring-radius: root.border-radius;
        pressed => { root.clicked(); }
    }
}

// A button with a label (and maybe an icon); `primary` for what is expected.
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> enabled: true;
    // What assistive technology calls it, where its text alone would be the same as another
    // button's nearby.
    in property <string> label: root.text;
    // Its text may be cut short (…) where the row has no room for all of it, said in full on
    // hover; others keep theirs whole.
    in property <bool> may-shorten;
    callback clicked;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    // Assistive tools press it as a click would: not before it is enabled (armed).
    accessible-action-default => { if root.enabled { root.clicked(); } }
    property <color> ink: root.primary ? Theme.on-accent : root.danger ? Theme.danger-text : Theme.text;
    height: 30px;
    border-radius: Theme.radius-s;
    opacity: root.enabled ? 1 : 0.5;
    background: root.primary
        ? (touch.pressed ? Theme.accent.darker(0.2) : touch.has-hover ? Theme.accent.brighter(0.1) : Theme.accent)
        : (touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : Theme.subtle);
    border-width: root.primary ? 0 : 1px;
    border-color: Theme.divider;
    animate background { duration: Motion.fast; easing: ease-out; }
    HorizontalLayout {
        padding-left: Theme.space-m;
        padding-right: Theme.space-m;
        spacing: Theme.space-xs;
        alignment: center;
        if root.has-icon: Icon {
            source: root.icon;
            tint: root.ink;
            width: Theme.icon-small;
            y: (parent.height - self.height) / 2;
        }
        shown := Text {
            text: root.text;
            color: root.ink;
            vertical-alignment: center;
            font-weight: root.primary ? 600 : 400;
            overflow: elide;
            min-width: root.may-shorten ? 0px : self.preferred-width;
            // The button says it.
            accessible-role: none;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        if self.has-hover && shown.width < shown.preferred-width: Tooltip {
            text: @markdown("\{root.text}");
        }
    }
    keys := KeyPress {
        enabled: root.enabled;
        ring-radius: root.border-radius;
        pressed => { root.clicked(); }
    }
    // Focused when asked (`focus()`), as when a question shows.
    forward-focus: keys;
}

// Text that can be selected and copied, in the transcript: one element's selection at a time
// (`TextSelection`), each told apart by its `key`. Links open in the browser. No narrower than
// its longest word.
component SelectableText inherits StyledText {
    in property <string> key;
    // Its text's CJK characters, which set its family and language (see `Theme`).
    in property <CjkChars> cjk;
    default-font-family: Theme.cjk-family(self.cjk);
    language: Theme.language-tag(self.cjk);
    selectable: true;
    default-color: Theme.text;
    link-color: Theme.link;
    selection-background-color: Theme.selection;
    selection-foreground-color: Theme.selection-text;
    accessible-role: text;
    link-clicked(link) => { Session.open-url(link); }
    property <string> owner: TextSelection.owner;
    changed owner => {
        if self.owner != root.key {
            self.clear-selection();
        }
    }
    changed has-selection => {
        if self.has-selection {
            TextSelection.owner = root.key;
        } else if TextSelection.owner == root.key {
            TextSelection.clear();
        }
    }
    property <int> copy-request: TextSelection.copy-request;
    changed copy-request => {
        if TextSelection.owner == root.key && self.has-selection {
            self.copy();
        }
    }
}

export component Selectable inherits SelectableText {
    // A long unbreakable word (a URL, a path) must not widen the row past the column.
    min-width: 0px;
}

// A table's cell keeps its longest word whole, so a short column keeps its width as the table
// narrows; a table its words make too wide scrolls sideways.
export component TableCell inherits SelectableText { }

// Monospace text on the code background: code, a tool's input or output.
export component CodeBox inherits Rectangle {
    in property <styled-text> body;
    in property <string> key;
    in property <color> ink: Theme.text;
    // Above the text, e.g. the code's language; nothing shown if empty.
    in property <string> label;
    // Below the text, e.g. what was left out.
    in property <string> note;
    // Offers a copy button, which calls `copy`.
    in property <bool> copyable;
    // Keeps code's lines whole: one wider than the box scrolls sideways, as a wide table does
    // (a Markdown code block). Otherwise the text wraps (a tool's input or output).
    in property <bool> keeps-lines;
    // The text's size against the interface's code, as a message scales it (`Theme.message`).
    in property <float> scale: 1;
    callback copy;
    // Fluent's horizontal scroll bar lies over the bottom of what it scrolls.
    property <length> scroll-bar: 14px;
    property <length> copy-size: 24px;
    background: Theme.code;
    border-radius: Theme.radius-m;
    VerticalLayout {
        padding: Theme.space-m;
        padding-top: root.label != "" ? Theme.space-xs : Theme.space-m;
        // Without a label, the copy button stands in the top right corner, beside the text.
        padding-right: root.label == "" && root.copyable ? Theme.space-m + root.copy-size : Theme.space-m;
        spacing: Theme.space-xs;
        if root.label != "": HorizontalLayout {
            Caption {
                text: root.label;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.copyable: IconButton {
                icon: @image-url("@lucide/copy.svg");
                label: "Copy";
                width: root.copy-size;
                height: root.copy-size;
                icon-size: Theme.icon-small;
                clicked => { root.copy(); }
            }
        }
        if !root.keeps-lines: Selectable {
            text: root.body;
            key: root.key;
            default-color: root.ink;
            default-font-family: Theme.mono;
            default-font-size: 1rem * Theme.code-size * root.scale;
            line-height-factor: Theme.code-line-factor;
        }
        if root.keeps-lines: lines := ScrollView {
            property <bool> overflowing: code.preferred-width > self.visible-width;
            // As wide as its longest line, for the box to grow to where there is room.
            preferred-width: code.preferred-width;
            height: code.preferred-height + (self.overflowing ? root.scroll-bar : 0px);
            vertical-scrollbar-policy: always-off;
            content-width: max(self.visible-width, code.preferred-width);
            content-height: code.preferred-height;
            code := Selectable {
                width: lines.content-width;
                text: root.body;
                key: root.key;
                default-color: root.ink;
                default-font-family: Theme.mono;
                default-font-size: 1rem * Theme.code-size * root.scale;
                line-height-factor: Theme.code-line-factor;
            }
        }
        if root.note != "": Caption {
            text: root.note;
        }
    }
    if root.label == "" && root.copyable: IconButton {
        x: parent.width - self.width - Theme.space-s;
        y: Theme.space-s;
        icon: @image-url("@lucide/copy.svg");
        label: "Copy";
        width: root.copy-size;
        height: root.copy-size;
        icon-size: Theme.icon-small;
        clicked => { root.copy(); }
    }
}

// A line of text to type, in the theme's look: a placeholder while empty, the accent around it
// while focused. Enter calls `accepted`. The text scrolls sideways to keep the caret in view.
export component Field inherits Rectangle {
    in property <string> placeholder;
    in property <bool> enabled: true;
    // Shown as dots, and not copied out: a key, a password.
    in property <bool> secret;
    in-out property <string> text <=> input.text;
    out property <bool> has-focus: input.has-focus;
    callback accepted(string);
    callback edited(string);
    forward-focus: input;
    // How far the text is scrolled to the left.
    property <length> scrolled: 0;
    property <length> margin: Theme.space-s;
    min-width: 80px;
    height: Theme.control;
    border-radius: Theme.radius-m;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.control-border;
    animate border-color { duration: Motion.fast; easing: ease-out; }
    background: Theme.field;
    opacity: root.enabled ? 1 : 0.55;
    clip: true;
    // Gone too while an input method composes, as what it composes isn't in `text` yet. Only
    // drawn: the entry itself tells assistive technology.
    if input.text == "" && input.preedit-text == "": Text {
        x: root.margin;
        width: parent.width - 2 * root.margin;
        height: parent.height;
        text: root.placeholder;
        color: Theme.text-faint;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    input := TextInput {
        x: root.margin + root.scrolled;
        width: max(parent.width - 2 * root.margin, self.preferred-width + self.text-cursor-width);
        height: parent.height;
        vertical-alignment: center;
        single-line: true;
        input-type: root.secret ? InputType.password : InputType.text;
        enabled: root.enabled;
        color: Theme.text;
        selection-background-color: Theme.selection;
        selection-foreground-color: Theme.selection-text;
        accessible-label: root.placeholder;
        accessible-placeholder-text: root.placeholder;
        accepted => { root.accepted(self.text); }
        edited => { root.edited(self.text); }
        cursor-position-changed(at) => {
            if at.x + root.scrolled < 0 {
                root.scrolled = -at.x;
            } else if at.x + root.scrolled > root.width - 2 * root.margin - self.text-cursor-width {
                root.scrolled = root.width - 2 * root.margin - self.text-cursor-width - at.x;
            }
        }
    }
}

// A compact choice in a toolbar: an icon and the current choice's name, no frame until
// hovered. Its menu opens upwards and says what each choice means.
export component MenuButton inherits Rectangle {
    in property <[MenuItem]> model;
    in-out property <int> current-index;
    in property <image> icon;
    in property <color> tint: Theme.text-secondary;
    // Above the choices in the menu, e.g. "Permission mode".
    in property <string> heading;
    // Only its icon, the choice told on hover: where a narrow window would cut its name.
    in property <bool> compact;
    callback selected(int);
    property <string> current: root.current-index >= 0 && root.current-index < root.model.length
        ? root.model[root.current-index].title : "";
    // The choice the arrow keys are on while the menu is open.
    property <int> highlighted;
    accessible-role: combobox;
    accessible-label: root.heading;
    accessible-value: root.current;
    accessible-expandable: true;
    accessible-action-default => { root.open(); }
    accessible-action-expand => { root.open(); }
    height: Theme.chip;
    // Its name gives way to the room left; its icons don't.
    min-width: root.compact ? content.preferred-width : 0px;
    border-radius: Theme.radius-m;
    background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Motion.fast; easing: ease-out; }
    content := HorizontalLayout {
        padding-left: Theme.space-s;
        padding-right: Theme.space-xs;
        spacing: Theme.space-xs;
        Icon {
            source: root.icon;
            tint: root.tint;
            width: Theme.icon-small;
            y: (parent.height - self.height) / 2;
        }
        if !root.compact: Text {
            text: root.current;
            color: root.tint;
            font-size: 1rem * Theme.small;
            vertical-alignment: center;
            overflow: elide;
            min-width: 0px;
            accessible-role: none;
        }
        Icon {
            source: @image-url("@lucide/chevron-up.svg");
            tint: Theme.text-faint;
            width: Theme.icon-small;
            y: (parent.height - self.height) / 2;
        }
    }
    function open() {
        root.highlighted = max(0, root.current-index);
        menu.show();
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
        if self.has-hover && root.compact: Tooltip {
            text: @markdown("\{root.heading}: \{root.current}");
        }
    }
    KeyPress {
        ring-radius: root.border-radius;
        pressed => { root.open(); }
    }
    menu := PopupWindow {
        x: 0;
        y: -self.height - Theme.space-xs;
        width: max(root.width, 320px);
        height: items.preferred-height;
        // Up and Down move through the choices, Enter or Space takes one; Esc closes the menu.
        menu-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.UpArrow {
                    root.highlighted = max(0, root.highlighted - 1);
                    return accept;
                }
                if event.text == Key.DownArrow {
                    root.highlighted = min(root.model.length - 1, root.highlighted + 1);
                    return accept;
                }
                if event.text == Key.Return || event.text == " " {
                    root.current-index = root.highlighted;
                    root.selected(root.highlighted);
                    menu.close();
                    return accept;
                }
                return reject;
            }
        }
        Rectangle {
            background: Theme.surface-raised;
            border-radius: Theme.radius-m;
            border-width: 1px;
            border-color: Theme.control-border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #0006;
            items := VerticalLayout {
                padding: Theme.space-xs;
                spacing: 2px;
                if root.heading != "": Caption {
                    text: root.heading;
                    horizontal-alignment: left;
                }
                for item[index] in root.model: Pressable {
                    selected: index == root.current-index;
                    highlighted: index == root.highlighted;
                    tab-stop: false;
                    clicked => {
                        root.current-index = index;
                        root.selected(index);
                    }
                    HorizontalLayout {
                        padding: Theme.space-s;
                        padding-left: Theme.space-m;
                        spacing: Theme.space-s;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: item.title;
                                color: Theme.text;
                            }
                            if item.description != "": Text {
                                text: item.description;
                                color: Theme.text-tertiary;
                                font-size: 1rem * Theme.small;
                                wrap: word-wrap;
                            }
                        }
                        Icon {
                            source: @image-url("@lucide/check.svg");
                            tint: Theme.accent;
                            width: Theme.icon-small;
                            opacity: index == root.current-index ? 1 : 0;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }
        }
    }
}

// A thin bar for a share (0 to 1), warming as it fills.
export component Meter inherits Rectangle {
    in property <float> fraction;
    height: 4px;
    border-radius: 2px;
    background: Theme.divider;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.fraction, 0, 1);
        height: parent.height;
        border-radius: 2px;
        background: Theme.fill(root.fraction);
    }
}

// How much of a limit is used: a label, its bar, and the share.
export component UsageBar inherits HorizontalLayout {
    in property <string> label;
    // 0 to 1.
    in property <float> used;
    height: 1.5rem;
    spacing: Theme.space-s;
    Caption {
        text: root.label;
        width: 2.2rem;
        vertical-alignment: center;
    }
    Meter {
        horizontal-stretch: 1;
        y: (parent.height - self.height) / 2;
        fraction: root.used;
    }
    Caption {
        text: "\{round(clamp(root.used, 0, 1) * 100)}%";
        width: 2.4rem;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}
