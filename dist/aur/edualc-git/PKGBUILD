# Maintainer: Felin Tusun <16455996+felintusun@users.noreply.github.com>
# Written from dist/package.ncl by dist/formats.ncl: change those, not this.

pkgname=edualc-git
_name=edualc
pkgver=0.1.0
pkgrel=1
pkgdesc='Native desktop window for Claude Code (main branch)'
arch=(x86_64 aarch64)
url='https://github.com/felintusun/edualc'
license=('GPL-3.0-or-later')
# Cargo strips the binary (strip = true), which leaves a debug package nothing to hold.
options=('!debug')
depends=(glibc libgcc fontconfig wayland libxkbcommon libglvnd hicolor-icon-theme)
makedepends=(cargo dioxus-cli git)
optdepends=(
  'wl-clipboard: pasting images'
  'claude-code: the Claude Code CLI that edualc runs (or Anthropic'\''s installer: claude on the PATH)'
  'ttf-fira-sans: the interface font (otherwise the desktop'\''s sans)'
  'ttf-fira-code: the code font (otherwise the desktop'\''s monospace)'
  'noto-fonts-cjk: Japanese, Chinese and Korean text'
)
provides=("$_name")
conflicts=("$_name")
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_name"
  local version
  version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n 1)
  printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
  # edualcd with its page: the server, and the public/ folder it serves
  dx bundle --frozen -p edualc-server --platform web --fullstack --profile web
  cp target/dx/edualcd/release/web/server target/release/edualcd
  rm -rf target/release/public
  cp -r target/dx/edualcd/release/web/public target/release/public
}

check() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
  cargo test --frozen -p edualc-server --features server
}

package() {
  cd "$_name"
  install -Dm0755 target/release/edualc "$pkgdir"/usr/bin/edualc
  install -Dm0755 target/release/edualcd "$pkgdir"/usr/bin/edualcd
  install -Dm0644 assets/edualcd.service "$pkgdir"/usr/lib/systemd/user/edualcd.service
  mkdir -p "$pkgdir"/usr/share/edualc/public && cp -r target/release/public/. "$pkgdir"/usr/share/edualc/public/ && find "$pkgdir"/usr/share/edualc/public -type d -exec chmod 0755 {} + && find "$pkgdir"/usr/share/edualc/public -type f -exec chmod 0644 {} +
  install -Dm0644 assets/io.github.felintusun.edualc.desktop "$pkgdir"/usr/share/applications/io.github.felintusun.edualc.desktop
  install -Dm0644 assets/io.github.felintusun.edualc.svg "$pkgdir"/usr/share/icons/hicolor/scalable/apps/io.github.felintusun.edualc.svg
  install -Dm0644 assets/io.github.felintusun.edualc.metainfo.xml "$pkgdir"/usr/share/metainfo/io.github.felintusun.edualc.metainfo.xml
  install -Dm0644 assets/edualc.1 "$pkgdir"/usr/share/man/man1/edualc.1
  install -Dm0644 README.md "$pkgdir"/usr/share/doc/edualc/README.md
  install -Dm0644 THIRD_PARTY_LICENSES.md "$pkgdir"/usr/share/licenses/edualc/THIRD_PARTY_LICENSES.md
}
