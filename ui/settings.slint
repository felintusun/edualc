// edualc's settings, over the conversation as the usage details are; Esc or the cross closes
// them. Each takes effect at once and is kept in `config.toml`, but the API key, which the
// keyring keeps.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { FocusArea, HanLanguage, PeerMessages, SendKey, SignInState } from "types.slint";
import { Focus, Preferences, Session } from "state.slint";
import { AreaFence, Caption, Field, Icon, IconButton, Pressable, Small, TextButton, Title } from "widgets.slint";

// One of a setting's choices: its name, what it means, and whether it is the one in use.
export component Choice inherits Pressable {
    in property <string> title;
    in property <string> detail;
    in property <bool> chosen;
    selected: root.chosen;
    accessible-role: radio-button;
    accessible-checkable: true;
    accessible-checked: root.chosen;
    accessible-label: root.title;
    accessible-description: root.detail;
    HorizontalLayout {
        padding: Theme.space-s;
        padding-left: Theme.space-m;
        spacing: Theme.space-s;
        // Centred on the title's line.
        Icon {
            source: root.chosen ? @image-url("@lucide/circle-check.svg") : @image-url("@lucide/circle.svg");
            tint: root.chosen ? Theme.accent : Theme.text-tertiary;
            width: Theme.icon-small;
            y: Theme.space-s + (title.preferred-height - self.height) / 2;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            title := Text {
                text: root.title;
                color: Theme.text;
                wrap: word-wrap;
                min-width: 0px;
                accessible-role: none;
            }
            Small {
                text: root.detail;
                wrap: word-wrap;
                min-width: 0px;
            }
        }
    }
}

// A group's heading in the settings.
component Heading inherits Text {
    font-weight: 600;
    color: Theme.text;
}

// What a group is for, under its heading.
component Explanation inherits Small {
    wrap: word-wrap;
    min-width: 0px;
}

// The settings' groups, one shown at a time.
enum SettingsTab { input, sessions, account, daemon }

export component SettingsPanel inherits Rectangle {
    callback close;
    // Shut down was pressed once: the second press, on the button that says what ends, does it.
    property <bool> confirming-shutdown;
    property <SettingsTab> shown-tab: SettingsTab.input;
    property <[{tab: SettingsTab, label: string}]> tabs: [
        { tab: SettingsTab.input, label: "Input" },
        { tab: SettingsTab.sessions, label: "Sessions" },
        { tab: SettingsTab.account, label: "Account" },
        { tab: SettingsTab.daemon, label: "Daemon" },
    ];
    property <bool> knows-account: Session.email != "" || Session.organization != "" || Session.provider != "" || Session.version != "" || Session.cost != "";
    preferred-height: panel-layout.preferred-height;
    background: Theme.surface;
    // The focus comes in as it opens, and Tab goes round within it: what is typed must not go
    // to the composer it covers.
    init => {
        first-fence.focus();
        Focus.step(true);
    }
    first-fence := AreaFence {
        area: FocusArea.conversation;
        crossed => {
            if !Focus.going-round {
                Focus.going-round = true;
                last-fence.focus();
                Focus.step(false);
            }
        }
    }
    panel-layout := VerticalLayout {
        HorizontalLayout {
            min-height: Theme.header;
            padding-left: root.width < 34rem ? Theme.space-l : Theme.space-xl;
            padding-right: Theme.space-m;
            padding-top: Theme.space-s;
            padding-bottom: Theme.space-s;
            spacing: Theme.space-m;
            Icon {
                source: @image-url("@lucide/settings.svg");
                tint: Theme.claude;
                width: 22px;
                y: (parent.height - self.height) / 2;
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                min-width: 0px;
                Title {
                    text: "Settings";
                    min-width: 0px;
                    overflow: elide;
                }
                Caption {
                    text: "Kept in edualc's config.toml; each takes effect at once";
                    min-width: 0px;
                    wrap: word-wrap;
                }
            }
            IconButton {
                icon: @image-url("@lucide/x.svg");
                label: "Close settings (Esc)";
                y: (parent.height - self.height) / 2;
                clicked => { root.close(); }
            }
        }
        HorizontalLayout {
            padding-left: root.width < 34rem ? Theme.space-l : Theme.space-xl;
            padding-right: Theme.space-m;
            padding-bottom: Theme.space-s;
            spacing: Theme.space-xs;
            alignment: start;
            accessible-role: tab-list;
            for entry[index] in root.tabs: Pressable {
                height: Theme.chip;
                selected: entry.tab == root.shown-tab;
                border-width: 1px;
                border-color: entry.tab == root.shown-tab ? Theme.accent.with-alpha(0.5) : Theme.divider;
                accessible-role: tab;
                accessible-label: entry.label;
                accessible-item-selectable: true;
                accessible-item-selected: entry.tab == root.shown-tab;
                accessible-item-index: index;
                accessible-item-count: root.tabs.length;
                clicked => { root.shown-tab = entry.tab; }
                HorizontalLayout {
                    padding-left: Theme.space-m;
                    padding-right: Theme.space-m;
                    Text {
                        text: entry.label;
                        font-size: 1rem * Theme.small;
                        font-weight: entry.tab == root.shown-tab ? 600 : 400;
                        color: entry.tab == root.shown-tab ? Theme.text : Theme.text-secondary;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        scroll := ScrollView {
            vertical-stretch: 1;
            min-height: 0px;
            preferred-height: page.preferred-height;
            horizontal-scrollbar-policy: always-off;
            content-width: self.visible-width;
            content-height: page.preferred-height;
            page := VerticalLayout {
                // At least `space-l` on each side so Fluent's overlay scrollbar never covers controls.
                property <length> gutter: root.width < 34rem ? Theme.space-l : Theme.space-xl;
                x: max(self.gutter, (scroll.visible-width - self.width) / 2);
                width: min(max(0px, scroll.visible-width - 2 * self.gutter), 640px);
                padding-top: Theme.space-l;
                padding-bottom: Theme.space-xl;
                alignment: start;
                if root.shown-tab == SettingsTab.input: VerticalLayout {
                    spacing: Theme.space-xs;
                    Heading {
                        text: "Sending";
                    }
                    Choice {
                        title: "Enter sends";
                        detail: "Shift+Enter or Ctrl+Enter start a new line.";
                        chosen: Preferences.send-key == SendKey.enter;
                        clicked => { Preferences.choose-send-key(SendKey.enter); }
                    }
                    Choice {
                        title: "Ctrl+Enter sends";
                        detail: "Enter starts a new line, so a stray Enter never sends half a message.";
                        chosen: Preferences.send-key == SendKey.ctrl-enter;
                        clicked => { Preferences.choose-send-key(SendKey.ctrl-enter); }
                    }
                    Rectangle {
                        height: Theme.space-m;
                    }
                    // Kana and Hangul tell a text's language themselves; Han characters alone don't.
                    Heading {
                        text: "Text in Han characters alone";
                    }
                    Explanation {
                        text: "Chinese, Japanese and Korean draw many Han characters differently. A message with kana is set as Japanese and one with Hangul as Korean; one in Han characters alone as chosen here.";
                    }
                    Choice {
                        title: "Japanese";
                        detail: "Noto Sans CJK JP";
                        chosen: Preferences.han-language == HanLanguage.japanese;
                        clicked => { Preferences.choose-han-language(HanLanguage.japanese); }
                    }
                    Choice {
                        title: "Simplified Chinese";
                        detail: "Noto Sans CJK SC";
                        chosen: Preferences.han-language == HanLanguage.simplified-chinese;
                        clicked => { Preferences.choose-han-language(HanLanguage.simplified-chinese); }
                    }
                    Choice {
                        title: "Traditional Chinese";
                        detail: "Noto Sans CJK TC";
                        chosen: Preferences.han-language == HanLanguage.traditional-chinese;
                        clicked => { Preferences.choose-han-language(HanLanguage.traditional-chinese); }
                    }
                    Choice {
                        title: "Korean";
                        detail: "Noto Sans CJK KR";
                        chosen: Preferences.han-language == HanLanguage.korean;
                        clicked => { Preferences.choose-han-language(HanLanguage.korean); }
                    }
                }
                if root.shown-tab == SettingsTab.sessions: VerticalLayout {
                    spacing: Theme.space-xs;
                    Heading {
                        text: "Messages from other sessions";
                    }
                    Explanation {
                        text: "For messages to agy and opencode sessions. Messages to Claude Code follow its crossSessionInbound setting.";
                    }
                    Choice {
                        title: "Ask before letting a new sender in";
                        detail: "The first message from each sender waits until you let it in. Its later messages in that session come in at once.";
                        chosen: Preferences.peer-messages == PeerMessages.ask-each-sender;
                        clicked => { Preferences.choose-peer-messages(PeerMessages.ask-each-sender); }
                    }
                    Choice {
                        title: "Let every message in";
                        detail: "Sessions message each other without asking you.";
                        chosen: Preferences.peer-messages == PeerMessages.let-all-in;
                        clicked => { Preferences.choose-peer-messages(PeerMessages.let-all-in); }
                    }
                    Rectangle {
                        height: Theme.space-m;
                    }
                    Heading {
                        text: "New projects";
                    }
                    Explanation {
                        text: "The folder New project makes new projects in, unless you choose another.";
                    }
                    HorizontalLayout {
                        spacing: Theme.space-s;
                        Field {
                            property <string> saved: Preferences.new-projects-in;
                            changed saved => { self.text = self.saved; }
                            init => { self.text = Preferences.new-projects-in; }
                            horizontal-stretch: 1;
                            min-width: 80px;
                            placeholder: "Folder for new projects";
                            accepted(text) => { Preferences.set-new-projects-in(text); }
                            changed has-focus => {
                                if !self.has-focus && self.text != Preferences.new-projects-in {
                                    Preferences.set-new-projects-in(self.text);
                                }
                            }
                        }
                        TextButton {
                            text: "Browse…";
                            horizontal-stretch: 0;
                            may-shorten: true;
                            clicked => { Preferences.browse-new-projects-in(); }
                        }
                    }
                }
                if root.shown-tab == SettingsTab.account: VerticalLayout {
                    spacing: Theme.space-xs;
                    if root.knows-account: Heading {
                        text: Session.sign-in == SignInState.signed-in ? "Signed in"
                            : Session.sign-in == SignInState.signed-out ? "Account (not signed in)" : "Account";
                    }
                    if root.knows-account: VerticalLayout {
                        spacing: Theme.space-xs;
                        for line in [
                            { label: "Email", value: Session.email },
                            { label: "Organization", value: Session.organization },
                            { label: "Provider", value: Session.provider },
                            { label: Session.program, value: Session.version },
                            { label: "This session", value: Session.cost },
                        ]: HorizontalLayout {
                            spacing: Theme.space-s;
                            visible: line.value != "";
                            height: line.value != "" ? self.preferred-height : 0;
                            Small {
                                text: line.label;
                                width: min(8.5rem, page.width * 38%);
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            Text {
                                text: line.value;
                                color: Theme.text;
                                font-size: 1rem * Theme.small;
                                overflow: elide;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                min-width: 0px;
                            }
                        }
                    }
                    if root.knows-account: Rectangle {
                        height: Theme.space-m;
                    }
                    Heading {
                        text: "Anthropic API key";
                    }
                    Explanation {
                        text: Preferences.api-key-kept
                            ? "Kept in your desktop's keyring. New session offers Claude Code with it, billed by the token, and continuing a Claude Code session asks which sign-in to use."
                            : "Paste a key from the Anthropic Console to start Claude Code sessions with it, billed by the token. It is kept in your desktop's keyring, not in a file.";
                    }
                    HorizontalLayout {
                        spacing: Theme.space-s;
                        api-key := Field {
                            secret: true;
                            horizontal-stretch: 1;
                            min-width: 80px;
                            placeholder: Preferences.api-key-kept ? "Paste a new key to replace it" : "sk-ant-api…";
                            accepted(text) => {
                                if text != "" {
                                    Preferences.store-api-key(text);
                                    self.text = "";
                                }
                            }
                        }
                        TextButton {
                            text: "Keep";
                            enabled: api-key.text != "";
                            opacity: api-key.text != "" ? 1 : 0.72;
                            horizontal-stretch: 0;
                            may-shorten: true;
                            clicked => {
                                Preferences.store-api-key(api-key.text);
                                api-key.text = "";
                            }
                        }
                        if Preferences.api-key-kept: TextButton {
                            text: "Remove";
                            danger: true;
                            horizontal-stretch: 0;
                            may-shorten: true;
                            clicked => { Preferences.remove-api-key(); }
                        }
                    }
                    if Preferences.api-key-note != "": Explanation {
                        text: Preferences.api-key-note;
                        color: Theme.danger-text;
                    }
                }
                if root.shown-tab == SettingsTab.daemon: VerticalLayout {
                    spacing: Theme.space-xs;
                    Heading {
                        text: "edualc's daemon";
                    }
                    Explanation {
                        text: "It runs the sessions of every window, and goes on while one runs, so a newly installed edualc takes over only once it is shut down. Shutting down ends every session, in every window; the start page lets you continue them in the next window you open.";
                    }
                    FlexboxLayout {
                        flex-direction: FlexboxLayoutDirection.row;
                        flex-wrap: FlexboxLayoutWrap.wrap;
                        alignment: LayoutAlignment.start;
                        spacing: Theme.space-s;
                        TextButton {
                            text: !root.confirming-shutdown ? "Shut down edualc…"
                                : Preferences.running-sessions == 1 ? "End 1 session and shut down"
                                : "End " + Preferences.running-sessions + " sessions and shut down";
                            danger: true;
                            horizontal-stretch: 0;
                            may-shorten: true;
                            clicked => {
                                if root.confirming-shutdown {
                                    root.confirming-shutdown = false;
                                    Preferences.shut-down();
                                } else {
                                    root.confirming-shutdown = true;
                                }
                            }
                        }
                        if root.confirming-shutdown: TextButton {
                            text: "Cancel";
                            horizontal-stretch: 0;
                            clicked => { root.confirming-shutdown = false; }
                        }
                    }
                }
            }
        }
    }
    last-fence := AreaFence {
        area: FocusArea.conversation;
        crossed => {
            if !Focus.going-round {
                Focus.going-round = true;
                first-fence.focus();
                Focus.step(true);
            }
        }
    }
}
