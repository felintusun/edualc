// edualc's settings, over the conversation as the usage details are; Esc or the cross closes
// them. Each takes effect at once and is kept in `settings.json`, but the API key, which the
// keyring keeps.

import { Theme } from "theme.slint";
import { FocusArea, HanLanguage, SendKey } from "types.slint";
import { Focus, Preferences } from "state.slint";
import { AreaFence, Caption, Field, Icon, IconButton, Pressable, Small, TextButton, Title } from "widgets.slint";

// One of a setting's choices: its name, what it means, and whether it is the one in use.
component Choice inherits Pressable {
    in property <string> title;
    in property <string> detail;
    in property <bool> chosen;
    selected: root.chosen;
    accessible-role: radio-button;
    accessible-checkable: true;
    accessible-checked: root.chosen;
    accessible-label: root.title;
    accessible-description: root.detail;
    HorizontalLayout {
        padding: Theme.space-s;
        padding-left: Theme.space-m;
        spacing: Theme.space-s;
        // Centred on the title's line.
        Icon {
            source: root.chosen ? @image-url("@lucide/circle-check.svg") : @image-url("@lucide/circle.svg");
            tint: root.chosen ? Theme.accent : Theme.text-tertiary;
            width: Theme.icon-small;
            y: Theme.space-s + (title.preferred-height - self.height) / 2;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            title := Text {
                text: root.title;
                color: Theme.text;
                accessible-role: none;
            }
            Small {
                text: root.detail;
                wrap: word-wrap;
            }
        }
    }
}

export component SettingsPanel inherits Rectangle {
    callback close;
    // Shut down was pressed once: the second press, on the button that says what ends, does it.
    property <bool> confirming-shutdown;
    background: Theme.surface;
    // The focus comes in as it opens, and Tab goes round within it: what is typed must not go
    // to the composer it covers.
    init => {
        first-fence.focus();
        Focus.step(true);
    }
    first-fence := AreaFence {
        area: FocusArea.conversation;
        crossed => {
            if !Focus.going-round {
                Focus.going-round = true;
                last-fence.focus();
                Focus.step(false);
            }
        }
    }
    VerticalLayout {
        HorizontalLayout {
            height: Theme.header;
            padding-left: Theme.space-xl;
            padding-right: Theme.space-m;
            spacing: Theme.space-m;
            Icon {
                source: @image-url("@lucide/settings.svg");
                tint: Theme.claude;
                width: 22px;
                y: (parent.height - self.height) / 2;
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Title {
                    text: "Settings";
                }
                Caption {
                    text: "Kept in edualc's settings.json; each takes effect at once";
                }
            }
            IconButton {
                icon: @image-url("@lucide/x.svg");
                label: "Back to the conversation (Esc)";
                y: (parent.height - self.height) / 2;
                clicked => { root.close(); }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        Flickable {
            vertical-stretch: 1;
            content-height: page.preferred-height;
            page := VerticalLayout {
                x: (parent.width - self.width) / 2;
                width: min(root.width - 2 * Theme.space-xl, 640px);
                padding-top: Theme.space-l;
                padding-bottom: Theme.space-xl;
                spacing: Theme.space-xs;
                alignment: start;
                Text {
                    text: "Sending";
                    font-weight: 600;
                    color: Theme.text;
                }
                Choice {
                    title: "Enter sends";
                    detail: "Shift+Enter or Ctrl+Enter start a new line.";
                    chosen: Preferences.send-key == SendKey.enter;
                    clicked => { Preferences.choose-send-key(SendKey.enter); }
                }
                Choice {
                    title: "Ctrl+Enter sends";
                    detail: "Enter starts a new line, so a stray Enter never sends half a message.";
                    chosen: Preferences.send-key == SendKey.ctrl-enter;
                    clicked => { Preferences.choose-send-key(SendKey.ctrl-enter); }
                }
                Rectangle {
                    height: Theme.space-m;
                }
                // Kana and Hangul tell a text's language themselves; Han characters alone don't.
                Text {
                    text: "Text in Han characters alone";
                    font-weight: 600;
                    color: Theme.text;
                }
                Small {
                    text: "Chinese, Japanese and Korean draw many Han characters differently. A message with kana is set as Japanese and one with Hangul as Korean; one in Han characters alone as chosen here.";
                    wrap: word-wrap;
                }
                Choice {
                    title: "Japanese";
                    detail: "Noto Sans CJK JP";
                    chosen: Preferences.han-language == HanLanguage.japanese;
                    clicked => { Preferences.choose-han-language(HanLanguage.japanese); }
                }
                Choice {
                    title: "Simplified Chinese";
                    detail: "Noto Sans CJK SC";
                    chosen: Preferences.han-language == HanLanguage.simplified-chinese;
                    clicked => { Preferences.choose-han-language(HanLanguage.simplified-chinese); }
                }
                Choice {
                    title: "Traditional Chinese";
                    detail: "Noto Sans CJK TC";
                    chosen: Preferences.han-language == HanLanguage.traditional-chinese;
                    clicked => { Preferences.choose-han-language(HanLanguage.traditional-chinese); }
                }
                Choice {
                    title: "Korean";
                    detail: "Noto Sans CJK KR";
                    chosen: Preferences.han-language == HanLanguage.korean;
                    clicked => { Preferences.choose-han-language(HanLanguage.korean); }
                }
                Rectangle {
                    height: Theme.space-m;
                }
                Text {
                    text: "Anthropic API key";
                    font-weight: 600;
                    color: Theme.text;
                }
                Small {
                    text: Preferences.api-key-kept
                        ? "Kept in your desktop's keyring. New session offers Claude Code with it, billed by the token, and continuing a Claude Code session asks which sign-in to use."
                        : "Paste a key from the Anthropic Console to start Claude Code sessions with it, billed by the token. It is kept in your desktop's keyring, not in a file.";
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: Theme.space-s;
                    api-key := Field {
                        secret: true;
                        horizontal-stretch: 1;
                        placeholder: Preferences.api-key-kept ? "Paste a new key to replace it" : "sk-ant-api…";
                        accepted(text) => {
                            Preferences.store-api-key(text);
                            self.text = "";
                        }
                    }
                    TextButton {
                        text: "Keep";
                        enabled: api-key.text != "";
                        clicked => {
                            Preferences.store-api-key(api-key.text);
                            api-key.text = "";
                        }
                    }
                    if Preferences.api-key-kept: TextButton {
                        text: "Remove";
                        danger: true;
                        clicked => { Preferences.remove-api-key(); }
                    }
                }
                if Preferences.api-key-note != "": Small {
                    text: Preferences.api-key-note;
                    color: Theme.danger-text;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: Theme.space-m;
                }
                Text {
                    text: "edualc's daemon";
                    font-weight: 600;
                    color: Theme.text;
                }
                Small {
                    text: "It runs the sessions of every window, and goes on while one runs, so a newly installed edualc takes over only once it is shut down. Shutting down ends every session, in every window; the sidebar continues them in the next window you open.";
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: Theme.space-s;
                    TextButton {
                        text: !root.confirming-shutdown ? "Shut down edualc…"
                            : Preferences.running-sessions == 1 ? "End 1 session and shut down"
                            : "End " + Preferences.running-sessions + " sessions and shut down";
                        danger: true;
                        clicked => {
                            if root.confirming-shutdown {
                                root.confirming-shutdown = false;
                                Preferences.shut-down();
                            } else {
                                root.confirming-shutdown = true;
                            }
                        }
                    }
                    if root.confirming-shutdown: TextButton {
                        text: "Cancel";
                        clicked => { root.confirming-shutdown = false; }
                    }
                }
            }
        }
    }
    last-fence := AreaFence {
        area: FocusArea.conversation;
        crossed => {
            if !Focus.going-round {
                Focus.going-round = true;
                first-fence.focus();
                Focus.step(true);
            }
        }
    }
}
