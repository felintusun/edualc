// The start page: sessions waiting for you across projects, project cards to pick up from,
// and ways to open a folder or start a new project.

import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { CardSessionItem, FocusArea, LiveState, ProjectCard, ProjectSort, WaitingItem } from "types.slint";
import { Focus, Nav, Sessions } from "state.slint";
import { AreaFence, Caption, Field, Icon, IconButton, LiveDot, Pressable, Small, TextButton, Title } from "widgets.slint";

// Modal dialog to open any recent project or type / browse to any folder path.
export component OpenFolderDialog inherits Rectangle {
    callback close;
    property <int> opened: Sessions.opened-serial;
    property <bool> can-open: path.text != "";
    changed opened => { root.close(); }

    background: Theme.surface;
    border-radius: Theme.radius-l;
    border-width: 1px;
    border-color: Theme.divider;
    drop-shadow-blur: 24px;
    drop-shadow-color: Theme.shadow;
    clip: true;

    VerticalLayout {
        first-fence := AreaFence {
            area: FocusArea.page;
            crossed => {
                if !Focus.going-round {
                    Focus.going-round = true;
                    last-fence.focus();
                    Focus.step(false);
                }
            }
        }
        HorizontalLayout {
            min-height: Theme.header;
            padding-left: root.width < 28rem ? Theme.space-m : Theme.space-xl;
            padding-right: Theme.space-m;
            padding-top: Theme.space-s;
            padding-bottom: Theme.space-s;
            spacing: Theme.space-m;
            Icon {
                source: @image-url("@lucide/folder.svg");
                tint: Theme.agent;
                width: 20px;
                y: (parent.height - self.height) / 2;
            }
            Title {
                text: "Open a folder";
                horizontal-stretch: 1;
                min-width: 0px;
                overflow: elide;
                vertical-alignment: center;
            }
            IconButton {
                icon: @image-url("@lucide/x.svg");
                label: "Cancel (Esc)";
                y: (parent.height - self.height) / 2;
                clicked => { root.close(); }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        VerticalLayout {
            vertical-stretch: 1;
            padding: Theme.space-l;
            spacing: Theme.space-s;
            HorizontalLayout {
                spacing: Theme.space-s;
                path := Field {
                    init => { self.focus(); }
                    horizontal-stretch: 1;
                    min-width: 80px;
                    placeholder: "Path to a folder";
                    accepted(text) => {
                        if text != "" {
                            Sessions.open-project(text);
                        }
                    }
                }
                TextButton {
                    text: "Browse…";
                    horizontal-stretch: 0;
                    may-shorten: true;
                    clicked => {
                        Sessions.browse-project();
                        root.close();
                    }
                }
                TextButton {
                    text: "Open";
                    primary: root.can-open;
                    enabled: root.can-open;
                    opacity: root.can-open ? 1 : 0.72;
                    horizontal-stretch: 0;
                    clicked => { Sessions.open-project(path.text); }
                }
            }
            if Sessions.problem != "": Text {
                text: Sessions.problem;
                color: Theme.danger-text;
                font-size: 1rem * Theme.small;
                wrap: word-wrap;
            }
            if Sessions.projects.length > 0: Caption {
                text: "Recent";
            }
            if Sessions.projects.length == 0: Caption {
                text: "No recent folders yet.";
                wrap: word-wrap;
            }
            if Sessions.projects.length > 0: ListView {
                vertical-stretch: 1;
                min-height: 0px;
                preferred-height: min(Sessions.projects.length * Theme.row-tall, 8 * Theme.row-tall);
                for project in Sessions.projects: Pressable {
                    height: Theme.row-tall;
                    accessible-label: project.name;
                    accessible-description: "\{project.path}, \{project.age}";
                    clicked => { Sessions.open-project(project.path); }
                    HorizontalLayout {
                        padding-left: Theme.space-s;
                        padding-right: Theme.space-s;
                        spacing: Theme.space-s;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            Text {
                                text: project.name;
                                color: Theme.text;
                                overflow: elide;
                                accessible-role: none;
                            }
                            Caption {
                                text: project.shown;
                                overflow: elide;
                                accessible-role: none;
                            }
                        }
                        Caption {
                            text: project.age;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                    }
                }
            }
        }
        last-fence := AreaFence {
            area: FocusArea.page;
            crossed => {
                if !Focus.going-round {
                    Focus.going-round = true;
                    first-fence.focus();
                    Focus.step(true);
                }
            }
        }
    }
}

component ProjectCardView inherits Rectangle {
    in property <ProjectCard> card;

    background: Theme.card;
    border-radius: Theme.radius-l;
    border-width: 1px;
    border-color: root.card.pinned ? Theme.accent.with-alpha(0.5) : Theme.divider;

    // A card is as tall as the tallest in its row; what it shows stays at its top.
    VerticalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-s;
        alignment: start;

        // Pin and Hide sit beside the project button rather than inside it, so clicking them
        // never opens the project.
        HorizontalLayout {
            spacing: Theme.space-xs;
            Pressable {
                horizontal-stretch: 1;
                min-width: 0px;
                accessible-label: "Open project " + root.card.name
                    + (root.card.pinned ? ", pinned" : "")
                    + (root.card.hidden ? ", hidden" : "");
                accessible-description: root.card.shown;
                clicked => { Nav.open-project-page(root.card.path); }
                VerticalLayout {
                    padding: Theme.space-xs;
                    spacing: 2px;
                    min-width: 0px;
                    HorizontalLayout {
                        spacing: Theme.space-xs;
                        Text {
                            text: root.card.name;
                            color: root.card.hidden ? Theme.text-secondary : Theme.text;
                            font-weight: 600;
                            overflow: elide;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            accessible-role: none;
                        }
                        if root.card.age != "": Caption {
                            text: root.card.age;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                    }
                    Caption {
                        text: root.card.shown;
                        overflow: elide;
                        min-width: 0px;
                        accessible-role: none;
                    }
                }
            }
            HorizontalLayout {
                spacing: 2px;
                height: Theme.chip;
                y: Theme.space-xs;
                horizontal-stretch: 0;
                IconButton {
                    width: Theme.chip;
                    height: Theme.chip;
                    icon-size: Theme.icon-small;
                    icon: @image-url("@lucide/pin.svg");
                    tint: root.card.pinned ? Theme.accent : Theme.text-tertiary;
                    label: root.card.pinned ? "Unpin " + root.card.name : "Pin " + root.card.name;
                    clicked => { Nav.toggle-pin-project(root.card.path); }
                }
                IconButton {
                    width: Theme.chip;
                    height: Theme.chip;
                    icon-size: Theme.icon-small;
                    icon: root.card.hidden ? @image-url("@lucide/eye.svg") : @image-url("@lucide/eye-off.svg");
                    tint: root.card.hidden ? Theme.warning-text : Theme.text-tertiary;
                    label: root.card.hidden ? "Unhide " + root.card.name : "Hide " + root.card.name;
                    clicked => { Nav.toggle-hide-project(root.card.path); }
                }
                IconButton {
                    width: Theme.chip;
                    height: Theme.chip;
                    icon-size: Theme.icon-small;
                    icon: @image-url("@lucide/folder-x.svg");
                    tint: Theme.text-tertiary;
                    label: "Remove " + root.card.name + " from edualc (keeps files on disk)";
                    clicked => { Nav.remove-project(root.card.path); }
                }
            }
        }

        if root.card.pinned || root.card.hidden || root.card.needs-you > 0 || root.card.running > 0: FlexboxLayout {
            flex-direction: FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.wrap;
            alignment: LayoutAlignment.start;
            spacing: Theme.space-xs;
            if root.card.pinned: Rectangle {
                border-radius: Theme.radius-s;
                border-width: 1px;
                border-color: Theme.accent.with-alpha(0.5);
                HorizontalLayout {
                    padding-left: Theme.space-xs;
                    padding-right: Theme.space-xs;
                    Text {
                        text: "Pinned";
                        font-size: 1rem * Theme.caption;
                        color: Theme.accent;
                        vertical-alignment: center;
                    }
                }
            }
            if root.card.hidden: Rectangle {
                border-radius: Theme.radius-s;
                border-width: 1px;
                border-color: Theme.control-border;
                HorizontalLayout {
                    padding-left: Theme.space-xs;
                    padding-right: Theme.space-xs;
                    Text {
                        text: "Hidden";
                        font-size: 1rem * Theme.caption;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }
            }
            if root.card.needs-you > 0: Rectangle {
                border-radius: Theme.radius-s;
                border-width: 1px;
                border-color: Theme.warning-text;
                HorizontalLayout {
                    padding-left: Theme.space-xs;
                    padding-right: Theme.space-xs;
                    Text {
                        text: "\{root.card.needs-you} waiting";
                        font-size: 1rem * Theme.caption;
                        color: Theme.warning-text;
                        vertical-alignment: center;
                    }
                }
            }
            if root.card.running > 0: Rectangle {
                border-radius: Theme.radius-s;
                border-width: 1px;
                border-color: Theme.agent;
                HorizontalLayout {
                    padding-left: Theme.space-xs;
                    padding-right: Theme.space-xs;
                    Text {
                        text: "\{root.card.running} running";
                        font-size: 1rem * Theme.caption;
                        color: Theme.agent;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.card.last-said != "": Small {
            text: root.card.last-said;
            color: Theme.text-secondary;
            overflow: elide;
            min-width: 0px;
        }

        if root.card.has-sessions: Rectangle {
            height: 1px;
            background: Theme.divider;
        }

        if root.card.has-sessions: VerticalLayout {
            spacing: 2px;
            for session in root.card.sessions: Pressable {
                height: Theme.row;
                accessible-label: session.title + ", " + session.age;
                clicked => { Nav.jump-to(root.card.path, session.id, session.hosted-id); }
                HorizontalLayout {
                    padding-left: Theme.space-xs;
                    padding-right: Theme.space-xs;
                    spacing: Theme.space-s;
                    LiveDot {
                        state: session.state;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: session.title;
                        color: session.state == LiveState.waiting ? Theme.warning-text : Theme.text;
                        font-size: 1rem * Theme.small;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        accessible-role: none;
                    }
                    Caption {
                        text: session.age;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
            }
        }

        if !root.card.has-sessions: Caption {
            text: "No sessions yet — open to start one";
            wrap: word-wrap;
            min-width: 0px;
        }
    }
}

export component StartPage inherits Rectangle {
    callback open-new-project;
    callback open-folder-dialog;

    property <string> filter;
    property <[ProjectCard]> shown-cards: Nav.filter-cards(Nav.cards, root.filter);
    property <bool> narrow: self.width < 40rem;
    property <length> page-padding: root.narrow ? Theme.space-m : Theme.space-xl;
    property <int> wanted: Focus.wanted-serial;
    property <int> focus-page: Nav.page-focus-serial;
    changed wanted => { self.take-wanted(); }
    changed focus-page => { filter-field.focus(); }
    // The page comes with the change that asks for it, so `focus-page` doesn't change for it;
    // and what had the focus went with the page before, which leaves the window's shortcuts
    // nothing to hear them. Reset any earlier backend filter to match the freshly mounted field.
    init => {
        filter-field.focus();
        Nav.start-filter-edited("");
    }

    function take-wanted() {
        if Focus.pending && Focus.wanted == FocusArea.page {
            Focus.pending = false;
            filter-field.focus();
        }
    }

    background: Theme.surface;

    VerticalLayout {
        page-start := AreaFence {
            area: FocusArea.page;
            crossed => {
                if !Focus.going-round {
                    Focus.going-round = true;
                    page-end.focus();
                    Focus.step(false);
                }
            }
        }
        ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            HorizontalLayout {
                padding: root.page-padding;
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    width: min(max(0px, root.width - 2 * root.page-padding), 1080px);
                    spacing: Theme.space-l;
                    alignment: start;

                    VerticalLayout {
                        spacing: Theme.space-s;
                        FlexboxLayout {
                            flex-direction: FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.wrap;
                            alignment: LayoutAlignment.space-between;
                            spacing: Theme.space-s;
                            Title {
                                text: "Projects";
                                vertical-alignment: center;
                                min-height: Theme.control;
                            }
                            FlexboxLayout {
                                flex-direction: FlexboxLayoutDirection.row;
                                flex-wrap: FlexboxLayoutWrap.wrap;
                                alignment: LayoutAlignment.start;
                                spacing: Theme.space-s;
                                TextButton {
                                    text: "New project…";
                                    primary: true;
                                    has-icon: true;
                                    icon: @image-url("@lucide/folder-plus.svg");
                                    may-shorten: true;
                                    horizontal-stretch: 0;
                                    clicked => { root.open-new-project(); }
                                }
                                TextButton {
                                    text: "Open a folder…";
                                    has-icon: true;
                                    icon: @image-url("@lucide/folder.svg");
                                    may-shorten: true;
                                    horizontal-stretch: 0;
                                    clicked => {
                                        Sessions.refresh-projects();
                                        root.open-folder-dialog();
                                    }
                                }
                            }
                        }

                        filter-field := Field {
                            placeholder: "Filter projects (Ctrl+K)";
                            edited(text) => {
                                root.filter = text;
                                Nav.start-filter-edited(text);
                            }
                            init => { root.take-wanted(); }
                            changed has-focus => {
                                if self.has-focus {
                                    Focus.area = FocusArea.page;
                                }
                            }
                        }

                        FlexboxLayout {
                            flex-direction: FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.wrap;
                            alignment: LayoutAlignment.start;
                            spacing: Theme.space-xs;

                            Pressable {
                                height: Theme.chip;
                                selected: Nav.project-sort == ProjectSort.pinned-first;
                                border-width: 1px;
                                border-color: Nav.project-sort == ProjectSort.pinned-first ? Theme.accent.with-alpha(0.5) : Theme.divider;
                                accessible-role: radio-button;
                                accessible-checkable: true;
                                accessible-checked: Nav.project-sort == ProjectSort.pinned-first;
                                accessible-label: "Sort pinned projects first";
                                clicked => { Nav.set-project-sort(ProjectSort.pinned-first); }
                                HorizontalLayout {
                                    padding-left: Theme.space-m;
                                    padding-right: Theme.space-s;
                                    spacing: Theme.space-xs;
                                    Icon {
                                        source: @image-url("@lucide/pin.svg");
                                        tint: Nav.project-sort == ProjectSort.pinned-first ? Theme.accent : Theme.text-tertiary;
                                        width: Theme.icon-small;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "Pinned first";
                                        font-size: 1rem * Theme.small;
                                        color: Nav.project-sort == ProjectSort.pinned-first ? Theme.text : Theme.text-secondary;
                                        vertical-alignment: center;
                                        accessible-role: none;
                                    }
                                }
                            }

                            Pressable {
                                height: Theme.chip;
                                selected: Nav.project-sort == ProjectSort.recent;
                                border-width: 1px;
                                border-color: Nav.project-sort == ProjectSort.recent ? Theme.accent.with-alpha(0.5) : Theme.divider;
                                accessible-role: radio-button;
                                accessible-checkable: true;
                                accessible-checked: Nav.project-sort == ProjectSort.recent;
                                accessible-label: "Sort by most recent";
                                clicked => { Nav.set-project-sort(ProjectSort.recent); }
                                HorizontalLayout {
                                    padding-left: Theme.space-m;
                                    padding-right: Theme.space-s;
                                    spacing: Theme.space-xs;
                                    Icon {
                                        source: @image-url("@lucide/clock.svg");
                                        tint: Nav.project-sort == ProjectSort.recent ? Theme.accent : Theme.text-tertiary;
                                        width: Theme.icon-small;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "Most recent";
                                        font-size: 1rem * Theme.small;
                                        color: Nav.project-sort == ProjectSort.recent ? Theme.text : Theme.text-secondary;
                                        vertical-alignment: center;
                                        accessible-role: none;
                                    }
                                }
                            }

                            if Nav.hidden-projects-count > 0: Pressable {
                                height: Theme.chip;
                                selected: Nav.show-hidden-projects;
                                border-width: 1px;
                                border-color: Nav.show-hidden-projects ? Theme.accent.with-alpha(0.5) : Theme.divider;
                                accessible-role: checkbox;
                                accessible-checkable: true;
                                accessible-checked: Nav.show-hidden-projects;
                                accessible-label: Nav.show-hidden-projects
                                    ? "Hide hidden projects (\{Nav.hidden-projects-count})"
                                    : "Show hidden projects (\{Nav.hidden-projects-count})";
                                clicked => { Nav.toggle-show-hidden-projects(); }
                                HorizontalLayout {
                                    padding-left: Theme.space-m;
                                    padding-right: Theme.space-s;
                                    spacing: Theme.space-xs;
                                    Icon {
                                        source: Nav.show-hidden-projects ? @image-url("@lucide/eye.svg") : @image-url("@lucide/eye-off.svg");
                                        tint: Nav.show-hidden-projects ? Theme.accent : Theme.text-tertiary;
                                        width: Theme.icon-small;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: Nav.show-hidden-projects
                                            ? "Showing hidden (\{Nav.hidden-projects-count})"
                                            : "Show hidden (\{Nav.hidden-projects-count})";
                                        font-size: 1rem * Theme.small;
                                        color: Nav.show-hidden-projects ? Theme.text : Theme.text-secondary;
                                        vertical-alignment: center;
                                        accessible-role: none;
                                    }
                                }
                            }

                            if root.filter == "" && (Nav.has-more-projects || Nav.show-all-projects): Pressable {
                                height: Theme.chip;
                                border-width: 1px;
                                border-color: Theme.divider;
                                accessible-label: Nav.show-all-projects
                                    ? "Show fewer projects"
                                    : "Show all \{Nav.total-projects} projects";
                                clicked => { Nav.toggle-show-all-projects(); }
                                HorizontalLayout {
                                    padding-left: Theme.space-s;
                                    padding-right: Theme.space-s;
                                    spacing: Theme.space-xs;
                                    Icon {
                                        source: Nav.show-all-projects ? @image-url("@lucide/chevron-up.svg") : @image-url("@lucide/chevron-down.svg");
                                        tint: Theme.text-tertiary;
                                        width: Theme.icon-small;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: Nav.show-all-projects
                                            ? "Show fewer"
                                            : "Show all (\{Nav.total-projects})";
                                        font-size: 1rem * Theme.small;
                                        color: Theme.text-secondary;
                                        vertical-alignment: center;
                                        accessible-role: none;
                                    }
                                }
                            }
                        }
                    }

                    if Nav.waiting.length > 0 && root.filter == "": VerticalLayout {
                        spacing: Theme.space-s;
                        Text {
                            text: "Needs you";
                            color: Theme.warning-text;
                            font-weight: 600;
                        }
                        for item in Nav.waiting: Pressable {
                            background: Theme.card;
                            border-radius: Theme.radius-m;
                            border-width: 1px;
                            border-color: Theme.warning-text;
                            accessible-label: item.project-name + ", " + item.session-title + ": " + item.question;
                            clicked => { Nav.jump-to(item.project-folder, item.session-id, item.hosted-id); }
                            HorizontalLayout {
                                padding: Theme.space-m;
                                spacing: Theme.space-m;
                                LiveDot {
                                    state: LiveState.waiting;
                                    y: Theme.space-xs;
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    spacing: Theme.space-xs;
                                    HorizontalLayout {
                                        spacing: Theme.space-s;
                                        Text {
                                            text: item.project-name + " — " + item.session-title;
                                            color: Theme.text;
                                            font-weight: 600;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                            min-width: 0px;
                                            accessible-role: none;
                                        }
                                        Caption {
                                            text: item.waited;
                                            vertical-alignment: center;
                                            accessible-role: none;
                                        }
                                    }
                                    Text {
                                        text: item.question;
                                        color: Theme.text-secondary;
                                        wrap: word-wrap;
                                        min-width: 0px;
                                        accessible-role: none;
                                    }
                                }
                                if !root.narrow: TextButton {
                                    text: "Open session";
                                    horizontal-stretch: 0;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { Nav.jump-to(item.project-folder, item.session-id, item.hosted-id); }
                                }
                            }
                        }
                    }

                    if root.shown-cards.length > 0: grid := FlexboxLayout {
                        flex-direction: FlexboxLayoutDirection.row;
                        flex-wrap: FlexboxLayoutWrap.wrap;
                        alignment: LayoutAlignment.start;
                        spacing: Theme.space-m;
                        property <int> cols: grid.width >= 65rem ? 3 : grid.width >= 42rem ? 2 : 1;
                        property <length> card-width: (grid.width - (self.cols - 1) * Theme.space-m) / self.cols;
                        for card in root.shown-cards: ProjectCardView {
                            card: card;
                            width: grid.card-width;
                        }
                    }

                    if root.filter == "" && Nav.has-more-projects: HorizontalLayout {
                        alignment: center;
                        TextButton {
                            text: "Show all (\{Nav.total-projects})";
                            label: "Show all \{Nav.total-projects} projects";
                            has-icon: true;
                            icon: @image-url("@lucide/chevron-down.svg");
                            horizontal-stretch: 0;
                            clicked => { Nav.toggle-show-all-projects(); }
                        }
                    }

                    if root.shown-cards.length == 0: Small {
                        text: root.filter != ""
                            ? "No project matches the filter."
                            : Nav.hidden-projects-count > 0 && !Nav.show-hidden-projects
                            ? "All projects are hidden. Turn on Show hidden above to see them."
                            : "No recent projects yet. Create a new project or open a folder to begin.";
                        wrap: word-wrap;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
        page-end := AreaFence {
            area: FocusArea.page;
            crossed => {
                if !Focus.going-round {
                    Focus.going-round = true;
                    page-start.focus();
                    Focus.step(true);
                }
            }
        }
    }
}
