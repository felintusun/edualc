// The window: the sessions on the left; the conversation, what Claude asks and the composer in
// the middle; side questions on the right.

import { ListView } from "std-widgets.slint";
import { Look, Motion, SyntaxColours, Theme } from "theme.slint";
import { Activity, ComposerSize, FocusArea, LiveState, PermissionKind, Program, PromptKind, SendKey, SessionRow, SessionRowKind, SideView, SignInState, SignInWith, TaskKind } from "types.slint";
import { Clipboard, Composer, Focus, Peek, Preferences, Prompt, Session, Sessions, Side, TextSelection, Transcript, Usage } from "state.slint";
import { AreaFence, Caption, Field, Icon, IconButton, KeyPress, Meter, MenuButton, Pressable, Small, TextButton, Title, UsageBar } from "widgets.slint";
import { EntryView } from "transcript.slint";
import { Heron, HeronMark } from "heron.slint";
import { PeekPanel } from "peek.slint";
import { PlanReview } from "plan.slint";
import { SettingsPanel } from "settings.slint";
import { SidePanel } from "side.slint";
import { UsagePanel } from "usage.slint";

export { Look, Motion, SyntaxColours, Theme } from "theme.slint";
export { Activity, BlockKind, Cjk, CjkChars, CommandItem, ComposerSize, DiffKind, DiffLine, HanLanguage, ImageChip, Entry, EntryKind, LiveState, MdBlock, PeekStep, PermissionKind, PlanSection, ProjectItem, PromptKind, Question, QuestionOption, SendKey, SessionRow, SessionRowKind, SideExchange, SideState, SideView, SignInState, StatRow, StatSection, StepKind, TaskItem, TaskKind, ToolState } from "types.slint";
export { Clipboard, Composer, Focus, Peek, Preferences, Prompt, Session, Sessions, Side, TextSelection, Transcript, Usage } from "state.slint";

// How a session running elsewhere is doing: working, waiting for its user, idle. Still: its
// work is another window's to show, and a moving dot here would keep this one drawing.
// Told by shape, not colour alone (Gruvbox's orange and yellow are close): a hand while it
// waits for its user, as on a tool's card; a dot while it works; a ring while idle.
component LiveDot inherits Rectangle {
    in property <LiveState> state;
    width: Theme.icon-small;
    height: Theme.icon-small;
    if root.state == LiveState.waiting: Icon {
        source: @image-url("@lucide/hand.svg");
        width: root.width;
        tint: Theme.warning-text;
    }
    if root.state != LiveState.waiting: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.state == LiveState.busy ? Theme.claude : transparent;
        border-width: root.state == LiveState.busy ? 0 : 1.5px;
        border-color: Theme.text-faint;
    }
}

// What runs besides the turn's own steps, and how much ("2 agents, 1 command"); a click lists
// it. A background agent's or command's card shows it done as soon as it started, and it runs
// on after the turn; agents the turn waits for are nested out of sight under their call. So
// nothing else tells how many run.
component TasksChip inherits Pressable {
    height: Theme.chip;
    min-width: 0px;
    border-radius: Theme.radius-m;
    accessible-label: "Running now: " + Session.tasks-summary;
    clicked => { tasks-menu.show(); }
    property <int> wanted: Session.tasks-wanted;
    changed wanted => { tasks-menu.show(); }
    HorizontalLayout {
        padding-left: Theme.space-s;
        padding-right: Theme.space-s;
        spacing: Theme.space-xs;
        Icon {
            source: @image-url("@lucide/layers.svg");
            tint: Theme.claude;
            width: Theme.icon-small;
            y: (parent.height - self.height) / 2;
        }
        Small {
            text: Session.tasks-summary;
            color: Theme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
            min-width: 0px;
        }
    }
    // A popup keeps the size it opened with, and tasks end or start while it is open: it takes
    // the height above the chip, and the card in it fits what is listed now, at its foot by the
    // chip. A click on the rest closes it, as one outside does.
    tasks-menu := PopupWindow {
        x: 0;
        y: -self.height - Theme.space-xs;
        width: 380px;
        height: max(0px, root.absolute-position.y - Theme.space-m);
        close-policy: close-on-click-outside;
        TouchArea {
            clicked => { tasks-menu.close(); }
        }
        Rectangle {
            y: parent.height - self.height;
            height: min(tasks-body.preferred-height, parent.height);
            clip: true;
            background: Theme.surface;
            border-radius: Theme.radius-m;
            border-width: 1px;
            border-color: Theme.divider;
            drop-shadow-blur: 12px;
            drop-shadow-color: Theme.shadow;
            tasks-body := VerticalLayout {
                padding: Theme.space-m;
                spacing: Theme.space-s;
                HorizontalLayout {
                    spacing: Theme.space-s;
                    Text {
                        text: Session.tasks-left-running ? "Still running" : "Running now";
                        color: Theme.text;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if Session.tasks.length > 1: TextButton {
                        text: "Stop all";
                        clicked => { Session.stop-all-tasks(); }
                    }
                }
                // Stopping a turn leaves what runs beside it running, as the user wanted:
                // they decide here.
                if Session.tasks-left-running: Small {
                    text: "The turn stopped; these go on. Stop them here, or leave them running.";
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                // A subagent's row opens what it does beside the conversation.
                for task in Session.tasks: Pressable {
                    enabled: task.peekable;
                    tab-stop: task.peekable;
                    accessible-label: task.peekable ? "Follow " + task.title : task.title;
                    clicked => {
                        tasks-menu.close();
                        Peek.follow(task.id);
                    }
                    HorizontalLayout {
                        padding: Theme.space-xs;
                        spacing: Theme.space-s;
                        Icon {
                            source: task.kind == TaskKind.agent ? @image-url("@lucide/bot.svg")
                                : task.kind == TaskKind.command ? @image-url("@lucide/square-terminal.svg")
                                : task.kind == TaskKind.workflow ? @image-url("@lucide/workflow.svg")
                                : task.kind == TaskKind.monitor ? @image-url("@lucide/radar.svg")
                                : @image-url("@lucide/circle-dashed.svg");
                            tint: Theme.text-secondary;
                            width: Theme.icon-small;
                            y: Theme.space-xs / 2;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            Text {
                                text: task.title;
                                color: Theme.text;
                                wrap: word-wrap;
                            }
                            Caption {
                                text: task.detail;
                            }
                            if task.used != "": Caption {
                                text: task.used;
                            }
                            if task.now != "": Caption {
                                text: task.now;
                                wrap: word-wrap;
                            }
                        }
                        // Not a bare square, which reads as a checkbox in a list.
                        IconButton {
                            icon: @image-url("@lucide/circle-stop.svg");
                            icon-size: Theme.icon-small;
                            label: "Stop " + task.title;
                            y: (parent.height - self.height) / 2;
                            clicked => { Session.stop-task(task.id); }
                        }
                        if task.peekable: Icon {
                            source: @image-url("@lucide/chevron-right.svg");
                            tint: Theme.text-tertiary;
                            width: Theme.icon-small;
                            y: (parent.height - self.height) / 2;
                        }
                        // The chevron's room, so that every row's stop button lines up.
                        if !task.peekable: Rectangle {
                            width: Theme.icon-small;
                        }
                    }
                }
            }
        }
    }
}

// A heading over a part of the session list: the sessions running now, or this folder's
// earlier ones, with how many need their user.
component SessionHeading inherits Rectangle {
    in property <SessionRow> entry;
    accessible-role: text;
    accessible-label: root.entry.detail == "" ? root.entry.title : root.entry.title + ", " + root.entry.detail;
    HorizontalLayout {
        padding-left: Theme.space-s;
        padding-right: Theme.space-s;
        padding-top: Theme.space-m;
        padding-bottom: Theme.space-xs;
        spacing: Theme.space-s;
        Text {
            text: root.entry.title;
            font-size: 1rem * Theme.small;
            font-weight: 600;
            color: Theme.text-secondary;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0px;
            accessible-role: none;
        }
        if root.entry.detail != "": Text {
            text: root.entry.detail;
            font-size: 1rem * Theme.small;
            color: Theme.warning-text;
            accessible-role: none;
        }
    }
}

// A session running now (this window's, another's, a terminal's), on two lines: its title,
// then what it does, its name to message it by and where it runs; its subagents counted.
// How many subagents a running session has: a bot and the number.
component AgentCount inherits HorizontalLayout {
    in property <int> agents;
    spacing: Theme.space-xs;
    Icon {
        source: @image-url("@lucide/bot.svg");
        width: Theme.icon-small;
        tint: Theme.text-tertiary;
        y: (parent.height - self.height) / 2;
    }
    Text {
        text: root.agents;
        font-size: 1rem * Theme.caption;
        color: Theme.text-tertiary;
        vertical-alignment: center;
        accessible-role: none;
    }
}

component RunningRow inherits Pressable {
    in property <SessionRow> entry;
    height: Theme.row-tall;
    selected: root.entry.selected;
    accessible-label: root.entry.title + ", " + root.entry.detail
        + (root.entry.agents == 1 ? ", 1 agent running" : root.entry.agents > 1 ? ", \{root.entry.agents} agents running" : "");
    clicked => { Sessions.open(root.entry.id); }
    HorizontalLayout {
        padding-left: Theme.space-m;
        padding-right: Theme.space-s;
        spacing: Theme.space-s;
        LiveDot {
            state: root.entry.state;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            title := Text {
                text: root.entry.title;
                color: Theme.text;
                overflow: elide;
                accessible-role: none;
            }
            // A plain Text, as a Caption's look: `accessible-role: none` hides only built-in
            // elements; on a component's use it makes an unnamed node instead.
            Text {
                text: root.entry.detail;
                font-size: 1rem * Theme.caption;
                color: root.entry.state == LiveState.waiting ? Theme.warning-text : Theme.text-tertiary;
                overflow: elide;
                accessible-role: none;
            }
        }
        // The session shown here: its count opens the list of what runs, where an agent's
        // work can be followed.
        if root.entry.agents > 0 && root.entry.selected: Pressable {
            accessible-label: root.entry.agents == 1 ? "1 agent running, show it"
                : "\{root.entry.agents} agents running, show them";
            clicked => { Session.tasks-wanted += 1; }
            AgentCount {
                agents: root.entry.agents;
                padding-left: Theme.space-xs;
                padding-right: Theme.space-xs;
            }
        }
        if root.entry.agents > 0 && !root.entry.selected: AgentCount {
            agents: root.entry.agents;
        }
    }
    // The whole title, where the row cuts it off.
    if title.preferred-width > title.width: Tooltip {
        text: @markdown("\{root.entry.title}");
    }
}

// One of this folder's earlier sessions: continued when opened.
component EarlierRow inherits Pressable {
    in property <SessionRow> entry;
    height: Theme.row;
    selected: root.entry.selected;
    accessible-label: root.entry.title + ", " + root.entry.age + (root.entry.worktree != "" ? ", in the worktree " + root.entry.worktree : "");
    clicked => { Sessions.open(root.entry.id); }
    HorizontalLayout {
        padding-left: Theme.space-m;
        padding-right: Theme.space-s;
        spacing: Theme.space-s;
        if root.entry.worktree != "": Icon {
            source: @image-url("@lucide/git-branch.svg");
            width: Theme.icon-small;
            tint: Theme.text-tertiary;
            y: (parent.height - self.height) / 2;
        }
        title := Text {
            text: root.entry.title;
            color: Theme.text-secondary;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            accessible-role: none;
        }
        Text {
            text: root.entry.age;
            font-size: 1rem * Theme.caption;
            color: Theme.text-tertiary;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    if title.preferred-width > title.width: Tooltip {
        text: @markdown("\{root.entry.title}");
    }
}

// Narrow windows give up the sidebar's width first, then the side panel's; the conversation
// keeps the rest. Its right edge sets its width: dragged, or with the arrow keys.
component Sidebar inherits Rectangle {
    // The widest it is dragged to.
    property <length> widest: 720px;
    // The programs a new session can run, in the order the New session menu lists them;
    // Claude Code with the API key while the keyring keeps one.
    property <[{program: Program, title: string}]> programs: Sessions.api-key-kept ? [
        { program: Program.claude, title: "Claude Code" },
        { program: Program.claude-api-key, title: "Claude Code with the API key" },
        { program: Program.agy, title: "agy" },
    ] : [
        { program: Program.claude, title: "Claude Code" },
        { program: Program.agy, title: "agy" },
    ];
    // The program the arrow keys are on while the New session menu is open.
    property <int> new-highlighted;
    callback hide;
    // No narrower than its header's buttons (their size grows with the zoom): a narrow window
    // took it below them, and they spilled over the conversation's title.
    min-width: max(200px, head.min-width + 2 * Theme.space-m);
    preferred-width: Sessions.chosen-width > 0 ? Sessions.chosen-width : Theme.sidebar;
    max-width: self.preferred-width;
    horizontal-stretch: 0;
    background: Theme.surface-raised;
    // Nothing of it draws over the conversation, however narrow it is made.
    clip: true;
    // Tab goes round within the sidebar.
    sidebar-start := AreaFence {
        area: FocusArea.sidebar;
        crossed => {
            if !Focus.going-round {
                Focus.going-round = true;
                sidebar-end.focus();
                Focus.step(false);
            }
        }
    }
    VerticalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-s;
        head := HorizontalLayout {
            spacing: Theme.space-s;
            padding-left: Theme.space-xs;
            // edualc's heron, at the size of the grid it is drawn on.
            HeronMark {
                width: 24px;
                y: (parent.height - self.height) / 2;
            }
            // Gives way first: the buttons beside it keep their size.
            Title {
                text: "edualc";
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
                min-width: 0px;
            }
            IconButton {
                icon: @image-url("@lucide/palette.svg");
                label: Theme.look == Look.gruvbox ? "Plain colours" : "Gruvbox colours";
                clicked => { Session.switch-look(); }
            }
            IconButton {
                icon: @image-url("@lucide/settings.svg");
                label: "Settings (Ctrl+,)";
                clicked => {
                    Usage.close();
                    Preferences.open = true;
                }
            }
            new-button := IconButton {
                icon: @image-url("@lucide/square-pen.svg");
                label: "New session";
                clicked => {
                    root.new-highlighted = 0;
                    new-menu.show();
                }
            }
            // Where the header's button to show it again then appears.
            IconButton {
                icon: @image-url("@lucide/panel-left-close.svg");
                label: "Hide the sessions (Ctrl+B)";
                clicked => { root.hide(); }
            }
        }
        // The working directory; a click offers the others Claude Code was used in.
        project-button := Pressable {
            accessible-label: "Folder \{Session.project}";
            accessible-description: "\{Session.cwd}. Opens the folders to work in instead.";
            clicked => {
                Sessions.refresh-projects();
                projects.show();
            }
            HorizontalLayout {
                padding: Theme.space-s;
                spacing: Theme.space-s;
                Icon {
                    source: @image-url("@lucide/folder.svg");
                    y: (parent.height - self.height) / 2;
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    Text {
                        text: Session.project;
                        font-weight: 600;
                        color: Theme.text;
                        overflow: elide;
                    }
                    Caption {
                        text: Session.cwd;
                        overflow: elide;
                    }
                }
                Icon {
                    source: @image-url("@lucide/chevrons-up-down.svg");
                    width: Theme.icon-small;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        // Opens below the New session button, its right edge on the button's.
        new-menu := PopupWindow {
            x: head.x + new-button.x + new-button.width - self.width;
            y: head.y + new-button.y + new-button.height + Theme.space-xs;
            width: 300px;
            height: new-items.preferred-height;
            // Up and Down move through the programs, Enter or Space starts one; Esc closes.
            FocusScope {
                init => { self.focus(); }
                key-pressed(event) => {
                    if event.text == Key.UpArrow {
                        root.new-highlighted = max(0, root.new-highlighted - 1);
                        return accept;
                    }
                    if event.text == Key.DownArrow {
                        root.new-highlighted = min(root.programs.length - 1, root.new-highlighted + 1);
                        return accept;
                    }
                    if event.text == Key.Return || event.text == " " {
                        new-menu.close();
                        Sessions.new-session(root.programs[root.new-highlighted].program);
                        return accept;
                    }
                    return reject;
                }
            }
            Rectangle {
                background: Theme.surface-raised;
                border-radius: Theme.radius-m;
                border-width: 1px;
                border-color: Theme.control-border;
                drop-shadow-blur: 12px;
                drop-shadow-color: #0006;
                new-items := VerticalLayout {
                    padding: Theme.space-xs;
                    spacing: 2px;
                    Caption {
                        text: "New session";
                        horizontal-alignment: left;
                    }
                    for item[index] in root.programs: Pressable {
                        highlighted: index == root.new-highlighted;
                        tab-stop: false;
                        accessible-label: "New \{item.title} session";
                        clicked => { Sessions.new-session(item.program); }
                        HorizontalLayout {
                            padding: Theme.space-s;
                            padding-left: Theme.space-m;
                            spacing: Theme.space-s;
                            Text {
                                text: item.title;
                                color: Theme.text;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            if item.program == Sessions.program: Caption {
                                text: "Ctrl+N";
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
        // The folder typed was opened: the list closes.
        property <int> project-opened: Sessions.opened-serial;
        changed project-opened => {
            projects.close();
        }
        projects := PopupWindow {
            x: project-button.x;
            y: project-button.y + project-button.height + Theme.space-xs;
            width: 440px;
            height: 460px;
            close-policy: close-on-click-outside;
            folders := Rectangle {
                // Why the folder last asked for didn't open (emptied each time the list opens):
                // the list stays open, the path still in its field to correct.
                property <string> problem: Sessions.problem;
                function open(path: string) {
                    Sessions.open-project(path);
                }
                background: Theme.surface;
                border-radius: Theme.radius-l;
                border-width: 1px;
                border-color: Theme.divider;
                drop-shadow-blur: 12px;
                drop-shadow-color: #0004;
                VerticalLayout {
                    padding: Theme.space-s;
                    spacing: Theme.space-s;
                    HorizontalLayout {
                        spacing: Theme.space-s;
                        // The keys go here as the list opens: a path typed at once is taken,
                        // and Tab leads on to the recent folders.
                        path := Field {
                            init => { self.focus(); }
                            horizontal-stretch: 1;
                            placeholder: "Path to a folder";
                            accepted(text) => { folders.open(text); }
                        }
                        TextButton {
                            text: "Browse…";
                            clicked => {
                                Sessions.browse-project();
                                projects.close();
                            }
                        }
                    }
                    if folders.problem != "": Text {
                        text: folders.problem;
                        color: Theme.danger-text;
                        font-size: 1rem * Theme.small;
                        wrap: word-wrap;
                    }
                    Caption {
                        text: "Recent";
                    }
                    ListView {
                        for project in Sessions.projects: Pressable {
                            height: Theme.row-tall;
                            accessible-label: project.name;
                            accessible-description: "\{project.path}, \{project.age}";
                            // A recent folder may be gone since: said as for a typed one.
                            clicked => { folders.open(project.path); }
                            HorizontalLayout {
                                padding-left: Theme.space-s;
                                padding-right: Theme.space-s;
                                spacing: Theme.space-s;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: project.name;
                                        color: Theme.text;
                                        overflow: elide;
                                    }
                                    Caption {
                                        text: project.shown;
                                        overflow: elide;
                                    }
                                }
                                Caption {
                                    text: project.age;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
        // One list: the sessions running now, in any folder (this window's among them; opened,
        // one is followed, or shown here if this window's daemon runs it), then this folder's
        // earlier ones (opened, one is continued).
        // The sidebar's home for the keyboard (Ctrl+K, F6).
        Field {
            property <int> wanted: Focus.wanted-serial;
            placeholder: "Filter sessions";
            edited(text) => { Sessions.filter-edited(text); }
            init => { self.take-wanted(); }
            changed wanted => { self.take-wanted(); }
            changed has-focus => {
                if self.has-focus {
                    Focus.area = FocusArea.sidebar;
                }
            }
            function take-wanted() {
                if Focus.pending && Focus.wanted == FocusArea.sidebar {
                    Focus.pending = false;
                    self.focus();
                }
            }
        }
        if Sessions.empty != "": Small {
            text: Sessions.empty;
            wrap: word-wrap;
        }
        ListView {
            vertical-stretch: 1;
            for row in Sessions.rows: VerticalLayout {
                if row.kind == SessionRowKind.heading: SessionHeading {
                    entry: row;
                }
                if row.kind == SessionRowKind.running: RunningRow {
                    entry: row;
                }
                if row.kind == SessionRowKind.earlier: EarlierRow {
                    entry: row;
                }
            }
        }
        // The plan and how much of it is used (a click shows the details); who is signed in
        // waits behind the info button.
        VerticalLayout {
            vertical-stretch: 0;
            padding-top: Theme.space-s;
            spacing: Theme.space-xs;
            Rectangle {
                height: 1px;
                background: Theme.divider;
            }
            HorizontalLayout {
                padding-top: Theme.space-xs;
                spacing: Theme.space-s;
                // The plan is in the usage details.
                Text {
                    text: Session.program;
                    color: Theme.text;
                    font-weight: 600;
                    font-size: 1rem * Theme.small;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                    min-width: 0px;
                }
                info-button := IconButton {
                    icon: @image-url("@lucide/info.svg");
                    label: "Account";
                    width: Theme.chip;
                    height: Theme.chip;
                    icon-size: Theme.icon-small;
                    clicked => { account.show(); }
                }
            }
            usage := Pressable {
                height: bars.preferred-height + Theme.space-s;
                accessible-label: "Usage details";
                clicked => { Session.show-usage(); }
                bars := VerticalLayout {
                    padding-left: Theme.space-xs;
                    padding-right: Theme.space-xs;
                    if Session.limit-five-hour >= 0: UsageBar {
                        label: "5h";
                        used: Session.limit-five-hour;
                    }
                    if Session.limit-five-hour-resets != "": Caption {
                        text: Session.limit-five-hour-resets;
                        horizontal-alignment: right;
                    }
                    if Session.limit-seven-day >= 0: UsageBar {
                        label: "7d";
                        used: Session.limit-seven-day;
                    }
                    if Session.limit-five-hour < 0 && Session.limit-seven-day < 0: Caption {
                        text: "Usage";
                    }
                }
            }
        }
    }
    // Above the row its button is on, from the sidebar's left margin.
    account := PopupWindow {
        x: Theme.space-m;
        y: info-button.absolute-position.y - root.absolute-position.y - self.height - Theme.space-xs;
        width: 300px;
        height: details.preferred-height;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.surface-raised;
            border-radius: Theme.radius-m;
            border-width: 1px;
            border-color: Theme.control-border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #0006;
            details := VerticalLayout {
                padding: Theme.space-m;
                spacing: Theme.space-xs;
                Caption {
                    text: Session.sign-in == SignInState.signed-in ? "Signed in"
                        : Session.sign-in == SignInState.signed-out ? "Not signed in" : "Account";
                }
                for line in [
                    { label: "Email", value: Session.email },
                    { label: "Organization", value: Session.organization },
                    { label: "Provider", value: Session.provider },
                    { label: Session.program, value: Session.version },
                    { label: "This session", value: Session.cost },
                ]: HorizontalLayout {
                    spacing: Theme.space-s;
                    visible: line.value != "";
                    height: line.value != "" ? self.preferred-height : 0;
                    Small {
                        text: line.label;
                        width: 90px;
                    }
                    Text {
                        text: line.value;
                        color: Theme.text;
                        font-size: 1rem * Theme.small;
                        overflow: elide;
                        horizontal-stretch: 1;
                        min-width: 0px;
                    }
                }
            }
        }
    }
    // The right edge: dragged, it sets the sidebar's width, kept between runs; a double click
    // gives the default back. Reached with Tab, the arrow keys widen and narrow it.
    edge := FocusScope {
        x: root.width - self.width;
        width: 8px;
        height: root.height;
        focus-on-click: false;
        accessible-role: slider;
        accessible-label: "Width of the session list";
        accessible-value: round(root.width / 1px);
        accessible-value-minimum: round(root.min-width / 1px);
        accessible-value-maximum: round(root.widest / 1px);
        accessible-value-step: 32;
        accessible-action-increment => { root.keep-width(root.width + 32px); }
        accessible-action-decrement => { root.keep-width(root.width - 32px); }
        key-pressed(event) => {
            if event.text == Key.RightArrow {
                root.keep-width(root.width + 32px);
                return accept;
            }
            if event.text == Key.LeftArrow {
                root.keep-width(root.width - 32px);
                return accept;
            }
            return reject;
        }
        drag := TouchArea {
            mouse-cursor: ew-resize;
            moved => {
                if self.pressed {
                    root.drag-width(root.width + self.mouse-x - self.pressed-x);
                }
            }
            pointer-event(event) => {
                if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                    Sessions.width-chosen(round(Sessions.chosen-width / 1px));
                }
            }
            double-clicked => {
                Sessions.chosen-width = 0;
                Sessions.width-chosen(0);
            }
        }
        // A line in the accent while it is hovered, dragged or has the focus.
        Rectangle {
            x: parent.width - self.width;
            width: drag.has-hover || drag.pressed || edge.has-focus ? 3px : 0px;
            background: Theme.accent;
        }
    }
    sidebar-end := AreaFence {
        area: FocusArea.sidebar;
        crossed => {
            if !Focus.going-round {
                Focus.going-round = true;
                sidebar-start.focus();
                Focus.step(true);
            }
        }
    }

    function drag-width(width: length) {
        Sessions.chosen-width = max(root.min-width, min(root.widest, width));
    }

    function keep-width(width: length) {
        root.drag-width(width);
        Sessions.width-chosen(round(Sessions.chosen-width / 1px));
    }
}

// One answer to Claude's question, with what it means, picked or not: the arrow keys go through
// them (see PromptBar), so none is a Tab stop of its own.
component AnswerOption inherits Pressable {
    in property <bool> multi;
    in property <string> label;
    in property <string> description;
    // The arrow keys are on it, ringed: the hover's colour alone doesn't show on one picked.
    in property <bool> ringed;
    tab-stop: false;
    accessible-label: root.label;
    accessible-description: root.description;
    accessible-checkable: true;
    accessible-checked: root.selected;
    HorizontalLayout {
        padding: Theme.space-s;
        spacing: Theme.space-s;
        Icon {
            source: root.multi
                ? (root.selected ? @image-url("@lucide/square-check.svg") : @image-url("@lucide/square.svg"))
                : (root.selected ? @image-url("@lucide/circle-check.svg") : @image-url("@lucide/circle.svg"));
            tint: root.selected ? Theme.accent : Theme.text-tertiary;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: Theme.text;
                wrap: word-wrap;
                accessible-role: none;
            }
            if root.description != "": Small {
                text: root.description;
                wrap: word-wrap;
            }
        }
    }
    if root.ringed: Rectangle {
        border-radius: parent.border-radius;
        border-width: 2px;
        border-color: Theme.accent;
    }
}

// A single choice's answer, and one of any number's: their roles for assistive technology, which
// Slint takes only as constants.
component RadioAnswer inherits AnswerOption {
    accessible-role: radio-button;
}

component CheckAnswer inherits AnswerOption {
    multi: true;
    accessible-role: checkbox;
}

// What Claude waits for: may a tool run, its questions answered, its plan approved. Its buttons
// take clicks only a moment after a request appears: a click meant for what was under the
// pointer (another window, as this one opened) must not answer it.
component PromptBar inherits Rectangle {
    // The most it may take of the height; Claude's questions scroll within it.
    in property <length> tallest;
    property <bool> armed;
    property <int> serial: Prompt.serial;
    // The question shown: they come one at a time.
    property <int> current;
    // The focus comes into the prompt as it opens, unless a draft is being written (where the
    // keys would go on into it), and with F6. It goes to what the prompt asks for first: the
    // question's options, the comment on the plan, or what to do instead of a tool, never
    // straight to a button. What takes it is made with the prompt or there already, so it is
    // asked by a flag and a count (`grab-pending`, `grab-serial`), and clears the flag.
    in-out property <bool> grab-pending;
    in-out property <int> grab-serial;
    function grab() {
        Focus.area = FocusArea.writing;
        root.grab-pending = true;
        root.grab-serial += 1;
    }
    property <int> wanted: Focus.wanted-serial;
    changed wanted => {
        if Focus.pending && Focus.wanted == FocusArea.writing {
            Focus.pending = false;
            root.grab();
        }
    }
    changed serial => {
        root.armed = false;
        root.current = 0;
        arm-timer.running = true;
        if Composer.draft == "" {
            root.grab();
        }
    }
    init => {
        arm-timer.running = true;
        if Composer.draft == "" {
            root.grab();
        }
    }
    arm-timer := Timer {
        interval: 700ms;
        running: false;
        triggered => {
            self.running = false;
            root.armed = true;
        }
    }
    border-radius: Theme.radius-l;
    border-width: 1px;
    border-color: Theme.warning;
    background: Theme.card;
    VerticalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-s;
        heading := HorizontalLayout {
            spacing: Theme.space-s;
            Icon {
                source: Prompt.kind == PromptKind.question ? @image-url("@lucide/message-circle-question-mark.svg")
                    : Prompt.kind == PromptKind.plan ? @image-url("@lucide/list-checks.svg")
                    : @image-url("@lucide/shield-question-mark.svg");
                tint: Theme.warning;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: Prompt.title;
                font-weight: 600;
                color: Theme.text;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if Prompt.queued > 0: Small {
                text: "\{Prompt.queued} more waiting";
                vertical-alignment: center;
            }
        }
        if Prompt.kind == PromptKind.tool: VerticalLayout {
            spacing: Theme.space-s;
            if Prompt.summary != "": Rectangle {
                background: Theme.code;
                border-radius: Theme.radius-m;
                HorizontalLayout {
                    padding: Theme.space-m;
                    Text {
                        text: Prompt.summary;
                        color: Theme.text;
                        font-family: Prompt.summary-prose ? Theme.sans : Theme.mono;
                        font-size: Prompt.summary-prose ? 1rem : 1rem * Theme.code-size;
                        wrap: word-wrap;
                    }
                }
            }
            if Prompt.detail != "": Small {
                text: Prompt.detail;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Theme.space-s;
                TextButton {
                    enabled: root.armed;
                    text: "Allow";
                    primary: true;
                    clicked => { Prompt.allow(Prompt.request); }
                }
                // A long rule gives way in a narrow window, said in full on hover and to
                // assistive technology; Allow and Deny keep their words.
                if Prompt.always-label != "": TextButton {
                    enabled: root.armed;
                    text: Prompt.always-label;
                    may-shorten: true;
                    clicked => { Prompt.allow-always(Prompt.request); }
                }
                TextButton {
                    enabled: root.armed;
                    text: "Deny";
                    danger: true;
                    clicked => {
                        Prompt.deny(Prompt.request, feedback.text);
                        feedback.text = "";
                    }
                }
            }
            // On a line of its own, so that a narrow or zoomed window doesn't push it out of
            // sight beside a long "Always allow". Enter denies with what was written, as Deny
            // does: once armed like the buttons, and not with nothing written.
            feedback := Field {
                property <int> grab: root.grab-serial;
                placeholder: "Or tell " + Session.agent + " what to do instead";
                accepted(text) => {
                    if root.armed && text != "" {
                        Prompt.deny(Prompt.request, text);
                        self.text = "";
                    }
                }
                init => { self.take(); }
                changed grab => { self.take(); }
                function take() {
                    if root.grab-pending {
                        root.grab-pending = false;
                        self.focus();
                    }
                }
            }
        }
        // One question at a time, as in the terminal: a tab for each, marked once answered, and
        // Back and Next between them. The others stay, folded away, with what was written in
        // them.
        if Prompt.kind == PromptKind.question: VerticalLayout {
            spacing: Theme.space-s;
            tabs := HorizontalLayout {
                spacing: Theme.space-xs;
                alignment: start;
                if Prompt.questions.length > 1: HorizontalLayout {
                    spacing: Theme.space-xs;
                    // Left and Right in the options go between them.
                    for question[q] in Prompt.questions: Pressable {
                        selected: q == root.current;
                        tab-stop: false;
                        accessible-role: tab;
                        accessible-label: question.header != "" ? question.header : "Question \{q + 1}";
                        accessible-description: question.answered ? "Answered" : "Not answered yet";
                        accessible-item-selectable: true;
                        accessible-item-selected: q == root.current;
                        accessible-item-index: q;
                        accessible-item-count: Prompt.questions.length;
                        clicked => { root.current = q; }
                        HorizontalLayout {
                            padding-left: Theme.space-m;
                            padding-right: Theme.space-m;
                            padding-top: Theme.space-s;
                            padding-bottom: Theme.space-s;
                            spacing: Theme.space-xs;
                            Icon {
                                source: question.answered ? @image-url("@lucide/circle-check.svg") : @image-url("@lucide/circle.svg");
                                tint: question.answered ? Theme.accent : Theme.text-faint;
                                width: Theme.icon-small;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: question.header != "" ? question.header : "Question \{q + 1}";
                                color: q == root.current ? Theme.text : Theme.text-secondary;
                                font-size: 1rem * Theme.small;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            // What doesn't fit scrolls; the tabs and the buttons stay in view.
            body := Flickable {
                property <length> room: root.tallest - heading.preferred-height - tabs.preferred-height - choices.preferred-height - 2 * Theme.space-m - 3 * Theme.space-s;
                height: min(asked.preferred-height, max(6rem, self.room));
                content-height: asked.preferred-height;
                asked := VerticalLayout {
                    width: body.width;
                    for question[q] in Prompt.questions: entry := VerticalLayout {
                        // The option whose preview shows: the last one pointed at, else the last
                        // one picked, else the first.
                        property <int> pointed: -1;
                        property <int> picked: -1;
                        property <int> shown: self.pointed >= 0 ? self.pointed
                            : options.has-focus ? options.at
                            : self.picked >= 0 ? self.picked : 0;
                        visible: q == root.current;
                        height: self.visible ? self.preferred-height : 0px;
                        spacing: Theme.space-xs;
                        Text {
                            text: question.question;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        if question.multi: Caption {
                            text: "Pick any";
                        }
                        HorizontalLayout {
                            spacing: Theme.space-m;
                            // One stop for Tab: Up and Down go through the options and Space
                            // picks one; Enter picks one too, and for a single choice goes on to
                            // the next question. Left and Right go between the questions.
                            options := FocusScope {
                                property <int> at: 0;
                                property <int> grab: root.grab-serial;
                                horizontal-stretch: 1;
                                focus-on-click: false;
                                // A screen reader is on the option the arrow keys are on.
                                accessible-role: list;
                                accessible-label: question.question;
                                accessible-delegate-focus: self.at;
                                function take() {
                                    if root.grab-pending && q == root.current {
                                        root.grab-pending = false;
                                        self.focus();
                                    }
                                }
                                function pick() {
                                    entry.picked = self.at;
                                    Prompt.toggle-option(q, self.at);
                                }
                                // Option `o` clicked, or pressed by assistive technology.
                                function choose(o: int) {
                                    self.at = o;
                                    self.pick();
                                }
                                // To the question at `to`, the keys with it.
                                function go(to: int) {
                                    root.current = clamp(to, 0, Prompt.questions.length - 1);
                                    root.grab();
                                }
                                init => { self.take(); }
                                changed grab => { self.take(); }
                                key-pressed(event) => {
                                    if event.text == Key.DownArrow {
                                        self.at = min(self.at + 1, question.options.length - 1);
                                        return accept;
                                    }
                                    if event.text == Key.UpArrow {
                                        self.at = max(self.at - 1, 0);
                                        return accept;
                                    }
                                    if event.text == " " {
                                        self.pick();
                                        return accept;
                                    }
                                    if event.text == Key.Return {
                                        if question.multi {
                                            self.pick();
                                        } else {
                                            if !question.options[self.at].selected {
                                                self.pick();
                                            }
                                            self.go(q + 1);
                                        }
                                        return accept;
                                    }
                                    if event.text == Key.RightArrow {
                                        self.go(q + 1);
                                        return accept;
                                    }
                                    if event.text == Key.LeftArrow {
                                        self.go(q - 1);
                                        return accept;
                                    }
                                    return reject;
                                }
                                VerticalLayout {
                                    alignment: start;
                                    spacing: Theme.space-xs;
                                    for option[o] in question.options: VerticalLayout {
                                        if question.multi: CheckAnswer {
                                            label: option.label;
                                            description: option.description;
                                            selected: option.selected;
                                            highlighted: options.has-focus && o == options.at;
                                            ringed: options.has-focus && o == options.at;
                                            changed hovered => {
                                                if self.hovered {
                                                    entry.pointed = o;
                                                }
                                            }
                                            clicked => { options.choose(o); }
                                        }
                                        if !question.multi: RadioAnswer {
                                            label: option.label;
                                            description: option.description;
                                            selected: option.selected;
                                            highlighted: options.has-focus && o == options.at;
                                            ringed: options.has-focus && o == options.at;
                                            changed hovered => {
                                                if self.hovered {
                                                    entry.pointed = o;
                                                }
                                            }
                                            clicked => { options.choose(o); }
                                        }
                                    }
                                }
                            }
                            // As it is laid out (code, a mockup): not wrapped, and cut at the
                            // box's edge.
                            if question.previews: Rectangle {
                                horizontal-stretch: 1;
                                background: Theme.code;
                                border-radius: Theme.radius-m;
                                clip: true;
                                VerticalLayout {
                                    padding: Theme.space-m;
                                    alignment: start;
                                    Text {
                                        min-width: 0px;
                                        text: question.options[entry.shown].preview;
                                        font-family: Theme.mono;
                                        font-size: 1rem * Theme.code-size;
                                        color: Theme.text;
                                        wrap: no-wrap;
                                    }
                                }
                            }
                        }
                        Field {
                            placeholder: "Something else";
                            edited(text) => { Prompt.set-other(q, text); }
                        }
                        Field {
                            placeholder: "Notes for Claude, with the answer (optional)";
                            edited(text) => { Prompt.set-notes(q, text); }
                        }
                    }
                }
            }
            // Next until the last question, which is answered; Skip leaves them all.
            choices := HorizontalLayout {
                spacing: Theme.space-s;
                alignment: start;
                if root.current > 0: TextButton {
                    text: "Back";
                    clicked => { root.current -= 1; }
                }
                if root.current < Prompt.questions.length - 1: TextButton {
                    text: "Next";
                    primary: true;
                    clicked => { root.current += 1; }
                }
                if root.current >= Prompt.questions.length - 1: TextButton {
                    enabled: root.armed;
                    text: "Answer";
                    primary: true;
                    clicked => { Prompt.answer(Prompt.request); }
                }
                TextButton {
                    enabled: root.armed;
                    text: Prompt.questions.length > 1 ? "Skip all" : "Skip";
                    clicked => { Prompt.deny(Prompt.request, ""); }
                }
            }
        }
        if Prompt.kind == PromptKind.plan: VerticalLayout {
            spacing: Theme.space-s;
            if Prompt.comment-count > 0: Small {
                text: Prompt.comment-count == 1 ? "1 comment on the plan goes with your answer." : "\{Prompt.comment-count} comments on the plan go with your answer.";
            }
            overall := Field {
                property <int> grab: root.grab-serial;
                placeholder: "A comment on the whole plan (optional)";
                init => { self.take(); }
                changed grab => { self.take(); }
                function take() {
                    if root.grab-pending {
                        root.grab-pending = false;
                        self.focus();
                    }
                }
            }
            HorizontalLayout {
                spacing: Theme.space-s;
                TextButton {
                    enabled: root.armed;
                    text: "Approve, accept edits";
                    primary: true;
                    clicked => {
                        Prompt.approve-plan(Prompt.request, true, overall.text);
                        overall.text = "";
                    }
                }
                TextButton {
                    enabled: root.armed;
                    text: "Approve, ask before edits";
                    clicked => {
                        Prompt.approve-plan(Prompt.request, false, overall.text);
                        overall.text = "";
                    }
                }
                TextButton {
                    enabled: root.armed;
                    text: "Keep planning";
                    clicked => {
                        Prompt.deny(Prompt.request, overall.text);
                        overall.text = "";
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                TextButton {
                    text: Prompt.reviewing ? "Show the conversation" : "Review the plan";
                    clicked => { Prompt.reviewing = !Prompt.reviewing; }
                }
            }
        }
    }
}

// Slash commands matching the draft; Up and Down choose one, Tab takes it.
component CommandList inherits Rectangle {
    border-radius: Theme.radius-l;
    border-width: 1px;
    border-color: Theme.divider;
    background: Theme.surface-raised;
    VerticalLayout {
        padding: Theme.space-xs;
        for command[i] in Composer.commands: Pressable {
            highlighted: i == min(Composer.command-index, Composer.commands.length - 1);
            tab-stop: false;
            clicked => { Composer.pick-command(i); }
            HorizontalLayout {
                padding: Theme.space-s;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: Theme.space-m;
                Text {
                    text: "/" + command.name + (command.hint == "" ? "" : " " + command.hint);
                    color: Theme.text;
                    font-family: Theme.mono;
                    font-size: 1rem * Theme.code-size;
                    vertical-alignment: center;
                }
                Small {
                    text: command.description;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    min-width: 0px;
                }
                if i == min(Composer.command-index, Composer.commands.length - 1): Small {
                    text: "Tab";
                    color: Theme.text-faint;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// How full the context is: a short bar that warms as it fills, and the count.
component ContextMeter inherits HorizontalLayout {
    spacing: Theme.space-xs;
    Meter {
        width: 28px;
        y: (parent.height - self.height) / 2;
        fraction: Session.context-fraction;
    }
    Caption {
        text: Session.context;
        vertical-alignment: center;
    }
}

// Send, or stop while Claude works and nothing new is written (a message written meanwhile is
// sent and waits its turn).
component SendButton inherits Rectangle {
    property <bool> stop: Session.busy && Composer.draft == "";
    property <bool> ready: self.stop || Composer.draft != "";
    callback sent;
    accessible-role: button;
    accessible-label: root.stop ? "Stop" : "Send";
    accessible-enabled: root.ready;
    accessible-action-default => { if root.ready { root.press(); } }
    width: Theme.button;
    height: Theme.button;
    border-radius: Theme.radius-m;
    background: root.stop ? (touch.has-hover ? Theme.danger.with-alpha(0.24) : Theme.danger-fill)
        : !root.ready ? Theme.subtle
        : touch.pressed ? Theme.accent.darker(0.2)
        : touch.has-hover ? Theme.accent.brighter(0.1) : Theme.accent;
    animate background { duration: Motion.fast; easing: ease-out; }
    Icon {
        source: root.stop ? @image-url("@lucide/square.svg") : @image-url("@lucide/arrow-up.svg");
        tint: root.stop ? Theme.danger-text : root.ready ? Theme.on-accent : Theme.text-faint;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    function press() {
        if root.stop {
            Session.interrupt();
        } else {
            // Emptied at once (the app puts back what must wait), so an Esc right after finds
            // the draft empty and stops the turn.
            Composer.send(Composer.draft);
            Composer.draft = "";
            root.sent();
        }
    }
    touch := TouchArea {
        enabled: root.ready;
        mouse-cursor: pointer;
        clicked => { root.press(); }
        if self.has-hover: Tooltip {
            text: @markdown("\{root.stop ? "Stop (Esc)" : Preferences.send-key == SendKey.ctrl-enter ? "Send (Ctrl+Enter)" : "Send (Enter)"}");
        }
    }
    KeyPress {
        enabled: root.ready;
        ring-radius: root.border-radius;
        pressed => { root.press(); }
    }
}

// The bottom of the conversation, edge to edge, is the text box: a line sets it apart from
// the conversation and takes the accent while writing, and a click anywhere in it writes. It
// grows with the draft, then scrolls (measured by an invisible copy that wraps like it, as in
// b33p). Under the text: the mode and model, what Claude is doing, the context, send.
component EditArea inherits Rectangle {
    in property <length> tallest: 320px;
    // Given its height from outside (made taller, over the conversation), the text fills it;
    // in the column, it is as tall as its text or as dragged.
    in property <bool> stretched;
    // The most a drag makes it.
    in property <length> tallest-dragged: 600px;
    property <length> line: one-line.preferred-height;
    // Too narrow for the menus' names: set as the width changes, not bound to it, as the
    // menus' widths make that width.
    property <bool> narrow;
    changed width => { self.narrow = self.width < 720px; }
    // How it was before it was made taller.
    function back() {
        Composer.size = Composer.chosen-height > 0 ? ComposerSize.chosen : ComposerSize.fit;
    }
    function toggle(size: ComposerSize) {
        if Composer.size == size {
            root.back();
        } else {
            Composer.size = size;
        }
    }
    // Sent: a box made taller for writing goes back.
    function sent() {
        if Composer.size == ComposerSize.tall || Composer.size == ComposerSize.full {
            root.back();
        }
    }
    // Sends the draft, emptied at once (the app puts back what must wait), so an Esc right after
    // finds it empty and stops the turn.
    function send-draft() {
        Composer.send(Composer.draft);
        Composer.draft = "";
        root.sent();
    }
    // The permission modes in `PermissionMode`'s order (src/app.rs): ask, edits, plan, auto,
    // bypass. Each its own colour, by how much is let through.
    property <PermissionKind> mode: Session.mode;
    // Focuses the input with the caret at the end.
    public function focus-end() {
        input.focus();
        input.set-selection-offsets(2147483647, 2147483647);
    }
    // Where F6 goes in the writing area while Claude asks nothing.
    property <int> wanted: Focus.wanted-serial;
    changed wanted => {
        if Focus.pending && Focus.wanted == FocusArea.writing && Prompt.kind == PromptKind.none && self.visible {
            Focus.pending = false;
            self.focus-end();
        }
    }
    background: Theme.card;
    TouchArea {
        mouse-cursor: text;
        clicked => { root.focus-end(); }
    }
    // The edge shows focus, except while it glows (the caret shows it then).
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: input.has-focus && !root.glowing ? 2px : 1px;
        background: input.has-focus && !root.glowing ? Theme.accent : Theme.divider;
        animate background { duration: Motion.fast; easing: ease-out; }
    }
    // While a turn runs: the top edge glows (tinted by what is at work, the model or a tool),
    // breathing slowly in and out. Stepped, from a timer that runs only then: 10 frames a
    // second, where `animation-tick()` or `animate` would draw at the display's rate, and none
    // once the turn is over. The swing is small and slow, so the steps don't show.
    property <bool> glowing: Session.busy && Prompt.kind == PromptKind.none;
    property <int> breaths: 24;
    property <int> breath: 0;
    // 0 to 1 and back over a breath (2.4 s).
    property <float> swell: (1 - cos(root.breath * 360deg / root.breaths)) / 2;
    property <color> glow: Session.activity == Activity.tool ? Theme.info : Theme.claude;
    Timer {
        interval: 100ms;
        running: root.glowing;
        triggered => { root.breath = mod(root.breath + 1, root.breaths); }
    }
    if root.glowing: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 2px;
        background: root.glow.with-alpha(0.3 + 0.45 * root.swell);
    }
    if root.glowing: Rectangle {
        x: 0;
        y: 2px;
        width: parent.width;
        height: 10px;
        background: @linear-gradient(180deg, root.glow.with-alpha(0.16 * root.swell) 0%, root.glow.with-alpha(0) 100%);
    }
    // Waiting for an answer: the edge stays lit, nothing moves.
    if Prompt.kind != PromptKind.none: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 3px;
        background: Theme.warning;
    }
    one-line := Text {
        visible: false;
        text: " ";
    }
    measure := Text {
        visible: false;
        width: input.width;
        // With what an input method still composes, which isn't in the draft yet.
        text: Composer.draft + input.preedit-text + " ";
        font-family: input.font-family;
        wrap: word-wrap;
    }
    // The draft's width on one line, where a command's hint starts.
    typed := Text {
        visible: false;
        text: Composer.draft;
        font-family: input.font-family;
    }
    // The line the caret is on, from its top (Down on the last goes to the end).
    property <length> caret-y;
    property <bool> hint-dismissed;
    // As tall as its layout: what it holds outside the layout (the draft measured, the text
    // scrolled in its box) would make its implicit height that of all of a long draft.
    out property <length> fit-height: body.preferred-height;
    body := VerticalLayout {
        padding-left: Theme.space-xl;
        padding-right: Theme.space-l;
        padding-top: Theme.space-m;
        padding-bottom: Theme.space-s;
        spacing: Theme.space-s;
        // The images pasted, going with the next message; each can be taken off.
        if Composer.images.length > 0: HorizontalLayout {
            spacing: Theme.space-s;
            alignment: start;
            for chip[index] in Composer.images: Rectangle {
                border-radius: Theme.radius-m;
                border-width: 1px;
                border-color: Theme.divider;
                background: Theme.code;
                clip: true;
                HorizontalLayout {
                    padding: Theme.space-xs;
                    spacing: Theme.space-xs;
                    Image {
                        source: chip.thumbnail;
                        height: 56px;
                        width: 56px * max(1, chip.thumbnail.width) / max(1, chip.thumbnail.height);
                        image-fit: contain;
                        accessible-role: image;
                        accessible-label: "A pasted image, " + chip.caption;
                    }
                    VerticalLayout {
                        alignment: space-between;
                        IconButton {
                            icon: @image-url("@lucide/x.svg");
                            label: "Take this image off the message";
                            width: 24px;
                            height: 24px;
                            icon-size: Theme.icon-small;
                            clicked => { Composer.remove-image(index); }
                        }
                        Caption {
                            text: chip.caption;
                        }
                    }
                }
            }
        }
        // What a shell command does, said while the draft is one, before Enter runs it.
        if Composer.shell: HorizontalLayout {
            spacing: Theme.space-xs;
            Icon {
                source: @image-url("@lucide/square-terminal.svg");
                tint: Theme.info;
                width: Theme.icon-small;
                y: (parent.height - self.height) / 2;
            }
            Small {
                text: !Session.shell-commands ? "Shell command: " + Session.agent + " sessions don't run these. Ask " + Session.agent + " to run it, or use a terminal."
                    : "Shell command: Enter runs it beside the conversation."
                    + " Claude sees it, and what it printed, with your next message.";
                color: Theme.text-secondary;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
        scroll := Flickable {
            property <length> fixed: Composer.size == ComposerSize.chosen
                ? max(Composer.chosen-height, 2 * root.line)
                : clamp(measure.preferred-height, 2 * root.line, root.tallest);
            min-height: root.stretched ? 2 * root.line : self.fixed;
            max-height: root.stretched ? 100000px : self.fixed;
            vertical-stretch: root.stretched ? 1 : 0;
            interactive: false;
            content-height: input.height;
            // Shorter text leaves no gap below it.
            changed content-height => {
                self.content-y = max(self.content-y, self.height - self.content-height);
            }
            if Composer.draft == "" && input.preedit-text == "": Text {
                x: 0;
                y: 0;
                width: scroll.width;
                text: Session.turn ? "Write the next message; it waits until " + Session.agent + " is done"
                    : Preferences.send-key == SendKey.ctrl-enter ? "Message " + Session.agent + "  ·  / for commands  ·  ! for a shell command  ·  Ctrl+Enter to send"
                    : "Message " + Session.agent + "  ·  / for commands  ·  ! for a shell command  ·  Shift+Enter for a new line";
                overflow: elide;
                color: Theme.text-faint;
                // Only drawn: the entry itself tells assistive technology.
                accessible-role: none;
            }
            // What the command in the draft takes, after it (the draft is one line then).
            if Composer.argument-hint != "" && !root.hint-dismissed && input.preedit-text == "": Text {
                x: typed.preferred-width;
                y: 0;
                text: Composer.argument-hint;
                font-family: input.font-family;
                color: Theme.text-faint;
            }
            input := TextInput {
                width: scroll.width;
                height: max(scroll.height, measure.preferred-height);
                text <=> Composer.draft;
                changed has-focus => {
                    if self.has-focus {
                        Focus.area = FocusArea.writing;
                    }
                }
                single-line: false;
                wrap: word-wrap;
                color: Theme.text;
                // A shell command is set as code.
                font-family: Composer.shell ? Theme.mono : Theme.sans;
                selection-background-color: Theme.selection;
                selection-foreground-color: Theme.selection-text;
                accessible-label: "Message to " + Session.agent;
                accessible-placeholder-text: "Message " + Session.agent + ", or start with ! for a shell command";
                edited => {
                    Composer.command-index = 0;
                    root.hint-dismissed = false;
                    Composer.draft-edited(self.text);
                }
                // The caret stays in view; writing here drops what is selected in the
                // transcript, so Ctrl+C copies the draft's own selection.
                cursor-position-changed(at) => {
                    root.caret-y = at.y;
                    TextSelection.clear();
                    if at.y + scroll.content-y < 0px {
                        scroll.content-y = -at.y;
                    } else if at.y + root.line + scroll.content-y > scroll.height {
                        scroll.content-y = scroll.height - at.y - root.line;
                    }
                }
                // Enter sends; Shift+Enter and Ctrl+Enter start a new line (Ctrl+Enter as in
                // WeChat; the box ignores it, so the line break is put in here). With Ctrl+Enter
                // chosen to send (Preferences), Enter starts a new line instead. While commands
                // match the draft, Up and Down choose one, Enter runs it, and → (at the end) or
                // Tab put it in the draft. Down on the last line goes to the end. Esc dismisses
                // a command's hint. Ctrl+V asks for the clipboard's image too, and pastes its
                // text as ever. Otherwise Up on the first line and Down on the last step through
                // the session's earlier prompts.
                key-pressed(event) => {
                    if event.text == Key.Return && event.modifiers.control {
                        if Preferences.send-key == SendKey.ctrl-enter {
                            root.send-draft();
                            return accept;
                        }
                        let broken = Composer.break-line(Composer.draft, min(self.cursor-position-byte-offset, self.anchor-position-byte-offset), max(self.cursor-position-byte-offset, self.anchor-position-byte-offset));
                        Composer.draft = broken.text;
                        self.set-selection-offsets(broken.caret, broken.caret);
                        return accept;
                    }
                    if event.modifiers.control && (event.text == "v" || event.text == "V") {
                        Composer.paste-image();
                        return reject;
                    }
                    if event.text == Key.UpArrow && Composer.commands.length > 0 {
                        Composer.command-index = max(0, Composer.command-index - 1);
                        return accept;
                    }
                    if event.text == Key.DownArrow && Composer.commands.length > 0 {
                        Composer.command-index = min(Composer.commands.length - 1, Composer.command-index + 1);
                        return accept;
                    }
                    // A command's name is ASCII, so a draft that matches one counts its bytes as
                    // its characters.
                    if Composer.commands.length > 0 && (event.text == Key.Tab || (event.text == Key.RightArrow && self.cursor-position-byte-offset >= Composer.draft.character-count)) {
                        Composer.pick-command(min(Composer.command-index, Composer.commands.length - 1));
                        self.set-selection-offsets(2147483647, 2147483647);
                        return accept;
                    }
                    if event.text == Key.Return && !event.modifiers.shift && Composer.commands.length > 0 {
                        Composer.run-command(min(Composer.command-index, Composer.commands.length - 1));
                        Composer.draft = "";
                        root.sent();
                        return accept;
                    }
                    // Up on the first line brings the session's earlier prompts back, one by
                    // one; Down on the last goes forward again, and past the newest, back to
                    // what was being written.
                    if event.text == Key.UpArrow && !event.modifiers.shift && Composer.can-recall-older && root.caret-y < 0.5 * root.line {
                        Composer.recall-older();
                        return accept;
                    }
                    if event.text == Key.DownArrow && !event.modifiers.shift && Composer.recalling && root.caret-y + 1.5 * root.line > measure.preferred-height {
                        Composer.recall-newer();
                        return accept;
                    }
                    if event.text == Key.DownArrow && !event.modifiers.shift && root.caret-y + 1.5 * root.line > measure.preferred-height {
                        self.set-selection-offsets(2147483647, 2147483647);
                        return accept;
                    }
                    if event.text == Key.Escape && Composer.argument-hint != "" && !root.hint-dismissed {
                        root.hint-dismissed = true;
                        return accept;
                    }
                    // With Ctrl+Enter to send, Enter goes to the box, which starts a new line.
                    if event.text == Key.Return && !event.modifiers.shift && Preferences.send-key == SendKey.enter {
                        root.send-draft();
                        return accept;
                    }
                    return reject;
                }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-xs;
            MenuButton {
                heading: "Permission mode";
                model: Session.modes;
                current-index <=> Session.mode-index;
                max-width: 220px;
                // Its icon and colour tell the mode; the model's name needs the room more.
                compact: root.narrow;
                icon: root.mode == PermissionKind.accept-edits ? @image-url("@lucide/file-pen-line.svg")
                    : root.mode == PermissionKind.plan ? @image-url("@lucide/map.svg")
                    : root.mode == PermissionKind.auto ? @image-url("@lucide/zap.svg")
                    : root.mode == PermissionKind.bypass ? @image-url("@lucide/shield-alert.svg")
                    : root.mode == PermissionKind.unknown ? @image-url("@lucide/shield-question-mark.svg")
                    : @image-url("@lucide/shield-check.svg");
                tint: root.mode == PermissionKind.accept-edits ? Theme.warning-text
                    : root.mode == PermissionKind.plan ? Theme.link
                    : root.mode == PermissionKind.auto ? Theme.info
                    : root.mode == PermissionKind.bypass ? Theme.danger-text
                    : Theme.text-secondary;
                selected(index) => { Session.choose-mode(index); }
            }
            MenuButton {
                heading: "Model";
                model: Session.models;
                current-index <=> Session.model-index;
                max-width: 240px;
                icon: @image-url("@lucide/sparkle.svg");
                selected(index) => { Session.choose-model(index); }
            }
            if Session.tasks.length > 0: TasksChip { }
            // As the sidebar shows a session: a hand while Claude waits for the user, a dot
            // while it works.
            if Session.busy: LiveDot {
                state: Prompt.kind != PromptKind.none ? LiveState.waiting : LiveState.busy;
                y: (parent.height - self.height) / 2;
            }
            if Session.busy: Small {
                text: Session.status;
                vertical-alignment: center;
                overflow: elide;
                min-width: 0px;
                horizontal-stretch: 1;
            }
            // Always here, and without a largest size: the window's largest size comes from its
            // layout, and a row of only bounded parts would keep niri from widening the window
            // (Super+F did nothing).
            Rectangle {
                horizontal-stretch: 1;
            }
            if Session.context != "": ContextMeter { }
            IconButton {
                icon: @image-url("@lucide/square-terminal.svg");
                label: Composer.shell ? "Make it a message again" : "Run a shell command (start with !)";
                tint: Composer.shell ? Theme.info : Theme.text-secondary;
                y: (parent.height - self.height) / 2;
                clicked => { Composer.toggle-shell(); }
            }
            IconButton {
                icon: Composer.size == ComposerSize.tall ? @image-url("@lucide/minimize-2.svg") : @image-url("@lucide/maximize-2.svg");
                label: Composer.size == ComposerSize.tall ? "Make the message box small again" : "Make the message box taller";
                tint: Theme.text-faint;
                clicked => { root.toggle(ComposerSize.tall); }
            }
            IconButton {
                icon: Composer.size == ComposerSize.full ? @image-url("@lucide/shrink.svg") : @image-url("@lucide/expand.svg");
                label: Composer.size == ComposerSize.full ? "Show the conversation again" : "Give the message the whole column, to see all of a long paste";
                tint: Theme.text-faint;
                clicked => { root.toggle(ComposerSize.full); }
            }
            // While Claude works and a message is written (to send when it's done), Send stays
            // Send, and Stop is here.
            if Session.busy && Composer.draft != "": IconButton {
                icon: @image-url("@lucide/square.svg");
                label: "Stop";
                tint: Theme.danger-text;
                y: (parent.height - self.height) / 2;
                clicked => { Session.interrupt(); }
            }
            SendButton {
                sent => {
                    root.sent();
                    root.focus-end();
                }
            }
        }
    }
    // The top edge: dragged, the box takes that height and keeps it; a double click fits it to
    // its text again.
    if !root.stretched: grip := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: 6px;
        mouse-cursor: ns-resize;
        moved => {
            if self.pressed {
                Composer.chosen-height = clamp(scroll.height + self.pressed-y - self.mouse-y, 2 * root.line, root.tallest-dragged);
                Composer.size = ComposerSize.chosen;
            }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && Composer.size == ComposerSize.chosen {
                Composer.height-chosen(round(Composer.chosen-height / 1px));
            }
        }
        double-clicked => {
            Composer.chosen-height = 0;
            Composer.size = ComposerSize.fit;
            Composer.height-chosen(0);
        }
    }
}

// Above the conversation: its title, the worktree it works in, and the side questions.
component Header inherits Rectangle {
    in property <bool> sidebar-shown;
    callback toggle-sidebar;
    height: Theme.header;
    HorizontalLayout {
        padding-left: root.sidebar-shown ? Theme.space-m : Theme.space-s;
        padding-right: Theme.space-m;
        spacing: Theme.space-s;
        // Hidden, the sidebar is brought back from here; shown, it has its own button.
        if !root.sidebar-shown: IconButton {
            icon: @image-url("@lucide/panel-left-open.svg");
            label: "Show the sessions (Ctrl+B)";
            y: (parent.height - self.height) / 2;
            clicked => { root.toggle-sidebar(); }
        }
        Text {
            text: Session.title;
            font-weight: 600;
            color: Theme.text;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if Session.worktree-name != "": worktree := Pressable {
            border-radius: Theme.radius-m;
            border-width: 1px;
            border-color: Theme.divider;
            clicked => { openers.show(); }
            HorizontalLayout {
                padding-left: Theme.space-s;
                padding-right: Theme.space-s;
                spacing: Theme.space-xs;
                Icon {
                    source: @image-url("@lucide/git-branch.svg");
                    tint: Theme.claude;
                    width: Theme.icon-small;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: Session.worktree-name;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                if Session.worktree-branch != "" && Session.worktree-branch != Session.worktree-name: Caption {
                    text: Session.worktree-branch;
                    vertical-alignment: center;
                }
                Icon {
                    source: @image-url("@lucide/chevron-down.svg");
                    width: Theme.icon-small;
                    y: (parent.height - self.height) / 2;
                }
            }
            openers := PopupWindow {
                x: parent.width - self.width;
                y: parent.height + Theme.space-xs;
                width: 220px;
                height: menu.preferred-height;
                close-policy: close-on-click-outside;
                Rectangle {
                    background: Theme.surface;
                    border-radius: Theme.radius-m;
                    border-width: 1px;
                    border-color: Theme.divider;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: #0004;
                    menu := VerticalLayout {
                        padding: Theme.space-xs;
                        Caption {
                            text: "Open the worktree in";
                        }
                        for opener[index] in Session.openers: Pressable {
                            height: Theme.control;
                            clicked => {
                                Session.open-worktree(index);
                                openers.close();
                            }
                            Text {
                                x: Theme.space-s;
                                text: opener;
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
        // Side questions: labelled, as a bare question mark reads as help.
        Pressable {
            selected: Side.view == SideView.shown;
            width: btw.preferred-width;
            height: Theme.chip;
            y: (parent.height - self.height) / 2;
            accessible-label: Side.view == SideView.shown ? "Fold the side questions away" : "Side questions (/btw)";
            clicked => { Side.toggle(); }
            btw := HorizontalLayout {
                padding-left: Theme.space-s;
                padding-right: Theme.space-s;
                spacing: Theme.space-xs;
                Icon {
                    source: @image-url("@lucide/message-circle-dashed.svg");
                    tint: Side.view != SideView.hidden ? Theme.claude : Theme.text-secondary;
                    width: Theme.icon-small;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: "btw";
                    color: Side.view != SideView.hidden ? Theme.text : Theme.text-secondary;
                    font-size: 1rem * Theme.small;
                    vertical-alignment: center;
                }
                // An answer came while folded away.
                if Side.unseen: Rectangle {
                    width: 8px;
                    height: 8px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 4px;
                    background: Theme.claude;
                }
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.divider;
    }
}

// In place of the composer while a session another process runs is shown.
// Before Claude Code starts in a folder not trusted yet: what it would run there.
component TrustBar inherits Rectangle {
    border-radius: Theme.radius-l;
    border-width: 1px;
    border-color: Theme.warning;
    background: Theme.card;
    VerticalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-s;
        HorizontalLayout {
            spacing: Theme.space-s;
            Icon {
                source: @image-url("@lucide/shield-alert.svg");
                tint: Theme.warning-text;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: "Do you trust the files in " + Session.project + "? Claude Code runs this folder's hooks and settings as soon as it starts here, before you send anything.";
                color: Theme.text;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        // What it would run, as read from its settings and .mcp.json (plain text, as written
        // there); a long list scrolls.
        Small {
            text: Session.trust-runs.length == 0
                ? "Its .claude/settings.json, settings.local.json and .mcp.json run nothing and set no environment."
                : "Its .claude/settings.json, settings.local.json and .mcp.json would have Claude Code run or set:";
            wrap: word-wrap;
        }
        if Session.trust-runs.length > 0: Rectangle {
            background: Theme.code;
            border-radius: Theme.radius-m;
            height: min(listed.preferred-height, 12rem);
            Flickable {
                content-height: listed.preferred-height;
                listed := VerticalLayout {
                    padding: Theme.space-s;
                    spacing: 2px;
                    for line in Session.trust-runs: Text {
                        text: line;
                        color: Theme.text;
                        font-family: Theme.mono;
                        font-size: 1rem * Theme.code-size;
                        wrap: word-wrap;
                    }
                }
            }
        }
        // As the terminal's dialog lets one go on without them; asked again at the next start.
        Small {
            text: "Without its settings, Claude Code starts with only your own: none of this runs, and neither do any MCP servers or claude.ai connectors, yours included. You're asked again next time.";
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: Theme.space-s;
            alignment: end;
            TextButton {
                text: "Open another folder";
                clicked => { Sessions.browse-project(); }
            }
            // The focus comes here as the question shows, never to "Trust this folder": a stray
            // Enter starts Claude Code with none of the folder's settings.
            without := TextButton {
                text: "Start without its settings";
                init => { self.focus(); }
                clicked => { Session.start-without-folder-settings(); }
            }
            TextButton {
                text: "Trust this folder";
                primary: true;
                clicked => { Session.trust-folder(); }
            }
        }
    }
}

// How to sign in: Claude Code behind a pipe can't, though it tells the user to run `/login`. It
// reads the sign-in as it starts, so trying again starts it again.
// A Claude Code session to continue, while the keyring keeps an API key: the user picks
// whether it signs in as they do in the terminal, or with the key, billed by the token.
component SignInChoiceBar inherits Rectangle {
    border-radius: Theme.radius-l;
    border-width: 1px;
    border-color: Theme.control-border;
    background: Theme.card;
    VerticalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-s;
        HorizontalLayout {
            spacing: Theme.space-s;
            Icon {
                source: @image-url("@lucide/key-round.svg");
                tint: Theme.text-secondary;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: "Continue “" + Sessions.choosing-sign-in + "” with";
                color: Theme.text;
                font-weight: 600;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        HorizontalLayout {
            alignment: start;
            spacing: Theme.space-s;
            TextButton {
                text: "Your sign-in";
                primary: true;
                clicked => { Sessions.continue-with(SignInWith.account); }
            }
            TextButton {
                text: "The API key";
                clicked => { Sessions.continue-with(SignInWith.api-key); }
            }
            TextButton {
                text: "Cancel";
                clicked => { Sessions.cancel-continue(); }
            }
        }
    }
}

component SignInBar inherits Rectangle {
    property <string> command: "claude auth login";
    border-radius: Theme.radius-l;
    border-width: 1px;
    border-color: Theme.warning;
    background: Theme.card;
    VerticalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-s;
        HorizontalLayout {
            spacing: Theme.space-s;
            Icon {
                source: @image-url("@lucide/log-in.svg");
                tint: Theme.warning-text;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: "Sign in to Claude Code";
                color: Theme.text;
                font-weight: 600;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        Small {
            text: "Run this in a terminal and follow its steps, then try again. Claude Code starts again with your sign-in, and a message that failed is sent again.";
            wrap: word-wrap;
        }
        Rectangle {
            background: Theme.code;
            border-radius: Theme.radius-m;
            HorizontalLayout {
                padding-left: Theme.space-m;
                padding-right: Theme.space-xs;
                spacing: Theme.space-s;
                Text {
                    text: root.command;
                    color: Theme.text;
                    font-family: Theme.mono;
                    font-size: 1rem * Theme.code-size;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    icon: @image-url("@lucide/copy.svg");
                    label: "Copy the command";
                    clicked => { Clipboard.copy(root.command); }
                }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-s;
            alignment: end;
            TextButton {
                text: "Not now";
                clicked => { Session.dismiss-sign-in(); }
            }
            TextButton {
                text: "Try again";
                primary: true;
                clicked => { Session.try-sign-in-again(); }
            }
        }
    }
}

// Bringing it here stops it in its window, so it asks first.
component WatchBar inherits Rectangle {
    property <bool> confirming;
    border-radius: Theme.radius-l;
    border-width: 1px;
    border-color: root.confirming ? Theme.warning : Theme.divider;
    background: Theme.card;
    VerticalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-s;
        HorizontalLayout {
            spacing: Theme.space-s;
            Icon {
                source: @image-url("@lucide/eye.svg");
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: root.confirming
                    ? "Stop it in its window and continue it here? If it is working, its current step is interrupted."
                    : Session.watch-text;
                color: root.confirming ? Theme.text : Theme.text-secondary;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        if !root.confirming: HorizontalLayout {
            spacing: Theme.space-s;
            alignment: end;
            if Session.can-go-to-window: TextButton {
                text: "Go to its window";
                has-icon: true;
                icon: @image-url("@lucide/app-window.svg");
                clicked => { Session.go-to-window(); }
            }
            TextButton {
                text: "Continue here as a copy";
                has-icon: true;
                icon: @image-url("@lucide/copy.svg");
                clicked => { Session.continue-here(); }
            }
            TextButton {
                text: "Bring it here";
                primary: true;
                has-icon: true;
                icon: @image-url("@lucide/arrow-down-to-line.svg");
                clicked => { root.confirming = true; }
            }
        }
        if root.confirming: HorizontalLayout {
            spacing: Theme.space-s;
            alignment: end;
            TextButton {
                text: "Cancel";
                clicked => { root.confirming = false; }
            }
            TextButton {
                text: "Stop it there, continue here";
                primary: true;
                clicked => {
                    root.confirming = false;
                    Session.bring-here();
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: Session.title + " — " + Session.project + " — edualc";
    // Where windows show their own icon (X11); Wayland's come from the desktop entry.
    icon: @image-url("../assets/io.github.felintusun.edualc.svg");
    preferred-width: 1280px;
    preferred-height: 880px;
    min-width: 760px;
    min-height: 480px;
    background: Theme.surface;
    default-font-family: Theme.sans;
    default-font-size: Theme.base-size;

    // Copies through a text input, the way Slint reaches the clipboard.
    clipboard := TextInput {
        visible: false;
        width: 0;
        height: 0;
    }
    public function copy-text(text: string) {
        clipboard.text = text;
        clipboard.select-all();
        clipboard.copy();
    }

    property <int> focus-serial: Composer.focus-serial;
    changed focus-serial => { composer.focus-end(); }

    // Rust colours code with these, into the text it builds: told when they change.
    property <SyntaxColours> syntax-colours: Theme.syntax;
    changed syntax-colours => { Session.syntax-colours-changed(); }

    // The most Claude's prompt may take: half the window, three quarters for its questions,
    // which are read and answered there. Kept as the window is resized, not bound, as a
    // binding would loop through the layout the prompt is part of.
    property <length> prompt-tallest: 400px;
    property <length> questions-tallest: 600px;
    changed height => {
        self.prompt-tallest = self.height / 2;
        self.questions-tallest = self.height * 75%;
    }

    // The area after the one with the focus (or before it), of those shown.
    function next-area(forward: bool) -> FocusArea {
        if forward {
            if Focus.area == FocusArea.sidebar {
                return FocusArea.conversation;
            }
            if Focus.area == FocusArea.conversation {
                return FocusArea.writing;
            }
            if Focus.area == FocusArea.writing && Side.view == SideView.shown {
                return FocusArea.side;
            }
            return root.sidebar-shown ? FocusArea.sidebar : FocusArea.conversation;
        }
        if Focus.area == FocusArea.side {
            return FocusArea.writing;
        }
        if Focus.area == FocusArea.writing {
            return FocusArea.conversation;
        }
        if Focus.area == FocusArea.conversation && root.sidebar-shown {
            return FocusArea.sidebar;
        }
        return Side.view == SideView.shown ? FocusArea.side : FocusArea.writing;
    }

    // Brings the focus to the area's home (see `Focus.wanted`).
    function go-to(area: FocusArea) {
        Focus.area = area;
        Focus.wanted = area;
        Focus.pending = area != FocusArea.conversation;
        Focus.wanted-serial += 1;
        if area == FocusArea.conversation {
            reading.focus();
        }
    }

    // Closes the settings, the focus going back to the writing (it was in the settings).
    function close-settings() {
        Preferences.open = false;
        root.go-to(FocusArea.writing);
    }

    // Hidden for room in a narrow window (Ctrl+B).
    in-out property <bool> sidebar-shown: true;

    // Shortcuts that work wherever the focus is.
    keys := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if TextSelection.owner != "" {
                if event.modifiers.control && (event.text == "c" || event.text == "C") {
                    TextSelection.copy();
                    return accept;
                }
                if event.text == Key.Escape {
                    TextSelection.clear();
                    return accept;
                }
            }
            if event.text == Key.Escape && Usage.open {
                Usage.close();
                return accept;
            }
            if event.text == Key.Escape && Preferences.open {
                root.close-settings();
                return accept;
            }
            if event.modifiers.control && event.text == "," {
                Usage.close();
                Preferences.open = true;
                return accept;
            }
            // While Claude waits for an answer, Esc belongs to what asks (a comment being written).
            // With a draft written, it stops nothing: an Esc meant for the writing (one more
            // after an input method's conversion was cancelled, say) mustn't stop a turn; Stop
            // is beside the draft then.
            if event.text == Key.Escape && Session.busy && Prompt.kind == PromptKind.none && Composer.draft == "" {
                Session.interrupt();
                return accept;
            }
            if event.modifiers.control && (event.text == "n" || event.text == "N") {
                Sessions.new-session(Sessions.program);
                return accept;
            }
            if event.modifiers.control && (event.text == "b" || event.text == "B") {
                root.sidebar-shown = !root.sidebar-shown;
                return accept;
            }
            // F6 and Shift+F6 go from area to area; Ctrl+K to the sessions' filter.
            if event.text == Key.F6 {
                root.go-to(root.next-area(!event.modifiers.shift));
                return accept;
            }
            if event.modifiers.control && (event.text == "k" || event.text == "K") {
                root.sidebar-shown = true;
                root.go-to(FocusArea.sidebar);
                return accept;
            }
            // Text size: Ctrl and +/= (both, for layouts where + needs Shift), -, 0. Also the
            // keys those are on where they need Shift: `;` on Japanese (JIS) keyboards, where
            // + is Shift+;, and `à` on French (AZERTY) ones, where 0 is Shift+à.
            if event.modifiers.control && (event.text == "+" || event.text == "=" || event.text == ";") {
                Session.zoom(1);
                return accept;
            }
            if event.modifiers.control && event.text == "-" {
                Session.zoom(-1);
                return accept;
            }
            if event.modifiers.control && (event.text == "0" || event.text == "à") {
                Session.zoom(0);
                return accept;
            }
            return reject;
        }
        HorizontalLayout {
            if root.sidebar-shown: Sidebar {
                hide => { root.sidebar-shown = false; }
            }
            if root.sidebar-shown: Rectangle {
                width: 1px;
                background: Theme.divider;
            }
            column := VerticalLayout {
                horizontal-stretch: 1;
                min-width: 360px;
                // Tab goes round within the conversation (the header and the transcript), and
                // within what Claude asks together with the composer.
                conversation-start := AreaFence {
                    area: FocusArea.conversation;
                    crossed => {
                        if !Focus.going-round {
                            Focus.going-round = true;
                            conversation-end.focus();
                            Focus.step(false);
                        }
                    }
                }
                header := Header {
                    sidebar-shown: root.sidebar-shown;
                    toggle-sidebar => { root.sidebar-shown = !root.sidebar-shown; }
                }
                Rectangle {
                    vertical-stretch: 1;
                    // The conversation's home for the keyboard (F6): the arrow keys, Page Up and
                    // Down, Space, Home and End scroll it.
                    reading := FocusScope {
                        focus-on-click: false;
                        // Where F6 brings the focus: a screen reader names it.
                        accessible-role: groupbox;
                        accessible-label: "Conversation";
                        accessible-description: "The arrow keys, Page Up and Page Down scroll it";
                        function scroll-by(delta: length) {
                            transcript.content-y = clamp(transcript.content-y - delta, min(0px, transcript.visible-height - transcript.content-height), 0px);
                            transcript.follow = transcript.at-end();
                        }
                        changed has-focus => {
                            if self.has-focus {
                                Focus.area = FocusArea.conversation;
                            }
                        }
                        key-pressed(event) => {
                            // Covered by the usage details, the settings or the plan, it doesn't
                            // move behind them.
                            if Usage.open || Preferences.open || (Prompt.kind == PromptKind.plan && Prompt.reviewing) {
                                return reject;
                            }
                            if event.text == Key.DownArrow {
                                self.scroll-by(4rem);
                                return accept;
                            }
                            if event.text == Key.UpArrow {
                                self.scroll-by(-4rem);
                                return accept;
                            }
                            if event.text == Key.PageDown || event.text == " " {
                                self.scroll-by(transcript.visible-height * 90%);
                                return accept;
                            }
                            if event.text == Key.PageUp {
                                self.scroll-by(-transcript.visible-height * 90%);
                                return accept;
                            }
                            if event.text == Key.Home {
                                transcript.content-y = 0;
                                transcript.follow = transcript.at-end();
                                return accept;
                            }
                            if event.text == Key.End {
                                transcript.go-to-end();
                                return accept;
                            }
                            return reject;
                        }
                    }
                    transcript := ListView {
                        // Follow new output only while the end is in view, so reading back
                        // isn't interrupted. Opening a session starts at the end.
                        property <bool> follow: true;
                        function at-end() -> bool {
                            self.content-y <= self.visible-height - self.content-height + 8px
                        }
                        function go-to-end() {
                            self.follow = true;
                            self.content-y = min(0px, self.visible-height - self.content-height);
                            end-timer.running = true;
                        }
                        property <int> scroll-to-end-serial: Transcript.scroll-to-end-serial;
                        changed scroll-to-end-serial => { self.go-to-end(); }
                        // A transcript just opened: the list measures its rows only as it builds
                        // them, so the end moves with each frame's estimate, and the text would
                        // jump about as it is followed. It shows once its height holds still.
                        property <bool> settling;
                        property <duration> opened-at;
                        property <duration> changed-at;
                        opacity: self.settling ? 0 : 1;
                        property <int> opened-serial: Transcript.opened-serial;
                        changed opened-serial => {
                            self.settling = true;
                            self.opened-at = animation-tick();
                            self.changed-at = animation-tick();
                            opening-timer.running = true;
                            self.go-to-end();
                        }
                        // Only the user's own scrolling decides; content growing (streamed
                        // text, rows being measured) moves the viewport too.
                        scrolled => {
                            self.follow = self.at-end();
                            self.seeking = false;
                            settle-timer.running = true;
                        }
                        // Scrolling here would make the list build and measure other rows, and
                        // change `content-height` again within the same pass, which Slint gives
                        // up on after ten rounds; the move waits for the pass to end instead.
                        changed content-height => {
                            if self.settling {
                                self.changed-at = animation-tick();
                            }
                            if self.follow {
                                follow-timer.running = true;
                                end-timer.running = true;
                            }
                        }
                        // E.g. the prompt bar opening below.
                        changed visible-height => {
                            if self.follow {
                                follow-timer.running = true;
                            }
                        }
                        // The pinned message's row as the list last placed it, and which message
                        // that was: the list builds only the rows near the view, so its place
                        // is known only once its row was built.
                        property <length> pinned-y;
                        property <length> pinned-height;
                        property <int> pinned-for: -1;
                        property <bool> pinned-known: self.pinned-for == Transcript.pinned-index;
                        // Going to the pinned message: the list measures rows as it builds them
                        // and moves them, so the view follows the row until it settles.
                        property <bool> seeking;
                        // The pinned message is out of view, above or below, and there is a
                        // conversation to show.
                        out property <bool> pinned-away: Transcript.pinned-index >= 0 && !self.settling
                            && (!self.pinned-known
                                || self.pinned-y + self.pinned-height + self.content-y < 0
                                || self.pinned-y + self.content-y > self.visible-height);
                        function place-pinned(y: length, height: length) {
                            self.pinned-y = y;
                            self.pinned-height = height;
                            self.pinned-for = Transcript.pinned-index;
                            if self.seeking {
                                seek-timer.running = true;
                            }
                        }
                        // The pinned message at the top of the view, as far as the end allows.
                        function show-pinned() {
                            self.content-y = clamp(Theme.space-s - self.pinned-y, min(0px, self.visible-height - self.content-height), 0px);
                            self.follow = self.at-end();
                        }
                        function go-to-pinned() {
                            self.seeking = true;
                            self.follow = false;
                            settled-timer.running = true;
                            if self.pinned-known {
                                self.show-pinned();
                                return;
                            }
                            // Where the list puts its row, by the rows' average height: built
                            // there, the row says where it is, and the view moves to it then.
                            self.content-y = clamp(-self.content-height * Transcript.pinned-row / max(1, Transcript.entries.length), min(0px, self.visible-height - self.content-height), 0px);
                        }
                        // The rows shown, each taking room: a folded run's later calls aren't
                        // in the list (see `View::new`).
                        for entry[position] in Transcript.entries: HorizontalLayout {
                            property <bool> pinned: entry.index == Transcript.pinned-index;
                            init => {
                                if self.pinned {
                                    transcript.place-pinned(self.y, self.height);
                                }
                            }
                            changed pinned => {
                                if self.pinned {
                                    transcript.place-pinned(self.y, self.height);
                                }
                            }
                            changed y => {
                                if self.pinned {
                                    transcript.place-pinned(self.y, self.height);
                                }
                            }
                            changed height => {
                                if self.pinned {
                                    transcript.place-pinned(self.y, self.height);
                                }
                            }
                            alignment: center;
                            padding-top: position == 0 ? Theme.space-xl : Theme.space-s;
                            padding-bottom: position == Transcript.entries.length - 1 ? Theme.space-xl : Theme.space-s;
                            EntryView {
                                width: transcript.visible-width - 2 * Theme.column-margin;
                                entry: entry;
                                index: entry.index;
                            }
                        }
                    }
                    // Moves to the pinned message's row as it is built or moved, after the pass
                    // that did it: moving within it would make the list build rows again.
                    seek-timer := Timer {
                        interval: 1ms;
                        running: false;
                        triggered => {
                            self.running = false;
                            if transcript.seeking && transcript.pinned-known {
                                transcript.show-pinned();
                            }
                        }
                    }
                    // The rows have settled, or the row wasn't built where the list was moved:
                    // the view stays where it is.
                    settled-timer := Timer {
                        interval: 500ms;
                        running: false;
                        triggered => {
                            self.running = false;
                            transcript.seeking = false;
                        }
                    }
                    // The newest of the user's messages, while it is out of view: the
                    // conversation goes on under it, and a click goes back to it.
                    if transcript.pinned-away: Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: pinned-line.preferred-height + 1px;
                        background: Theme.surface;
                        Pressable {
                            height: pinned-line.preferred-height;
                            y: 0;
                            border-radius: 0;
                            accessible-label: "Go to your last message";
                            accessible-description: Transcript.pinned-text;
                            clicked => { transcript.go-to-pinned(); }
                            pinned-line := HorizontalLayout {
                                alignment: center;
                                padding-top: Theme.space-xs;
                                padding-bottom: Theme.space-xs;
                                HorizontalLayout {
                                    width: transcript.visible-width - 2 * Theme.column-margin;
                                    alignment: end;
                                    Rectangle {
                                        max-width: parent.width * 0.85;
                                        border-radius: Theme.bubble-radius;
                                        background: Theme.bubble;
                                        HorizontalLayout {
                                            padding-left: Theme.space-l;
                                            padding-right: Theme.space-l;
                                            padding-top: Theme.space-xs;
                                            padding-bottom: Theme.space-xs;
                                            spacing: Theme.space-s;
                                            Icon {
                                                source: @image-url("@lucide/corner-left-up.svg");
                                                tint: Theme.text-tertiary;
                                                width: Theme.icon-small;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            Text {
                                                text: Transcript.pinned-text;
                                                color: Theme.text-secondary;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                min-width: 0px;
                                                accessible-role: none;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.divider;
                        }
                    }
                    // A wheel turn animates the scroll, and `scrolled` comes at its start: look
                    // again once it has settled.
                    settle-timer := Timer {
                        interval: 250ms;
                        running: false;
                        triggered => {
                            self.running = false;
                            transcript.follow = transcript.at-end();
                        }
                    }
                    // Shows an opened transcript, at its end, once its height has held still for
                    // a while; after a moment and a half in any case.
                    opening-timer := Timer {
                        interval: 30ms;
                        running: false;
                        triggered => {
                            if animation-tick() - transcript.changed-at < 100ms && animation-tick() - transcript.opened-at < 1500ms {
                                return;
                            }
                            self.running = false;
                            if transcript.follow {
                                transcript.content-y = min(0px, transcript.visible-height - transcript.content-height);
                            }
                            transcript.settling = false;
                        }
                    }
                    // Following the end as the content grows, once the pass that grew it is over.
                    follow-timer := Timer {
                        interval: 1ms;
                        running: false;
                        triggered => {
                            self.running = false;
                            if transcript.follow {
                                transcript.content-y = min(0px, transcript.visible-height - transcript.content-height);
                            }
                        }
                    }
                    // The list moves rows itself after measuring them, after `changed
                    // content-height` ran: once that settles, following means at the end.
                    end-timer := Timer {
                        interval: 120ms;
                        running: false;
                        triggered => {
                            self.running = false;
                            if transcript.follow {
                                transcript.content-y = min(0px, transcript.visible-height - transcript.content-height);
                            }
                        }
                    }
                    // A new session's greeting. Kept while the conversation runs, its words faded
                    // out, so that the heron can fly off as the conversation begins.
                    greeting := VerticalLayout {
                        property <bool> empty: Transcript.entries.length == 0;
                        alignment: center;
                        spacing: Theme.space-m;
                        HorizontalLayout {
                            alignment: center;
                            Heron {
                                width: 64px;
                                height: 64px;
                                wanted: greeting.empty;
                                reach-x: transcript.width / 2 + 64px;
                                reach-y: transcript.height / 2 + 64px;
                            }
                        }
                        Text {
                            text: "What should we work on?";
                            font-size: 1rem * Theme.display;
                            font-weight: 600;
                            color: Theme.text;
                            horizontal-alignment: center;
                            opacity: greeting.empty ? 1 : 0;
                            animate opacity { duration: 250ms; easing: ease-out; }
                            visible: self.opacity > 0;
                        }
                        Small {
                            text: "in " + Session.cwd;
                            horizontal-alignment: center;
                            overflow: elide;
                            opacity: greeting.empty ? 1 : 0;
                            animate opacity { duration: 250ms; easing: ease-out; }
                            visible: self.opacity > 0;
                        }
                    }
                    if Prompt.kind == PromptKind.plan && Prompt.reviewing: PlanReview {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                    }
                    // Over the conversation, which stays in sight around it: a click beside the
                    // panel, or Esc, closes it.
                    if Usage.open: Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        background: Theme.dim;
                        // The wheel stops here too: a TouchArea passes it on, and over the dimmed
                        // conversation or the panel's heading the conversation behind scrolled.
                        TouchArea {
                            clicked => { Usage.close(); }
                            scroll-event(event) => { return accept; }
                        }
                        // Three quarters of the area's height, not sized from its list: a list
                        // sizing what sizes it is measured again and again.
                        Rectangle {
                            property <length> room: parent.height - 2 * Theme.space-xl;
                            width: min(parent.width - 2 * Theme.space-xl, 680px);
                            height: max(min(360px, self.room), self.room * 75%);
                            x: (parent.width - self.width) / 2;
                            y: Theme.space-xl;
                            background: Theme.surface;
                            border-radius: Theme.radius-l;
                            border-width: 1px;
                            border-color: Theme.divider;
                            drop-shadow-blur: 24px;
                            drop-shadow-color: Theme.shadow;
                            clip: true;
                            // Clicks on the panel stay with it.
                            TouchArea { }
                            UsagePanel {
                                width: parent.width;
                                height: parent.height;
                            }
                        }
                    }
                    // The settings, over the conversation as the usage details are.
                    if Preferences.open: Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        background: Theme.dim;
                        // The wheel stops here too, as over the usage details.
                        TouchArea {
                            clicked => { root.close-settings(); }
                            scroll-event(event) => { return accept; }
                        }
                        Rectangle {
                            width: min(parent.width - 2 * Theme.space-xl, 680px);
                            height: min(parent.height - 2 * Theme.space-xl, settings.preferred-height);
                            x: (parent.width - self.width) / 2;
                            y: Theme.space-xl;
                            background: Theme.surface;
                            border-radius: Theme.radius-l;
                            border-width: 1px;
                            border-color: Theme.divider;
                            drop-shadow-blur: 24px;
                            drop-shadow-color: Theme.shadow;
                            clip: true;
                            // Clicks on the panel stay with it.
                            TouchArea { }
                            settings := SettingsPanel {
                                width: parent.width;
                                height: parent.height;
                                close => { root.close-settings(); }
                            }
                        }
                    }
                    if !transcript.follow && !(Prompt.kind == PromptKind.plan && Prompt.reviewing): IconButton {
                        x: parent.width - self.width - Theme.space-xl;
                        y: parent.height - self.height - Theme.space-m;
                        icon: @image-url("@lucide/arrow-down.svg");
                        label: "Go to the end";
                        background: Theme.surface-raised;
                        border-width: 1px;
                        border-color: Theme.divider;
                        clicked => { transcript.go-to-end(); }
                    }
                    // Scrolled by the keys: a ring inside its edge.
                    if reading.has-focus: Rectangle {
                        border-width: 2px;
                        border-color: Theme.accent;
                    }
                }
                conversation-end := AreaFence {
                    area: FocusArea.conversation;
                    crossed => {
                        if !Focus.going-round {
                            Focus.going-round = true;
                            conversation-start.focus();
                            Focus.step(true);
                        }
                    }
                }
                writing-start := AreaFence {
                    area: FocusArea.writing;
                    crossed => {
                        if !Focus.going-round {
                            Focus.going-round = true;
                            writing-end.focus();
                            Focus.step(false);
                        }
                    }
                }
                // What Claude asks and the commands matching the draft, in the transcript's
                // column above the composer. Placed (`x`), so that their width, taken from the
                // space there is, doesn't size that space in turn.
                if Prompt.kind != PromptKind.none || Composer.commands.length > 0 || Session.watching || Session.needs-trust || Session.shows-sign-in || Sessions.choosing-sign-in != "": Rectangle {
                    height: dock.preferred-height;
                    // Centred, as wide as the conversation's column; Claude's questions take the
                    // whole width, where their options have room.
                    dock := VerticalLayout {
                        x: (parent.width - self.width) / 2;
                        y: 0;
                        width: Prompt.kind == PromptKind.question
                            ? parent.width - 2 * Theme.space-m
                            : min(parent.width - 2 * Theme.column-margin, Theme.measure);
                        height: self.preferred-height;
                        padding-bottom: Theme.space-s;
                        spacing: Theme.space-s;
                        // At most half the window, so the conversation stays in view; questions
                        // take up to three quarters.
                        if Prompt.kind != PromptKind.none: PromptBar {
                            tallest: Prompt.kind == PromptKind.question ? root.questions-tallest : root.prompt-tallest;
                        }
                        if Composer.commands.length > 0: CommandList { }
                        if Session.watching: WatchBar { }
                        if Session.needs-trust && !Session.watching: TrustBar { }
                        if Session.shows-sign-in && !Session.watching: SignInBar { }
                        if Sessions.choosing-sign-in != "": SignInChoiceBar { }
                    }
                }
                // The text box, edge to edge (see `EditArea`); a watched session is only read, and
                // nothing is sent before the folder is trusted.
                composer := EditArea {
                    visible: !Session.watching && !Session.needs-trust && (Composer.size == ComposerSize.fit || Composer.size == ComposerSize.chosen);
                    height: self.visible ? self.fit-height : 0;
                    tallest-dragged: column.height * 80%;
                    // Back from being made taller: the writing goes on here.
                    changed visible => {
                        if self.visible {
                            self.focus-end();
                        }
                    }
                }
                writing-end := AreaFence {
                    area: FocusArea.writing;
                    crossed => {
                        if !Focus.going-round {
                            Focus.going-round = true;
                            writing-start.focus();
                            Focus.step(true);
                        }
                    }
                }
            }
            if Side.view == SideView.shown || Peek.open: Rectangle {
                width: 1px;
                background: Theme.divider;
            }
            // A subagent followed takes the panel's place while it is open; the side questions
            // wait meanwhile.
            if Side.view == SideView.shown && !Peek.open: SidePanel {
                min-width: 280px;
                preferred-width: Theme.side-panel;
                max-width: Theme.side-panel;
                horizontal-stretch: 0;
            }
            if Peek.open: PeekPanel {
                min-width: 280px;
                preferred-width: Theme.side-panel;
                max-width: Theme.side-panel;
                horizontal-stretch: 0;
            }
        }
        // The text box made taller: over the conversation's column, outside its layout (the
        // column's height can't size what sizes the column), with the same draft. Two thirds of
        // the column, or all of it below the header.
        if (Composer.size == ComposerSize.tall || Composer.size == ComposerSize.full) && !Session.watching && !Session.needs-trust: Rectangle {
            property <length> top: Composer.size == ComposerSize.full ? header.y + header.height : column.y + column.height / 3;
            x: column.x;
            y: self.top;
            width: column.width;
            height: column.y + column.height - self.top;
            background: Theme.card;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow;
            // Clicks and the wheel stay with it, not passed on to the conversation behind.
            TouchArea {
                scroll-event(event) => { return accept; }
            }
            // Tab goes round within it.
            tall-start := AreaFence {
                area: FocusArea.writing;
                crossed => {
                    if !Focus.going-round {
                        Focus.going-round = true;
                        tall-end.focus();
                        Focus.step(false);
                    }
                }
            }
            tall := EditArea {
                width: parent.width;
                height: parent.height;
                stretched: true;
                init => { self.focus-end(); }
            }
            tall-end := AreaFence {
                area: FocusArea.writing;
                crossed => {
                    if !Focus.going-round {
                        Focus.going-round = true;
                        tall-start.focus();
                        Focus.step(true);
                    }
                }
            }
        }
    }
}
