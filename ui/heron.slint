// edualc's heron, over a new session's empty conversation. It stands there while the
// conversation is empty, flies off when it begins, and flies in when a new one opens. It faces
// left, so it leaves to the upper left and comes in from the upper right.

import { Theme } from "theme.slint";

enum Flight { standing, leaving, away, arriving }

// What the heron does now and then while standing still.
enum Act { looking-back, preening, flapping }

export component Heron inherits Rectangle {
    // Whether it belongs here: the conversation is empty.
    in property <bool> wanted;
    // Whether the empty-session view is currently visible; toggling it on triggers an arrival.
    in property <bool> active: true;
    // How far it flies from where it stands before it is out of sight.
    in property <length> reach-x;
    in property <length> reach-y;
    // Not bound to `wanted`: the binding would go to `away` before the change below took off.
    property <Flight> flight: Flight.standing;
    // The wing beat's frame: up, level, down, level.
    property <int> beat;
    property <duration> flight-time: 1100ms;
    // Idle act while standing: -1 while still.
    property <Act> idle-act: Act.looking-back;
    property <int> idle-frame: -1;
    property <int> idle-frames: root.idle-act == Act.looking-back ? 1 : root.idle-act == Act.preening ? 6 : 7;
    property <duration> idle-wait: 11s;
    property <int> idle-seed: 7;

    function pick-next-idle() {
        root.idle-seed = Math.mod(root.idle-seed * 13 + round(animation-tick() / 1ms), 997);
        let act-pick = Math.mod(root.idle-seed, 3);
        root.idle-act = act-pick == 0 ? Act.looking-back : act-pick == 1 ? Act.preening : Act.flapping;
        root.idle-wait = 9s + Math.mod(root.idle-seed, 19) * 1s;
    }

    init => {
        if !root.wanted {
            root.flight = Flight.away;
        }
        root.pick-next-idle();
    }
    changed wanted => {
        root.idle-frame = -1;
        root.beat = 0;
        if root.wanted {
            // Out of sight first, unanimated, so that it flies in from there.
            root.flight = Flight.away;
            approach.running = true;
        } else {
            approach.running = false;
            landing.running = false;
            root.flight = Flight.leaving;
            departure.running = true;
        }
    }
    changed active => {
        root.idle-frame = -1;
        if root.active && root.wanted {
            root.beat = 0;
            departure.running = false;
            landing.running = false;
            root.flight = Flight.away;
            approach.running = true;
        } else if !root.active {
            approach.running = false;
            landing.running = false;
        }
    }

    approach := Timer {
        interval: 50ms;
        running: false;
        triggered => {
            self.running = false;
            root.flight = Flight.arriving;
            landing.running = true;
        }
    }
    landing := Timer {
        interval: root.flight-time;
        running: false;
        triggered => {
            self.running = false;
            root.flight = Flight.standing;
            root.idle-frame = -1;
            root.pick-next-idle();
        }
    }
    departure := Timer {
        interval: root.flight-time;
        running: false;
        triggered => {
            self.running = false;
            if !root.wanted {
                root.flight = Flight.away;
            }
        }
    }
    Timer {
        interval: 110ms;
        running: root.flight == Flight.leaving || root.flight == Flight.arriving;
        triggered => {
            root.beat = Math.mod(root.beat + 1, 4);
        }
    }
    // Wait between idle motions while standing in an active empty session.
    Timer {
        interval: root.idle-wait;
        running: root.active && root.wanted && root.flight == Flight.standing && root.idle-frame < 0;
        triggered => {
            root.idle-frame = 0;
        }
    }
    // Step through the current idle motion's frames.
    Timer {
        interval: root.idle-act == Act.looking-back ? 1500ms : root.idle-act == Act.preening ? 240ms : 110ms;
        running: root.active && root.wanted && root.flight == Flight.standing && root.idle-frame >= 0;
        triggered => {
            if root.idle-frame + 1 < root.idle-frames {
                root.idle-frame += 1;
            } else {
                root.idle-frame = -1;
                root.pick-next-idle();
            }
        }
    }

    Rectangle {
        width: root.width;
        height: root.height;
        y: root.flight == Flight.standing && root.idle-frame >= 0 && root.idle-act == Act.flapping && Math.mod(root.idle-frame, 2) == 1 ? -2px
            : root.flight == Flight.standing && root.idle-frame >= 0 && root.idle-act == Act.preening && Math.mod(root.idle-frame, 2) == 0 ? -1px
            : 0px;
        animate y { duration: 140ms; easing: ease-in-out; }

        bird := Image {
            width: root.width;
            height: root.height;
            image-fit: contain;
            colorize: Theme.claude;
            accessible-role: none;
            visible: root.flight != Flight.away;
            source: root.flight == Flight.standing ? (
                    root.idle-frame < 0 ? @image-url("../assets/heron.svg")
                    : root.idle-act == Act.looking-back ? @image-url("../assets/heron-looking-back.svg")
                    : root.idle-act == Act.preening ? (Math.mod(root.idle-frame, 2) == 0 ? @image-url("../assets/heron-preening-1.svg") : @image-url("../assets/heron-preening-2.svg"))
                    : Math.mod(root.idle-frame, 2) == 0 ? @image-url("../assets/heron-flapping-half.svg")
                    : Math.mod(root.idle-frame, 4) == 1 ? @image-url("../assets/heron-flapping-up.svg")
                    : @image-url("../assets/heron.svg")
                )
                : root.beat == 0 ? @image-url("../assets/heron-wings-up.svg")
                : root.beat == 2 ? @image-url("../assets/heron-wings-down.svg")
                : @image-url("../assets/heron-wings-level.svg");
        }
    }

    states [
        // Up first, then away: it climbs at once and gathers speed sideways.
        leaving when root.flight == Flight.leaving: {
            bird.x: -root.reach-x;
            bird.y: -root.reach-y;
            bird.opacity: 0;
            in {
                animate bird.x { duration: root.flight-time; easing: ease-in; }
                animate bird.y { duration: root.flight-time; easing: ease-out; }
                animate bird.opacity { duration: root.flight-time; easing: ease-in; }
            }
        }
        away when root.flight == Flight.away: {
            bird.x: root.reach-x;
            bird.y: -root.reach-y;
            bird.opacity: 0;
        }
        // Gliding in: it slows as it comes, and comes down last.
        arriving when root.flight == Flight.arriving: {
            bird.x: 0;
            bird.y: 0;
            bird.opacity: 1;
            in {
                animate bird.x { duration: root.flight-time; easing: ease-out; }
                animate bird.y { duration: root.flight-time; easing: ease-in; }
                animate bird.opacity { duration: root.flight-time / 2; easing: ease-out; }
            }
        }
    ]
}

// The heron in the top bar. It stands still, and every 9–29 seconds, for a second
// or so, it looks over its shoulder, preens or flaps its wings. In between only a timer
// waits, so nothing is redrawn for it.
// Beside the name it draws: only drawn, its Image held rather than inherited (see `Icon`).
export component HeronMark inherits Rectangle {
    // The act it does next, or is doing.
    property <Act> act: Act.looking-back;
    // The act's frame; -1 while it stands.
    property <int> frame: -1;
    property <int> frames: root.act == Act.looking-back ? 1 : root.act == Act.preening ? 6 : 7;
    property <duration> idle-wait: 13s;
    property <int> seed: 19;

    function pick-next-idle() {
        root.seed = Math.mod(root.seed * 17 + round(animation-tick() / 1ms), 991);
        let act-pick = Math.mod(root.seed, 3);
        root.act = act-pick == 0 ? Act.looking-back : act-pick == 1 ? Act.preening : Act.flapping;
        root.idle-wait = 9s + Math.mod(root.seed, 21) * 1s;
    }

    init => {
        root.pick-next-idle();
    }

    height: self.width;
    Image {
        width: 100%;
        height: 100%;
        image-fit: contain;
        colorize: Theme.claude;
        accessible-role: none;
        source: root.frame < 0 ? @image-url("../assets/heron.svg")
            : root.act == Act.looking-back ? @image-url("../assets/heron-looking-back.svg")
            // Nibbling at its back.
            : root.act == Act.preening ? (Math.mod(root.frame, 2) == 0 ? @image-url("../assets/heron-preening-1.svg") : @image-url("../assets/heron-preening-2.svg"))
            // Wing beats: half up, up, half up, folded.
            : Math.mod(root.frame, 2) == 0 ? @image-url("../assets/heron-flapping-half.svg")
            : Math.mod(root.frame, 4) == 1 ? @image-url("../assets/heron-flapping-up.svg")
            : @image-url("../assets/heron.svg");
    }

    // Staggered wait before each act so it feels organic rather than ticking like a clock.
    Timer {
        interval: root.idle-wait;
        running: root.frame < 0;
        triggered => {
            root.frame = 0;
        }
    }
    // A look held, nibbles, wing beats.
    Timer {
        interval: root.act == Act.looking-back ? 1500ms : root.act == Act.preening ? 240ms : 110ms;
        running: root.frame >= 0;
        triggered => {
            if root.frame + 1 < root.frames {
                root.frame += 1;
            } else {
                root.frame = -1;
                root.pick-next-idle();
            }
        }
    }
}
