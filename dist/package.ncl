# What the packages hold and need, for every format (see formats.ncl). Checked against
# schema.ncl, which says what each field is. Name, version, licence and homepage come from
# Cargo.toml, the releases from releases.json.
let schema = import "schema.ncl" in
# The workspace's package fields, and the window crate's description.
let cargo = import "../Cargo.toml" in
let window = import "../crates/slint/Cargo.toml" in
{
  name = "edualc",
  app_id = "io.github.felintusun.edualc",
  version = cargo.workspace.package.version,
  homepage = cargo.workspace.package.repository,
  license = cargo.workspace.package.license,
  maintainer = {
    name = "Felin Tusun",
    email = "16455996+felintusun@users.noreply.github.com",
  },
  copyright = "2026 Felin Tusun",
  summary = window.package.description,
  description = "A native desktop window for Claude Code, Anthropic's coding agent: conversations, permission prompts, plans to comment on, and sessions across projects, without the terminal UI. It runs Claude Code's command-line program, so Claude Code must be installed.",
  generic_name = "Claude Code window",
  categories = ["Development"],
  keywords = ["Claude", "Claude Code", "AI", "agent"],

  files = [
    { source = "target/release/edualc", role = 'Program },
    # The daemon the window starts, beside itself, if none runs.
    { source = "target/release/edualcd", role = 'Program },
    # Generated from formats.ncl (`desktop`, `metainfo`).
    { source = "assets/io.github.felintusun.edualc.desktop", role = 'DesktopEntry },
    { source = "assets/io.github.felintusun.edualc.svg", role = 'Icon },
    { source = "assets/io.github.felintusun.edualc.metainfo.xml", role = 'Metainfo },
    # Generated by a test in crates/slint/src/start/manual.rs.
    { source = "assets/edualc.1", role = 'Manual },
    { source = "README.md", role = 'Documentation },
    { source = "THIRD_PARTY_LICENSES.md", role = 'Notices },
    { source = "LICENSE", role = 'License },
  ],

  opened = [
    { soname = "libwayland-client.so.0", debian = "libwayland-client0", arch = "wayland" },
    { soname = "libwayland-egl.so.1", debian = "libwayland-egl1", arch = "wayland" },
    { soname = "libxkbcommon.so.0", debian = "libxkbcommon0", arch = "libxkbcommon" },
    { soname = "libEGL.so.1", debian = "libegl1", arch = "libglvnd" },
  ],
  linked = [
    { soname = "libc.so.6", arch = "glibc" },
    { soname = "libm.so.6", arch = "glibc" },
    { soname = "ld-linux-x86-64.so.2", arch = "glibc" },
    { soname = "ld-linux-aarch64.so.1", arch = "glibc" },
    { soname = "libgcc_s.so.1", arch = "libgcc" },
    { soname = "libfontconfig.so.1", arch = "fontconfig" },
  ],
  needed = [
    { why = "the folders the icon goes into", fedora = "hicolor-icon-theme", arch = "hicolor-icon-theme" },
  ],
  recommended = [
    { why = "pasting images", debian = "wl-clipboard", fedora = "wl-clipboard", arch = "wl-clipboard" },
    { why = "the Claude Code CLI that edualc runs (or Anthropic's installer: claude on the PATH)", arch = "claude-code" },
    { why = "the interface font (otherwise the desktop's sans)", arch = "ttf-fira-sans" },
    { why = "the code font (otherwise the desktop's monospace)", arch = "ttf-fira-code" },
    { why = "Japanese, Chinese and Korean text", arch = "noto-fonts-cjk" },
  ],

  releases = import "releases.json",
}
  | schema.Package
  | schema.Consistent
