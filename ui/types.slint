// What Rust hands the window: one struct per kind of row, built in `src/ui.rs`.

// A block of assistant Markdown that the window draws itself; inline Markdown (emphasis, code,
// links, lists) is inside `body`, parsed by Slint.
export enum BlockKind { text, heading, code, quote, table, rule }

// The language of a text's CJK characters (see `src/cjk.rs`), for their glyph shapes and
// spacing; none in a text without any.
export enum Cjk { none, japanese, simplified-chinese, traditional-chinese, korean }

// A text's CJK characters: their language, and whether they are its main script, which sets
// the whole text in their family and line height (see `Theme.cjk-family`); else they are
// guests in a text that keeps its own.
export struct CjkChars {
    language: Cjk,
    main: bool,
}

export struct TableRow {
    cells: [styled-text],
}

export struct MdBlock {
    kind: BlockKind,
    body: styled-text,
    // The CJK characters of its prose, by its own text.
    cjk: CjkChars,
    // The code's language, from its fence.
    lang: string,
    // A heading's level, 1 to 6.
    level: int,
    // Code as it is, a table as its Markdown, for copying.
    raw: string,
    // A table's rows, the header first.
    rows: [TableRow],
    // A table's columns' stretch: a table too wide for the window narrows each column by its
    // share, so a short column keeps its width.
    column-stretch: [float],
}

export enum EntryKind { user, assistant, thinking, tool, image, peer, info, error }

// How far an image in the conversation is: decoded and shown, still being decoded, or not to
// be shown.
export enum ImageState { pending, shown, failed }

export struct ShownImage {
    state: ImageState,
    image: image,
    // Its pixels, for its shape.
    width-px: int,
    height-px: int,
    // Why it isn't shown.
    note: string,
}

export enum ToolState { streaming, running, awaiting, done, failed, denied, cancelled }

export enum DiffKind { context, added, removed, hunk }

// Runs of tool calls fold into one line, carried by the run's first call (see
// `src/grouping.rs`).
export enum GroupRole { alone, head, member }

export struct DiffLine {
    kind: DiffKind,
    text: string,
}

// One row of the transcript.
export struct Entry {
    // Its place in the conversation, which toggling and copying name and selections are keyed
    // by; not its place in the list, which leaves out what is hidden.
    index: int,
    kind: EntryKind,
    // The text of user messages, other sessions' messages, notes, errors and thinking.
    body: styled-text,
    // Who sent another session's message, by the name it gave.
    sender: string,
    // The CJK characters of its prose.
    cjk: CjkChars,
    // Assistant text; a plan to approve.
    blocks: [MdBlock],
    tool-title: string,
    tool-summary: string,
    // The summary is words (a question, an agent's task), not code: set as prose.
    tool-summary-prose: bool,
    tool-state: ToolState,
    // A tool call's input worth showing (the full command, a subagent's prompt).
    detail: styled-text,
    has-detail: bool,
    output: styled-text,
    has-output: bool,
    // What was left out of a long output.
    output-note: string,
    diff: [DiffLine],
    // An image the user sent; those a tool returned.
    images: [ShownImage],
    expanded: bool,
    // Made by a subagent: indented under the call that started it.
    nested: bool,
    group: GroupRole,
    // The head's line ("Read 2 files, ran 1 command"), and how the run went: running, done or
    // failed.
    group-summary: string,
    group-state: ToolState,
    group-open: bool,
    // A later call of a folded run: not in the list at all (see `View::new`).
    hidden: bool,
}

// How a running session is doing.
export enum LiveState { idle, busy, waiting, other }

// What is known of Claude Code's sign-in, for the account's details.
export enum SignInState { unknown, signed-in, signed-out }

// What a row of the sidebar's session list is: a heading over a part of it, a session running
// now (this window's, another's, a terminal's), or one of this folder's earlier sessions.
export enum SessionRowKind { heading, running, earlier }

// The program a session runs: Claude Code (with the user's sign-in, or with the Anthropic API
// key in the keyring), or Google's Antigravity CLI.
export enum Program { claude, claude-api-key, agy }

export struct SessionRow {
    kind: SessionRowKind,
    id: string,
    // The session's title; a heading's text.
    title: string,
    // A running session's second line: what it does, its name to message it by, its folder
    // when another, its worktree. A heading's: how many need their user.
    detail: string,
    // How long ago an earlier session was last used.
    age: string,
    state: LiveState,
    // Shown in the window now.
    selected: bool,
    // The worktree it works in; empty if none.
    worktree: string,
    // Its subagents running now.
    agents: int,
    // What it runs: marked beside its title unless Claude Code on the user's own sign-in.
    program: Program,
}

// The side panel (`/btw`): open, folded away into the header's button, or not there.
export enum SideView { hidden, shown, folded }

export enum SideState { pending, retrying, answered, failed }

// A step of a subagent's, as the side panel follows it: what it was asked, what it said, a tool
// it called.
export enum StepKind { asked, said, called }

export struct PeekStep {
    kind: StepKind,
    // The tool's name, for a call.
    title: string,
    text: string,
}

// A side question and its answer (Markdown blocks), or why there is none.
export struct SideExchange {
    question: string,
    state: SideState,
    answer: [MdBlock],
    error: string,
}

// A part of Claude's plan, and the user's comment on it.
export struct PlanSection {
    block: MdBlock,
    // Its first words, naming its buttons for assistive technology.
    excerpt: string,
    comment: string,
    editing: bool,
}

export struct ProjectItem {
    // The folder to open.
    path: string,
    // Its path as shown: from `~`, and shortened in the middle, where two folders of one name
    // still differ.
    shown: string,
    name: string,
    age: string,
}

// A line of the usage panel: what, how much, more about it, and a bar when it is a share
// (0 to 1; less than 0 for none), which warms as it fills.
export struct StatRow {
    label: string,
    value: string,
    detail: string,
    fraction: float,
}

export struct StatSection {
    title: string,
    note: string,
    rows: [StatRow],
}

// A choice in a menu, with what choosing it means.
export struct MenuItem {
    title: string,
    description: string,
}

// A slash command matching what the composer holds.
export struct CommandItem {
    name: string,
    hint: string,
    description: string,
}

export struct QuestionOption {
    label: string,
    description: string,
    // What the option would look like (code, a mockup); empty if none.
    preview: string,
    selected: bool,
}

// One of the questions Claude asks with AskUserQuestion.
export struct Question {
    question: string,
    // A short label for its tab (AskUserQuestion's `header`); empty if Claude gave none.
    header: string,
    // An option is picked, or something else written.
    answered: bool,
    multi: bool,
    // Some option has a preview: they are shown beside the options.
    previews: bool,
    options: [QuestionOption],
}

// The permission mode in use, for the composer's icon; `unknown` for one the CLI names that
// this window doesn't know.
export enum PermissionKind { default, accept-edits, plan, auto, bypass, unknown }

// What the bar above the composer asks: nothing, whether a tool may run, Claude's questions,
// or whether its plan is approved.
export enum PromptKind { none, tool, question, plan }

// How tall the composer is: fitted to its text (up to a limit), as dragged, about two thirds
// of the conversation's column, or all of it.
export enum ComposerSize { fit, chosen, tall, full }

// What sends the draft: Enter (Shift+Enter or Ctrl+Enter start a new line), or Ctrl+Enter
// (Enter starts a new line).
export enum SendKey { enter, ctrl-enter }

// The language text with Han characters alone is drawn in (see `src/cjk.rs`).
export enum HanLanguage { japanese, simplified-chinese, traditional-chinese, korean }

// What a Claude Code session continues with: the user's sign-in, or the API key.
export enum SignInWith { account, api-key }


// The window's areas for the keyboard, in F6's order: the sidebar, the conversation (its header
// and transcript), what Claude asks with the composer, and the side panel.
export enum FocusArea { sidebar, conversation, writing, side }

// What a running turn is doing, for the line that sweeps the composer's edge: the model at
// work (thinking, writing), or a tool.
export enum Activity { idle, model, tool }

// What runs in the background, for its icon.
export enum TaskKind { agent, command, workflow, monitor, other }

// A task running in the background: what it does, and what kind of agent runs it ("Explore"),
// or what it is ("Shell command").
export struct TaskItem {
    // Claude Code's id for it, to peek into it by.
    id: string,
    kind: TaskKind,
    title: string,
    detail: string,
    // What it used so far ("14 tool uses · 31k tokens · 2m 40s"); empty before it says.
    used: string,
    // What it does now, as far as known; empty if nothing is.
    now: string,
    // Its conversation can be followed (a subagent's).
    peekable: bool,
}

// An image pasted into the composer, to go with the next message.
export struct ImageChip {
    thumbnail: image,
    // Its size as sent, e.g. "1920×1080".
    caption: string,
}

// A draft with a line break put in, and the caret's byte offset after the break.
export struct LineBreak {
    text: string,
    caret: int,
}
