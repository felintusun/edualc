// A project's sessions: what runs now, what ran earlier, and starting a new one here.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { FocusArea, LiveState, Program, SessionRow, SessionRowKind } from "types.slint";
import { Focus, Nav, Session, Sessions } from "state.slint";
import { AgentCount, AreaFence, Caption, Field, Icon, LiveDot, Pressable, ProgramMark, Small, TextButton, Title } from "widgets.slint";

component SessionHeading inherits Rectangle {
    in property <SessionRow> entry;
    accessible-role: text;
    accessible-label: root.entry.detail == "" ? root.entry.title : root.entry.title + ", " + root.entry.detail;
    HorizontalLayout {
        padding-left: Theme.space-s;
        padding-right: Theme.space-s;
        padding-top: Theme.space-m;
        padding-bottom: Theme.space-xs;
        spacing: Theme.space-s;
        Caption {
            text: root.entry.title;
            horizontal-stretch: 1;
            vertical-alignment: center;
            accessible-role: none;
        }
        if root.entry.detail != "": HorizontalLayout {
            spacing: Theme.space-xs;
            Icon {
                source: @image-url("@lucide/hand.svg");
                width: Theme.icon-small;
                tint: Theme.warning-text;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: root.entry.detail;
                font-size: 1rem * Theme.caption;
                color: Theme.warning-text;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
    }
}

component RunningRow inherits Rectangle {
    in property <SessionRow> entry;
    property <string> program-said: root.entry.program == Program.agy ? ", agy"
        : root.entry.program == Program.opencode ? ", opencode"
        : root.entry.program == Program.claude-api-key ? ", with the API key" : "";
    height: Theme.row-tall;

    // The agent-count button sits beside the row button rather than inside it so assistive
    // tools and pointer targets never nest buttons.
    HorizontalLayout {
        spacing: Theme.space-xs;
        Pressable {
            horizontal-stretch: 1;
            min-width: 0px;
            selected: root.entry.selected;
            accessible-label: root.entry.title + root.program-said + ", " + root.entry.detail
                + (root.entry.agents == 1 ? ", 1 agent running" : root.entry.agents > 1 ? ", \{root.entry.agents} agents running" : "");
            clicked => { Sessions.open(root.entry.id); }
            HorizontalLayout {
                padding-left: Theme.space-m;
                padding-right: Theme.space-s;
                spacing: Theme.space-s;
                LiveDot {
                    state: root.entry.state;
                    y: (parent.height - self.height) / 2;
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    min-width: 0px;
                    title := Text {
                        text: root.entry.title;
                        color: Theme.text;
                        overflow: elide;
                        accessible-role: none;
                    }
                    Text {
                        text: root.entry.detail;
                        font-size: 1rem * Theme.caption;
                        color: root.entry.state == LiveState.waiting ? Theme.warning-text : Theme.text-tertiary;
                        overflow: elide;
                        accessible-role: none;
                    }
                }
                ProgramMark {
                    program: root.entry.program;
                }
                if root.entry.agents > 0 && !root.entry.selected: AgentCount {
                    agents: root.entry.agents;
                }
            }
            if title.preferred-width > title.width: Tooltip {
                text: @markdown("\{root.entry.title}");
            }
        }
        if root.entry.agents > 0 && root.entry.selected: Pressable {
            horizontal-stretch: 0;
            accessible-label: root.entry.agents == 1 ? "1 agent running, show it"
                : "\{root.entry.agents} agents running, show them";
            clicked => { Session.tasks-wanted += 1; }
            AgentCount {
                agents: root.entry.agents;
                padding-left: Theme.space-s;
                padding-right: Theme.space-s;
            }
        }
    }
}

component EarlierRow inherits Pressable {
    in property <SessionRow> entry;
    height: Theme.row;
    selected: root.entry.selected;
    accessible-label: root.entry.title + (root.entry.program == Program.agy ? ", agy" : root.entry.program == Program.opencode ? ", opencode" : "") + ", " + root.entry.age + (root.entry.worktree != "" ? ", in the worktree " + root.entry.worktree : "");
    clicked => { Sessions.open(root.entry.id); }
    HorizontalLayout {
        padding-left: Theme.space-m;
        padding-right: Theme.space-s;
        spacing: Theme.space-s;
        if root.entry.worktree != "": Icon {
            source: @image-url("@lucide/git-branch.svg");
            width: Theme.icon-small;
            tint: Theme.text-tertiary;
            y: (parent.height - self.height) / 2;
        }
        title := Text {
            text: root.entry.title;
            color: Theme.text-secondary;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            accessible-role: none;
        }
        ProgramMark {
            program: root.entry.program;
        }
        Text {
            text: root.entry.age;
            font-size: 1rem * Theme.caption;
            color: Theme.text-tertiary;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    if title.preferred-width > title.width: Tooltip {
        text: @markdown("\{root.entry.title}");
    }
}

export component ProjectPage inherits Rectangle {
    property <bool> narrow: self.width < 36rem;
    property <length> page-padding: root.narrow ? Theme.space-m : Theme.space-xl;
    property <int> wanted: Focus.wanted-serial;
    property <int> focus-page: Nav.page-focus-serial;
    changed wanted => { self.take-wanted(); }
    changed focus-page => { filter.focus(); }
    // As on the start page: nothing else has the focus when the page comes.
    init => { filter.focus(); }

    function take-wanted() {
        if Focus.pending && Focus.wanted == FocusArea.page {
            Focus.pending = false;
            filter.focus();
        }
    }

    background: Theme.surface;

    VerticalLayout {
        page-start := AreaFence {
            area: FocusArea.page;
            crossed => {
                if !Focus.going-round {
                    Focus.going-round = true;
                    page-end.focus();
                    Focus.step(false);
                }
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            Rectangle { horizontal-stretch: 1; }
            column := VerticalLayout {
                width: min(max(0px, root.width - 2 * root.page-padding), 860px);
                padding-top: root.page-padding;
                padding-bottom: Theme.space-l;
                spacing: Theme.space-m;

                FlexboxLayout {
                    flex-direction: FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.wrap;
                    alignment: LayoutAlignment.space-between;
                    spacing: Theme.space-s;
                    VerticalLayout {
                        width: root.narrow ? column.width : max(120px, column.width - actions.preferred-width - Theme.space-l);
                        spacing: Theme.space-xs;
                        Title {
                            text: Nav.project-name;
                            min-width: 0px;
                            overflow: elide;
                        }
                        Caption {
                            text: Session.cwd != "" ? Session.cwd : Nav.project-folder;
                            min-width: 0px;
                            overflow: elide;
                        }
                    }
                    actions := HorizontalLayout {
                        spacing: Theme.space-xs;
                        horizontal-stretch: 0;
                        max-width: column.width;
                        TextButton {
                            text: "New session here";
                            primary: true;
                            has-icon: true;
                            icon: @image-url("@lucide/square-pen.svg");
                            horizontal-stretch: 0;
                            may-shorten: true;
                            y: (parent.height - self.height) / 2;
                            clicked => { Sessions.new-session-dialog = true; }
                        }
                    }
                }

                filter := Field {
                    placeholder: "Filter sessions (Ctrl+K)";
                    edited(text) => { Sessions.filter-edited(text); }
                    init => { root.take-wanted(); }
                    changed has-focus => {
                        if self.has-focus {
                            Focus.area = FocusArea.page;
                        }
                    }
                }

                if Sessions.empty != "": Small {
                    text: Sessions.empty;
                    wrap: word-wrap;
                }

                ListView {
                    vertical-stretch: 1;
                    for row in Sessions.rows: VerticalLayout {
                        if row.kind == SessionRowKind.heading: SessionHeading {
                            entry: row;
                        }
                        if row.kind == SessionRowKind.running: RunningRow {
                            entry: row;
                        }
                        if row.kind == SessionRowKind.earlier: EarlierRow {
                            entry: row;
                        }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        page-end := AreaFence {
            area: FocusArea.page;
            crossed => {
                if !Focus.going-round {
                    Focus.going-round = true;
                    page-start.focus();
                    Focus.step(true);
                }
            }
        }
    }
}
