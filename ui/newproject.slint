// Making a new project folder.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { FocusArea } from "types.slint";
import { Focus, Nav } from "state.slint";
import { AreaFence, Caption, Field, Icon, IconButton, Pressable, TextButton, Title } from "widgets.slint";

export component NewProjectDialog inherits Rectangle {
    callback close;

    property <string> project-name;
    property <string> saved-parent: Nav.new-project-parent;
    property <int> created: Nav.created-serial;
    property <bool> can-create: root.project-name != "" && parent-field.text != "";

    changed saved-parent => { parent-field.text = self.saved-parent; }
    changed created => { root.close(); }

    function submit() {
        if root.can-create {
            Nav.create-project(parent-field.text, root.project-name);
        }
    }

    background: Theme.surface;
    border-radius: Theme.radius-l;
    border-width: 1px;
    border-color: Theme.divider;
    drop-shadow-blur: 24px;
    drop-shadow-color: Theme.shadow;
    clip: true;

    VerticalLayout {
        first-fence := AreaFence {
            area: FocusArea.page;
            crossed => {
                if !Focus.going-round {
                    Focus.going-round = true;
                    last-fence.focus();
                    Focus.step(false);
                }
            }
        }
        HorizontalLayout {
            min-height: Theme.header;
            padding-left: root.width < 28rem ? Theme.space-m : Theme.space-xl;
            padding-right: Theme.space-m;
            padding-top: Theme.space-s;
            padding-bottom: Theme.space-s;
            spacing: Theme.space-m;
            Icon {
                source: @image-url("@lucide/folder-plus.svg");
                tint: Theme.agent;
                width: 20px;
                y: (parent.height - self.height) / 2;
            }
            Title {
                text: "New project";
                horizontal-stretch: 1;
                min-width: 0px;
                overflow: elide;
                vertical-alignment: center;
            }
            IconButton {
                icon: @image-url("@lucide/x.svg");
                label: "Cancel (Esc)";
                y: (parent.height - self.height) / 2;
                clicked => { root.close(); }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        // Only the form scrolls on short or zoomed viewports, keeping the action bar reachable.
        scroll := ScrollView {
            vertical-stretch: 1;
            min-height: 0px;
            preferred-height: form.preferred-height;
            horizontal-scrollbar-policy: always-off;
            content-width: self.visible-width;
            content-height: form.preferred-height;
            form := VerticalLayout {
                width: scroll.visible-width;
                padding: Theme.space-l;
                spacing: Theme.space-s;

                Text {
                    text: "Name";
                    font-weight: 600;
                    color: Theme.text;
                }
                name-field := Field {
                    placeholder: "my-project";
                    init => { self.focus(); }
                    edited(text) => {
                        root.project-name = text;
                        Nav.clear-new-project-error();
                    }
                    accepted => { root.submit(); }
                }
                // Directly below Name so a validation error reads next to what caused it.
                if Nav.new-project-error != "": Text {
                    text: Nav.new-project-error;
                    color: Theme.danger-text;
                    font-size: 1rem * Theme.small;
                    wrap: word-wrap;
                    min-width: 0px;
                }

                Rectangle { height: Theme.space-xs; }

                Text {
                    text: "Inside";
                    font-weight: 600;
                    color: Theme.text;
                }
                HorizontalLayout {
                    spacing: Theme.space-s;
                    parent-field := Field {
                        horizontal-stretch: 1;
                        min-width: 80px;
                        placeholder: "Parent folder";
                        init => { self.text = Nav.new-project-parent; }
                        edited => { Nav.clear-new-project-error(); }
                        accepted => { root.submit(); }
                    }
                    TextButton {
                        text: "Choose…";
                        horizontal-stretch: 0;
                        may-shorten: true;
                        clicked => { Nav.browse-new-project-parent(); }
                    }
                }
                Caption {
                    text: "edualc creates " + parent-field.text
                        + (parent-field.text == "" || parent-field.text == "/" ? "" : "/")
                        + (root.project-name == "" ? "<name>" : root.project-name);
                    // Whole, over two lines if need be: cut at its end, it lost the new folder's
                    // name.
                    wrap: char-wrap;
                    min-width: 0px;
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        VerticalLayout {
            padding-left: Theme.space-l;
            padding-right: Theme.space-l;
            padding-top: Theme.space-m;
            padding-bottom: Theme.space-m;
            FlexboxLayout {
                flex-direction: FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.wrap;
                alignment: LayoutAlignment.end;
                spacing: Theme.space-s;
                TextButton {
                    text: "Cancel";
                    horizontal-stretch: 0;
                    clicked => { root.close(); }
                }
                TextButton {
                    text: "Create project";
                    // Keep disabled text readable against the surface; light up in accent once ready.
                    primary: root.can-create;
                    enabled: root.can-create;
                    opacity: root.can-create ? 1 : 0.72;
                    horizontal-stretch: 0;
                    clicked => { root.submit(); }
                }
            }
        }
        last-fence := AreaFence {
            area: FocusArea.page;
            crossed => {
                if !Focus.going-round {
                    Focus.going-round = true;
                    first-fence.focus();
                    Focus.step(true);
                }
            }
        }
    }
}
